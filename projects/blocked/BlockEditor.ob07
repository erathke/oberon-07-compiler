MODULE BlockEditor;
IMPORT
	ST IN "./lib/Storage.ob07",
	RL IN "./lib/Raylib.ob07",
	MUI IN "./lib/MicroUI.ob07",
	MURL IN "./lib/MURL.ob07",
	String IN "./lib/String.ob07",
	P IN "./lib/Parser.ob07",
	VM IN "./lib/VM.ob07",
	Out := Out_sys;

CONST
	SCREEN_WIDTH = 800;
	SCREEN_HEIGHT = 600;
	ME_MAX_COLS = 80;

VAR
	d0: ST.Disk;
	d0blocks: INTEGER;
	d0blocksStr: ARRAY 32 OF CHAR;
	d0currentBlock: REAL;
	currentBlock: ST.Block;
	cursorPos: MUI.Vec2;
	yOffs: INTEGER;
	vmm: VM.Machine;
	error: VM.Error;

PROCEDURE MainWindow(ctx: MUI.Context; offsY, height: INTEGER);
VAR
	wr1: MUI.Rect;
	colWidths: ARRAY 3 OF INTEGER;
	blockCountInfo: ARRAY 64 OF CHAR;
	blockLabel: ARRAY 32 OF CHAR;
BEGIN
	wr1.x := 0; wr1.y := offsY; wr1.w := SCREEN_WIDTH; wr1.h := height;
	blockLabel := "Select a block: ";
	colWidths[0] := MUI.TextWidth(ctx, blockLabel);
	colWidths[1] := 200;
	colWidths[2] := -1;
	
	blockCountInfo:= " of ";
	String.Append(blockCountInfo, d0blocksStr);
	
	IF MUI.BeginWindowEx(ctx, "Blocks", wr1, MUI.OPT_NOINTERACT + MUI.OPT_NOCLOSE) THEN
		MUI.LayoutRow(ctx, 3, colWidths, 0);
		MUI.Label(ctx, blockLabel);
		IF MUI.SliderEx(ctx, d0currentBlock, 1.0, FLT(d0blocks), 1.0, "%.0f", MUI.OPT_ALIGNCENTER) THEN
			ST.ReadBlock(d0, FLOOR(d0currentBlock) - 1, currentBlock);			
			cursorPos.x := 0;
			cursorPos.y := 0;
		END;
		MUI.Label(ctx, blockCountInfo);
		MUI.EndWindow(ctx);
	END;
	
END MainWindow;


PROCEDURE LogPanel(ctx: MUI.Context; VAR error: VM.Error; x, y, height: INTEGER);
VAR
	wr1: MUI.Rect;
	i, sval: INTEGER;
	stackValStr: ARRAY 32 OF CHAR;
	errStr: ARRAY 64 OF CHAR;
	rowWidth1: ARRAY 1 OF INTEGER;
BEGIN
	wr1.x := x; wr1.y := y; wr1.w := SCREEN_WIDTH - x - 5; wr1.h := height;
	rowWidth1[0] := -1;
	
	MUI.LayoutSetNext(ctx, wr1, FALSE);
	MUI.BeginPanelEx(ctx, "Log", MUI.OPT_NONE);
	
	
	MUI.LayoutRow(ctx, 1, rowWidth1, 0);
	IF error.code # VM.ERR_NONE THEN
		MUI.Label(ctx, "Error: ");
		String.FromInt(error.code, errStr);
		String.Append(errStr, ": ");
		String.Append(errStr, error.msg);
		MUI.Label(ctx, errStr);
	END;
	
	MUI.Label(ctx, "Working stack: ");
	IF vmm.ws.sp > 0 THEN
		FOR i := vmm.ws.sp - 1 TO 0 BY -1 DO
			sval := vmm.ws.data[i];
			String.FromInt(sval, stackValStr);
			MUI.Label(ctx, stackValStr);
		END;
	ELSE
		MUI.Label(ctx, "<empty>");
	END;
	
	MUI.Label(ctx, "Return stack: ");
	IF vmm.ws.sp > 0 THEN
		FOR i := vmm.rs.sp - 1 TO 0 BY -1 DO
			sval := vmm.rs.data[i];
			String.FromInt(sval, stackValStr);
			MUI.Label(ctx, stackValStr);
		END;
	ELSE
		MUI.Label(ctx, "<empty>");
	END;
	
	MUI.EndPanel(ctx);
END LogPanel;


PROCEDURE BlockWindow(ctx: MUI.Context; offsY, height: INTEGER);
CONST
	ROW_YGAP = 5;
	ROW_XGAP = 5;
VAR
	wr1, dataRect, textRect: MUI.Rect;
	rowWidth1: ARRAY 8 OF INTEGER;
	colTextWidth: INTEGER;
	aliasLabel, maxColsLabel: ARRAY 32 OF CHAR;
	maxColsStr, cursorXStr, cursorYStr: ARRAY 4 OF CHAR;
	cursorOffsStr: ARRAY 8 OF CHAR;
	cursorInfo: ARRAY 32 OF CHAR;
	status: SET;
	entry: INTEGER;
BEGIN
	wr1.x := 0; wr1.y := offsY; wr1.w := SCREEN_WIDTH; wr1.h := height;
	colTextWidth := MUI.TextWidth(ctx, "#");
	rowWidth1[1] := 200;
	rowWidth1[2] := 200;
	rowWidth1[4] := 20;
	rowWidth1[5] := 20;
	rowWidth1[6] := 210;
	rowWidth1[7] := 75;
	aliasLabel:= "Alias: ";
	maxColsLabel:= " Columns: ";
	rowWidth1[0] := MUI.TextWidth(ctx, aliasLabel);
	rowWidth1[2] := MUI.TextWidth(ctx, maxColsLabel);
	rowWidth1[3] := MUI.TextWidth(ctx, "9999");
	String.FromInt(currentBlock.columns, maxColsStr);
	String.FromInt(cursorPos.x, cursorXStr);
	String.FromInt(cursorPos.y, cursorYStr);
	String.FromInt(cursorPos.x + (cursorPos.y * currentBlock.columns), cursorOffsStr);
	cursorInfo := " Cursor: ";
	String.Append(cursorInfo, cursorXStr);
	String.Append(cursorInfo, ", ");
	String.Append(cursorInfo, cursorYStr);
	String.Append(cursorInfo, " [");
	String.Append(cursorInfo, cursorOffsStr);
	String.Append(cursorInfo, "]");
	
	IF MUI.BeginWindowEx(ctx, "Block info", wr1, MUI.OPT_NOINTERACT + MUI.OPT_NOCLOSE) THEN
		MUI.LayoutRow(ctx, 8, rowWidth1, 0);
		MUI.Label(ctx, aliasLabel);
		status := MUI.Textbox(ctx, currentBlock.alias, LEN(currentBlock.alias));
		IF status = MUI.RES_SUBMIT THEN
			ST.WriteBlock(d0, FLOOR(d0currentBlock) - 1, currentBlock);
		END;
		MUI.Label(ctx, maxColsLabel);
		
		MUI.Label(ctx, maxColsStr);
		IF MUI.Button(ctx, "+") THEN
			IF currentBlock.columns < ME_MAX_COLS THEN
				INC(currentBlock.columns);
				ST.WriteBlock(d0, FLOOR(d0currentBlock) - 1, currentBlock);
			END;
		END;
		IF MUI.Button(ctx, "-") THEN
			IF currentBlock.columns > 0 THEN
				DEC(currentBlock.columns);
				ST.WriteBlock(d0, FLOOR(d0currentBlock) - 1, currentBlock);
			END;
		END;
		MUI.Label(ctx, cursorInfo);
		
		IF String.EndsWith(".ob07", currentBlock.alias) THEN
			IF MUI.Button(ctx, "Compile") THEN
				P.Tokenize(currentBlock);
			END;
		ELSIF String.EndsWith(".vm", currentBlock.alias) THEN
			IF MUI.Button(ctx, "Execute") THEN
				entry := cursorPos.x + (cursorPos.y * currentBlock.columns);
				VM.Run(vmm, currentBlock, entry, error);
				IF error.code # VM.ERR_NONE THEN // positioning cursor at error
					cursorPos.x := error.pos MOD currentBlock.columns;
					cursorPos.y := error.pos DIV currentBlock.columns;
				END;
			END;
			
		ELSE
			MUI.Label(ctx, "-------");
		END;
		
		IF currentBlock.columns > 0 THEN
			// Block text area
			MUI.LayoutNext(ctx, dataRect);
			textRect.x := ROW_XGAP;
			textRect.y := dataRect.y + ROW_YGAP;
			textRect.h := SCREEN_HEIGHT - textRect.y - ROW_YGAP;
			textRect.w := ((colTextWidth + 1) * currentBlock.columns) + (ROW_XGAP*2)-1;
			MUI.LayoutSetNext(ctx, textRect, FALSE);
			
			status := MUI.MultiText(ctx, currentBlock.columns, currentBlock.data, cursorPos, yOffs);
			IF status = MUI.RES_SUBMIT THEN
				ST.WriteBlock(d0, FLOOR(d0currentBlock) - 1, currentBlock);
			END;
			
			LogPanel(ctx, error, dataRect.x + textRect.w + 2, textRect.y + 1, textRect.h - 2);
		END;
		MUI.EndWindow(ctx);
	END;
	
END BlockWindow;


PROCEDURE Loop();
VAR
	fontSize: INTEGER;
	ctx: MUI.Context;
	font: RL.Font;
BEGIN

	d0.name := "disk0.raw";
	d0blocks := ST.AttachDisk(d0);
	String.FromInt(d0blocks, d0blocksStr);
	NEW(currentBlock);
	
	d0currentBlock := 2.0; // test
	ST.ReadBlock(d0, FLOOR(d0currentBlock) - 1, currentBlock);
	error.code := VM.ERR_NONE;
	
	RL.SetTargetFPS(60);
	RL.InitWindow(SCREEN_WIDTH, SCREEN_HEIGHT, "Block Editor");
	
	MUI.Init(ctx);
	fontSize := 16;
	RL.LoadFontEx("./assets/anonymous_pro_bold.ttf", font, fontSize);
	MURL.SetupFontEx(ctx, font);
	
	WHILE ~ RL.WindowShouldClose() DO
	
		MURL.HandleInput(ctx);
		MUI.Begin(ctx);
			MainWindow(ctx, 0, 60);
			BlockWindow(ctx, 60, SCREEN_HEIGHT - 60);
		MUI.End(ctx);
	
		RL.BeginDrawing();
			RL.ClearBackground(RL.WHITE);
			MURL.Render(ctx);
		RL.EndDrawing();
	END;
	
	ST.DetachDisk(d0);
	
	MUI.Destroy(ctx);
	RL.CloseWindow();
END Loop;


BEGIN
	Loop()
END BlockEditor.
