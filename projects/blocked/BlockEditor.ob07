MODULE BlockEditor;
IMPORT
	SYSTEM,
	ST IN "./lib/Storage.ob07",
	RL IN "./lib/Raylib.ob07",
	MUI IN "./lib/MicroUI.ob07",
	MURL IN "./lib/MURL.ob07",
	String IN "./lib/String.ob07",
	P IN "./lib/Parser.ob07",
	VM IN "./lib/VM.ob07",
	Out := Out_sys;

CONST
	SCREEN_WIDTH = 800;
	SCREEN_HEIGHT = 600;
	ME_MAX_COLS = 80;

VAR
	d0: ST.Disk;
	d0blocks: INTEGER;
	d0blocksStr: ARRAY 32 OF CHAR;
	d0currentBlock: REAL;
	currentBlock: ST.Block;
	cursorPos: MUI.Vec2;
	yOffs: INTEGER;
	vmm: VM.Machine;
	error: VM.Error;
	break: BOOLEAN;


PROCEDURE UpdateCursorByPC();
VAR
	pc: INTEGER;
BEGIN
	pc := VM.GetPC(vmm);
	cursorPos.x := pc MOD currentBlock.columns;
	cursorPos.y := pc DIV currentBlock.columns;
END UpdateCursorByPC;


PROCEDURE MainWindow(ctx: MUI.Context; offsY, height: INTEGER);
VAR
	wr1: MUI.Rect;
	colWidths: ARRAY 3 OF INTEGER;
	blockCountInfo: ARRAY 64 OF CHAR;
	blockLabel: ARRAY 32 OF CHAR;
BEGIN
	wr1.x := 0; wr1.y := offsY; wr1.w := SCREEN_WIDTH; wr1.h := height;
	blockLabel := "Select a block: ";
	colWidths[0] := MUI.TextWidth(ctx, blockLabel);
	colWidths[1] := 200;
	colWidths[2] := -1;
	
	blockCountInfo:= " of ";
	String.Append(blockCountInfo, d0blocksStr);
	
	IF MUI.BeginWindowEx(ctx, "Blocks", wr1, MUI.OPT_NOINTERACT + MUI.OPT_NOCLOSE) THEN
		MUI.LayoutRow(ctx, 3, colWidths, 0);
		MUI.Label(ctx, blockLabel);
		IF MUI.SliderEx(ctx, d0currentBlock, 1.0, FLT(d0blocks), 1.0, "%.0f", MUI.OPT_ALIGNCENTER) THEN
			ST.ReadBlock(d0, FLOOR(d0currentBlock) - 1, currentBlock);			
			cursorPos.x := 0;
			cursorPos.y := 0;
			yOffs := 0;
		END;
		MUI.Label(ctx, blockCountInfo);
		MUI.EndWindow(ctx);
	END;
	
END MainWindow;


PROCEDURE LogPanel(ctx: MUI.Context; VAR error: VM.Error; x, y, height: INTEGER);
VAR
	wr1: MUI.Rect;
	rowWidth1: ARRAY 1 OF INTEGER;
	
	PROCEDURE Toolbar(ctx: MUI.Context; VAR error: VM.Error);
	VAR
		rowWidth2: ARRAY 5 OF INTEGER;
		entry: INTEGER;
	BEGIN
		rowWidth2[0] := 70;
		rowWidth2[1] := 5;
		rowWidth2[2] := 70;
		rowWidth2[3] := 5;
		rowWidth2[4] := 70;
		MUI.LayoutRow(ctx, 5, rowWidth2, 0);
		
		IF MUI.Button(ctx, "Execute") THEN
			entry := cursorPos.x + (cursorPos.y * currentBlock.columns);
			VM.Run(vmm, currentBlock, entry, error);
			UpdateCursorByPC();
		END;
		MUI.Label(ctx, "");
		IF MUI.Button(ctx, "Debug") THEN
			break := FALSE;
			entry := cursorPos.x + (cursorPos.y * currentBlock.columns);
			VM.Debug(vmm, currentBlock, entry, error, break);
			UpdateCursorByPC();
		END;
		IF ~ break THEN
			MUI.Label(ctx, "");
			IF MUI.Button(ctx, "Step") THEN
				VM.Step(vmm, currentBlock, error, break);
				break := break OR (error.code # VM.ERR_NONE);
				UpdateCursorByPC();
			END;
		END;
	END Toolbar;
	
	PROCEDURE Error(ctx: MUI.Context; VAR error: VM.Error);
	VAR
		 errStr, errStr2: ARRAY 64 OF CHAR;
	BEGIN
		IF error.code # VM.ERR_NONE THEN
			String.Append(errStr, "Error at [");
			String.FromInt(error.pos, errStr2);
			String.Append(errStr, errStr2);
			String.Append(errStr, "]");
			MUI.Label(ctx, errStr);
			String.Clear(errStr);
			String.Clear(errStr2);
			String.FromInt(error.code, errStr2);
			String.Append(errStr, errStr2);
			String.Append(errStr, ": ");
			String.Append(errStr, error.msg);
			MUI.Label(ctx, errStr);
			MUI.HRule(ctx, 2);
		END;
	END Error;
	
	PROCEDURE AddRegLabel(ctx: MUI.Context; VAR regStr, regInfoStr: ARRAY OF CHAR);
	BEGIN
		String.Append(regInfoStr, regStr);
		MUI.Label(ctx, regInfoStr);
		String.Clear(regStr);
		String.Clear(regInfoStr);
	END AddRegLabel;
	
	PROCEDURE Registers(ctx: MUI.Context);
	VAR 
		r, s, t, x: INTEGER;
		u, v: REAL;
		regStr: ARRAY 32 OF CHAR;
		regInfoStr: ARRAY 64 OF CHAR;
	BEGIN
		VM.GetRegisters(vmm, r, s, t, x, u, v);
		MUI.Label(ctx, "Registers: ");
		regInfoStr := "R: ";
		String.FromInt(r, regStr);
		AddRegLabel(ctx, regStr, regInfoStr);
		
		regInfoStr := "S: ";
		String.FromInt(s, regStr);
		AddRegLabel(ctx, regStr, regInfoStr);
		
		regInfoStr := "T: ";
		String.FromInt(s, regStr);
		AddRegLabel(ctx, regStr, regInfoStr);
		
		regInfoStr := "U: ";
		String.FromReal(u, 3, regStr);
		AddRegLabel(ctx, regStr, regInfoStr);
		
		regInfoStr := "V: ";
		String.FromReal(v, 3, regStr);
		AddRegLabel(ctx, regStr, regInfoStr);
		
		regInfoStr := "X: ";
		String.FromInt(x, regStr);
		AddRegLabel(ctx, regStr, regInfoStr);
		
	END Registers;
	
	PROCEDURE GetKindSymbol(kind: BYTE; VAR symbol: ARRAY OF CHAR);
	BEGIN
		CASE kind OF 
		| VM.KIND_INT: COPY("#", symbol);
		| VM.KIND_REAL: COPY("$", symbol);
		| VM.KIND_POINTER: COPY("^", symbol);
		ELSE COPY("?", symbol); END;
	END;

	PROCEDURE GetKindValue(kind: BYTE; idx: INTEGER; VAR valStr: ARRAY OF CHAR);
	VAR
		sval: INTEGER;
		rval: REAL;
	BEGIN
		CASE kind OF
		| VM.KIND_REAL:
			rval := SYSTEM.VAL(vmm.ws.data[idx].value, REAL);
			String.FromReal(rval, 3, valStr);
		| VM.KIND_INT, VM.KIND_POINTER:
			sval := vmm.ws.data[idx].value.h;
			String.FromInt(sval, valStr);
		ELSE
			COPY("?", valStr);
		END;
	END;
	
	PROCEDURE WorkingStack(ctx: MUI.Context);
	VAR
		i, sval, kind: INTEGER;
		valKind: ARRAY 2 OF CHAR;
		valStr: ARRAY 32 OF CHAR;
		valAlias: VM.Identifier;
		stackValInfo: ARRAY 32 OF CHAR;
		rowWidth1: ARRAY 4 OF INTEGER;
	BEGIN
		MUI.Label(ctx, "Working stack: ");
		IF vmm.ws.top >= 0 THEN
			rowWidth1[0] := 30;
			rowWidth1[1] := 15;
			rowWidth1[2] := 110;
			rowWidth1[3] := -1;
			
			FOR i := vmm.ws.top TO 0 BY -1 DO
				MUI.LayoutRow(ctx, 4, rowWidth1, 0);
				// stack index
				String.FromInt(i, valStr);
				String.Append(stackValInfo, valStr);
				MUI.Label(ctx, stackValInfo);
				String.Clear(valStr);
				String.Clear(stackValInfo);
				// type symbol
				kind := vmm.ws.data[i].kind;
				GetKindSymbol(kind, valKind);
				String.Append(stackValInfo, valKind);
				MUI.Label(ctx, stackValInfo);
				String.Clear(valKind);
				String.Clear(stackValInfo);
				// value
				GetKindValue(kind, i, valStr);
				String.Append(stackValInfo, valStr);
				MUI.Label(ctx, stackValInfo);
				String.Clear(valStr);
				String.Clear(stackValInfo);
				// alias
				sval := vmm.ws.data[i].alias;
				IF sval > 0 THEN
					VM.GetAlias(vmm, sval, valAlias);
					String.Append(stackValInfo, valAlias);
					MUI.Label(ctx, stackValInfo);
					String.Clear(valAlias);
					String.Clear(stackValInfo);
				ELSE
					MUI.Label(ctx, "");
				END;
			END;
		ELSE
			MUI.Label(ctx, "<empty>");
		END;
	END WorkingStack;
	
	PROCEDURE ReturnStack(ctx: MUI.Context);
	VAR
		i, sval, kind: INTEGER;
		stackValStr: ARRAY 16 OF CHAR;
		stackValInfo: ARRAY 32 OF CHAR;
		rowWidth1: ARRAY 3 OF INTEGER;
	BEGIN
		MUI.Label(ctx, "Return stack: ");
		IF vmm.rs.top >= 0 THEN
			rowWidth1[0] := 30;
			rowWidth1[1] := 15;
			rowWidth1[2] := -1;
			FOR i := vmm.rs.top TO 0 BY -1 DO
				MUI.LayoutRow(ctx, 3, rowWidth1, 0);
				// stack index
				String.FromInt(i, stackValStr);
				String.Append(stackValInfo, stackValStr);
				MUI.Label(ctx, stackValInfo);
				String.Clear(stackValInfo);
				String.Clear(stackValStr);
				// type symbol
				kind := vmm.ws.data[i].kind;
				GetKindSymbol(kind, stackValStr);
				String.Append(stackValInfo, stackValStr);
				MUI.Label(ctx, stackValInfo);
				String.Clear(stackValInfo);
				String.Clear(stackValStr);
				// value
				sval := vmm.rs.data[i].value.h;
				String.FromInt(sval, stackValStr);
				String.Append(stackValInfo, stackValStr);
				MUI.Label(ctx, stackValInfo);
				String.Clear(stackValInfo);
				String.Clear(stackValStr);
			END;
		ELSE
			MUI.Label(ctx, "<empty>");
		END;
	END ReturnStack;
	
	PROCEDURE HeapInfo(ctx: MUI.Context; width: INTEGER);
	VAR
		size, usage: INTEGER;
		valStr: ARRAY 16 OF CHAR;
		memInfo: ARRAY 32 OF CHAR;
		rowWidth1: ARRAY 2 OF INTEGER;
	BEGIN
		VM.GetMemoryStats(vmm, size, usage);
		rowWidth1[0] := (width DIV 2) - 5;
		rowWidth1[1] := -1;
		// 
		MUI.Label(ctx, "Memory status: ");
		MUI.LayoutRow(ctx, 2, rowWidth1, 0);
		String.Append(memInfo, "Size: ");
		String.FromInt(size, valStr);
		String.Append(memInfo, valStr);
		MUI.Label(ctx, memInfo);
		String.Clear(valStr);
		String.Clear(memInfo);
		String.Append(memInfo, "Usage: ");
		String.FromInt(usage, valStr);
		String.Append(memInfo, valStr);
		MUI.Label(ctx, memInfo);
	END;
	
BEGIN
	wr1.x := x; wr1.y := y; wr1.w := SCREEN_WIDTH - x - 5; wr1.h := height;
	rowWidth1[0] := -1;
	
	MUI.LayoutSetNext(ctx, wr1, FALSE);
	MUI.BeginPanelEx(ctx, "Log", MUI.OPT_NONE);
		Toolbar(ctx, error);
		MUI.LayoutRow(ctx, 1, rowWidth1, 0);
		MUI.HRule(ctx, 2);
		Error(ctx, error);
		Registers(ctx);
		MUI.HRule(ctx, 2);
		WorkingStack(ctx);
		MUI.LayoutRow(ctx, 1, rowWidth1, 0);
		MUI.HRule(ctx, 2);
		ReturnStack(ctx);
		MUI.LayoutRow(ctx, 1, rowWidth1, 0);
		MUI.HRule(ctx, 2);
		HeapInfo(ctx, wr1.w);	
	MUI.EndPanel(ctx);
END LogPanel;


PROCEDURE BlockWindow(ctx: MUI.Context; offsY, height: INTEGER);
CONST
	ROW_YGAP = 5;
	ROW_XGAP = 5;
VAR
	wr1, dataRect, textRect: MUI.Rect;
	rowWidth1: ARRAY 8 OF INTEGER;
	colTextWidth: INTEGER;
	aliasLabel, maxColsLabel: ARRAY 32 OF CHAR;
	maxColsStr, cursorXStr, cursorYStr: ARRAY 4 OF CHAR;
	cursorOffsStr: ARRAY 8 OF CHAR;
	cursorInfo: ARRAY 32 OF CHAR;
	status: SET;
BEGIN
	wr1.x := 0; wr1.y := offsY; wr1.w := SCREEN_WIDTH; wr1.h := height;
	colTextWidth := MUI.TextWidth(ctx, "#");
	rowWidth1[1] := 200;
	rowWidth1[2] := 200;
	rowWidth1[4] := 20;
	rowWidth1[5] := 20;
	rowWidth1[6] := 210;
	rowWidth1[7] := 75;
	aliasLabel:= "Alias: ";
	maxColsLabel:= " Columns: ";
	rowWidth1[0] := MUI.TextWidth(ctx, aliasLabel);
	rowWidth1[2] := MUI.TextWidth(ctx, maxColsLabel);
	rowWidth1[3] := MUI.TextWidth(ctx, "9999");
	String.FromInt(currentBlock.columns, maxColsStr);
	String.FromInt(cursorPos.x, cursorXStr);
	String.FromInt(cursorPos.y, cursorYStr);
	String.FromInt(cursorPos.x + (cursorPos.y * currentBlock.columns), cursorOffsStr);
	cursorInfo := " Cursor: ";
	String.Append(cursorInfo, cursorXStr);
	String.Append(cursorInfo, ", ");
	String.Append(cursorInfo, cursorYStr);
	String.Append(cursorInfo, " [");
	String.Append(cursorInfo, cursorOffsStr);
	String.Append(cursorInfo, "]");
	
	IF MUI.BeginWindowEx(ctx, "Block info", wr1, MUI.OPT_NOINTERACT + MUI.OPT_NOCLOSE) THEN
		MUI.LayoutRow(ctx, 8, rowWidth1, 0);
		MUI.Label(ctx, aliasLabel);
		status := MUI.Textbox(ctx, currentBlock.alias, LEN(currentBlock.alias));
		IF status = MUI.RES_SUBMIT THEN
			ST.WriteBlock(d0, FLOOR(d0currentBlock) - 1, currentBlock);
		END;
		MUI.Label(ctx, maxColsLabel);
		
		MUI.Label(ctx, maxColsStr);
		IF MUI.Button(ctx, "+") THEN
			IF currentBlock.columns < ME_MAX_COLS THEN
				INC(currentBlock.columns);
				ST.WriteBlock(d0, FLOOR(d0currentBlock) - 1, currentBlock);
			END;
		END;
		IF MUI.Button(ctx, "-") THEN
			IF currentBlock.columns > 0 THEN
				DEC(currentBlock.columns);
				ST.WriteBlock(d0, FLOOR(d0currentBlock) - 1, currentBlock);
			END;
		END;
		MUI.Label(ctx, cursorInfo);
		
		IF String.EndsWith(".ob07", currentBlock.alias) THEN
			IF MUI.Button(ctx, "Compile") THEN
				P.Tokenize(currentBlock);
			END;
		
		ELSE
			MUI.Label(ctx, "");
		END;
		
		
		IF currentBlock.columns > 0 THEN
			// Block text area
			MUI.LayoutNext(ctx, dataRect);
			textRect.x := ROW_XGAP;
			textRect.y := dataRect.y + ROW_YGAP;
			textRect.h := SCREEN_HEIGHT - textRect.y - ROW_YGAP;
			textRect.w := ((colTextWidth + 1) * currentBlock.columns) + (ROW_XGAP*2)-1;
			MUI.LayoutSetNext(ctx, textRect, FALSE);
			
			status := MUI.MultiText(ctx, currentBlock.columns, currentBlock.data, cursorPos, yOffs);
			IF status = MUI.RES_SUBMIT THEN
				ST.WriteBlock(d0, FLOOR(d0currentBlock) - 1, currentBlock);
			END;
			
			IF String.EndsWith(".vm", currentBlock.alias) THEN
				LogPanel(ctx, error, dataRect.x + textRect.w + 2, textRect.y + 1, textRect.h - 2);
			END;
		END;
		MUI.EndWindow(ctx);
	END;
	
END BlockWindow;


PROCEDURE Loop();
VAR
	fontSize: INTEGER;
	ctx: MUI.Context;
	font: RL.Font;
BEGIN

	d0.name := "disk0.raw";
	d0blocks := ST.AttachDisk(d0);
	String.FromInt(d0blocks, d0blocksStr);
	NEW(currentBlock);
	
	d0currentBlock := 2.0; // test
	ST.ReadBlock(d0, FLOOR(d0currentBlock) - 1, currentBlock);
	error.code := VM.ERR_NONE;
	break := TRUE;
	
	VM.InitMachine(vmm, 4096);
	
	RL.SetTargetFPS(60);
	RL.InitWindow(SCREEN_WIDTH, SCREEN_HEIGHT, "Block Editor");
	
	MUI.Init(ctx);
	fontSize := 16;
	RL.LoadFontEx("./assets/anonymous_pro_bold.ttf", font, fontSize);
	MURL.SetupFontEx(ctx, font);
	
	WHILE ~ RL.WindowShouldClose() DO
	
		MURL.HandleInput(ctx);
		MUI.Begin(ctx);
			MainWindow(ctx, 0, 60);
			BlockWindow(ctx, 60, SCREEN_HEIGHT - 60);
		MUI.End(ctx);
	
		RL.BeginDrawing();
			RL.ClearBackground(RL.WHITE);
			MURL.Render(ctx);
		RL.EndDrawing();
	END;
	
	ST.DetachDisk(d0);
	
	MUI.Destroy(ctx);
	RL.CloseWindow();
END Loop;


BEGIN
	Loop()
END BlockEditor.
