MODULE Arena;
IMPORT SYSTEM;

CONST 
	OUT_OF_MEMORY = 99;

TYPE
	Memory* = POINTER TO RECORD
		size: INTEGER;
		offset*: INTEGER;
		data: INTEGER
	END;


PROCEDURE [extern, "malloc"] malloc(size: INTEGER): INTEGER;
PROCEDURE [extern, "free"] free(ptr: INTEGER);


PROCEDURE Create*(size: INTEGER): Memory;
VAR
	mem: Memory;
BEGIN
	NEW(mem);
	mem.size := size;
	mem.data := malloc(size);
	RETURN mem
END Create;


PROCEDURE Destroy*(mem: Memory);
BEGIN
	free(mem.data);
	DISPOSE(mem);
END Destroy;


PROCEDURE Wipe*(mem: Memory);
VAR
	i: INTEGER;
BEGIN
	FOR i := 0 TO mem.size - 1 DO
		SYSTEM.PUT8(mem.data + i, 0);
	END;
	mem.offset := 0;
END Wipe;


PROCEDURE Alloc*(mem: Memory; size: INTEGER): INTEGER;
VAR
	baddr: INTEGER;
BEGIN
	IF mem.offset + size > mem.size THEN
		RAISE(OUT_OF_MEMORY);
	END;
	baddr := mem.data + mem.offset;
	SYSTEM.PUT32(baddr, size);
	INC(mem.offset, size);
	RETURN baddr
END Alloc;


PROCEDURE Free*(mem: Memory; addr: INTEGER); END Free;


PROCEDURE GetStats*(mem: Memory; VAR size, usage: INTEGER);
BEGIN
	size := mem.size;
	usage := mem.offset;
END GetStats;


END Arena.
