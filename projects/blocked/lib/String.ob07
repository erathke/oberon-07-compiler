MODULE String;
IMPORT SYSTEM , Out := Out_sys;


PROCEDURE FromInt*(x: INTEGER; VAR str: ARRAY OF CHAR);
VAR
    i, a: INTEGER;
BEGIN
    i := 0;
    a := x;
    
    IF x < 0 THEN
		str[i] := "-";
		a := -a;
		x := -x;
		INC(i);
    END;
    
    REPEAT
        INC(i);
        a := a DIV 10
    UNTIL a = 0;

    str[i] := 0X;

    REPEAT
        DEC(i);
        str[i] := CHR(x MOD 10 + ORD("0"));
        x := x DIV 10
    UNTIL x = 0
END FromInt;


PROCEDURE Append*(VAR dest: ARRAY OF CHAR; from: ARRAY OF CHAR);
VAR
    n1, n2: INTEGER;
BEGIN
    n1 := LENGTH(dest);
    n2 := LENGTH(from);

    ASSERT(n1 + n2 < LEN(dest));

    SYSTEM.MOVE(SYSTEM.ADR(from[0]), SYSTEM.ADR(dest[n1]), n2);
    dest[n1 + n2] := 0X
END Append;


PROCEDURE Upper*(VAR dest: ARRAY OF CHAR; from: ARRAY OF CHAR);
CONST
	OFFSET = 32;
VAR
    n1, n2: INTEGER;
    ch: CHAR;
    i, ich: INTEGER;
BEGIN
	n1 := LEN(dest);
    n2 := LEN(from);
    ASSERT(n1 >= n2);
    FOR i := 0 TO n2 - 1 DO
		ch := from[i];
		IF ch # 0X THEN
			IF (ch >= 'a') & (ch <= 'z') THEN
				ich := ORD(ch);
				dest[i] := CHR(ich - OFFSET);
			END;
		END;
    END;
END Upper;


PROCEDURE EndsWith*(suffix: ARRAY OF CHAR; str: ARRAY OF CHAR): BOOLEAN;
VAR
    n1, n2: INTEGER;
    match, stop: BOOLEAN;
BEGIN
	n1 := LENGTH(suffix);
    n2 := LENGTH(str);
    
    IF n1 <= n2 THEN
		WHILE (n1 > 0) & (~ stop) DO
			match := suffix[n1 - 1] = str[n2 - 1];
			stop := ~ match;
			DEC(n1); DEC(n2);
		END;
    END;
    RETURN match
END EndsWith;


PROCEDURE ToInt*(str: ARRAY OF CHAR; VAR value: INTEGER): BOOLEAN;
CONST
	ZERO = 48;
	NINE = 57;
VAR
    n1, start, ich: INTEGER;
    invalid: BOOLEAN;
    base, mult: INTEGER;
    ch: CHAR;
BEGIN
	n1 := LENGTH(str);
	
	IF n1 > 0 THEN	
		IF str[0] = '-' THEN
			base := -1;
			start := 1;
		ELSE
			base := 1;
			start := 0;
		END;
	END;

    IF n1 > start THEN
		mult := 1;
		WHILE (n1 > start) & (~ invalid) DO
			ch := str[n1 - 1];
			ich := ORD(ch);
			IF (ich >= ZERO) & (ich <= NINE) THEN
				value := value + (mult * (ich - ZERO));
			ELSE
				invalid := TRUE;
			END;
			DEC(n1);
			mult := mult * 10;
		END;
		value := value * base;
    END;
    
    RETURN ~ invalid
END ToInt;


PROCEDURE Split(str: ARRAY OF CHAR; sep: CHAR; VAR left, right: ARRAY OF CHAR);
VAR
	n1, n2, n3: INTEGER;
	sidx: INTEGER;
	i, j: INTEGER;
	ch: CHAR;
BEGIN
	n1 := LEN(str);
	n2 := LEN(left);
	ASSERT(n2 >= n1);
	n3 := LEN(right);
	ASSERT(n3 >= n1);
	sidx := -1;
	j := 0;
	FOR i := 0 TO n1 - 1 DO
		ch := str[i];
		IF ch = sep THEN
			sidx := i;
			i := n1;
		ELSE
			left[j] := ch;
			INC(j);
		END;
	END;
	
	IF sidx >= 0 THEN
		j := 0;
		FOR i := sidx + 1 TO n1 - 1 DO
			right[j] := str[i];
			INC(j);
		END;
	END;
END;


PROCEDURE ToReal*(str: ARRAY OF CHAR; VAR value: REAL): BOOLEAN;
VAR
	lp, rp: REAL;
	iv: INTEGER;
	left, right: ARRAY 32 OF CHAR;
	rlen: INTEGER;
	success: BOOLEAN;
	divisor: REAL;
	
	
	PROCEDURE CalcDivisor(len: INTEGER; VAR divisor: REAL);
	BEGIN
		divisor := 1.0;
		WHILE len > 0 DO
			divisor := divisor * 10.0;
			DEC(len);
		END;
		
	END CalcDivisor;
	
BEGIN
	Split(str, '.', left, right);
	success := ToInt(left, iv);
	IF success THEN
		lp := FLT(iv);
		rlen := LENGTH(right);
		IF (rlen > 0) THEN
			iv := 0;
			success := ToInt(right, iv);
			IF success THEN
				CalcDivisor(rlen, divisor);
				rp := FLT(iv) / divisor;
			END;			
		END;
		IF lp >= 0.0 THEN
			value := lp + rp;
		ELSE
			value := lp - rp;
		END;
	END;
	
	RETURN success
END ToReal;


PROCEDURE FromReal*(r: REAL; VAR str: ARRAY OF CHAR);
VAR
	h, l: INTEGER;
BEGIN
	h := FLOOR(r);
	l := FLOOR(FLT(h) - r);
	
	Out.String("h: "); Out.Int(h, 0); Out.Ln;
	Out.String("l: "); Out.Int(l, 0); Out.Ln;
	
END FromReal;


PROCEDURE Clear*(VAR str: ARRAY OF CHAR);
VAR
    n1, i: INTEGER;
BEGIN
	n1 := LEN(str);
	FOR i := 0 TO n1 - 1 DO
		str[i] := 0X;
	END;
END Clear;


END String.
