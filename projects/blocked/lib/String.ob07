MODULE String;
IMPORT SYSTEM;


PROCEDURE FromInt*(x: INTEGER; VAR str: ARRAY OF CHAR);
VAR
    i, a: INTEGER;
BEGIN
    i := 0;
    a := x;
    
    IF x < 0 THEN
		str[i] := "-";
		a := -a;
		x := -x;
		INC(i);
    END;
    
    REPEAT
        INC(i);
        a := a DIV 10
    UNTIL a = 0;

    str[i] := 0X;

    REPEAT
        DEC(i);
        str[i] := CHR(x MOD 10 + ORD("0"));
        x := x DIV 10
    UNTIL x = 0
END FromInt;


PROCEDURE Append*(VAR dest: ARRAY OF CHAR; from: ARRAY OF CHAR);
VAR
    n1, n2: INTEGER;
BEGIN
    n1 := LENGTH(dest);
    n2 := LENGTH(from);

    ASSERT(n1 + n2 < LEN(dest));

    SYSTEM.MOVE(SYSTEM.ADR(from[0]), SYSTEM.ADR(dest[n1]), n2);
    dest[n1 + n2] := 0X
END Append;


PROCEDURE Upper*(VAR dest: ARRAY OF CHAR; from: ARRAY OF CHAR);
CONST
	OFFSET = 32;
VAR
    n1, n2: INTEGER;
    ch: CHAR;
    i, ich: INTEGER;
BEGIN
	n1 := LEN(dest);
    n2 := LEN(from);
    ASSERT(n1 >= n2);
    FOR i := 0 TO n2 - 1 DO
		ch := from[i];
		IF ch # 0X THEN
			IF (ch >= 'a') & (ch <= 'z') THEN
				ich := ORD(ch);
				dest[i] := CHR(ich - OFFSET);
			END;
		END;
    END;
END Upper;


PROCEDURE EndsWith*(suffix: ARRAY OF CHAR; str: ARRAY OF CHAR): BOOLEAN;
VAR
    n1, n2: INTEGER;
    match, stop: BOOLEAN;
BEGIN
	n1 := LENGTH(suffix);
    n2 := LENGTH(str);
    
    IF n1 <= n2 THEN
		WHILE (n1 > 0) & (~ stop) DO
			match := suffix[n1 - 1] = str[n2 - 1];
			stop := ~ match;
			DEC(n1); DEC(n2);
		END;
    END;
    RETURN match
END EndsWith;


PROCEDURE ToInt*(str: ARRAY OF CHAR; VAR value: INTEGER): BOOLEAN;
CONST
	ZERO = 48;
	NINE = 57;
VAR
    n1, start, ich: INTEGER;
    invalid: BOOLEAN;
    base, mult: INTEGER;
    ch: CHAR;
BEGIN
	n1 := LENGTH(str);
	
	IF n1 > 0 THEN	
		IF str[0] = '-' THEN
			base := -1;
			start := 1;
		ELSE
			base := 1;
			start := 0;
		END;
	END;

    IF n1 > start THEN
		mult := 1;
		WHILE (n1 > start) & (~ invalid) DO
			ch := str[n1 - 1];
			ich := ORD(ch);
			IF (ich >= ZERO) & (ich <= NINE) THEN
				value := value + (mult * (ich - ZERO));
			ELSE
				invalid := TRUE;
			END;
			DEC(n1);
			mult := mult * 10;
		END;
		value := value * base;
    END;
    
    RETURN ~ invalid
END ToInt;


PROCEDURE Clear*(VAR str: ARRAY OF CHAR);
VAR
    n1, i: INTEGER;
BEGIN
	n1 := LEN(str);
	FOR i := 0 TO n1 - 1 DO
		str[i] := 0X;
	END;
END Clear;


END String.
