MODULE VM;
IMPORT 
	Out := Out_sys,
	SYSTEM, Arena, 
	ST IN "./Storage.ob07",
	String IN "./String.ob07",
	STK IN "./Stack.ob07",
	ERR IN "./Errors.ob07";

CONST
	DICT_SIZE = 128;
	
	MARK_END = 0; // .
	MARK_ID_DEF = 1; // red
	MARK_TP_INT = 2; // yellow
	MARK_TP_REAL = 3; // cyan
	MARK_ID_REF = 4; // green
	MARK_TP_ADDR = 5; // blue
	MARK_ID_MACRO = 6; // gray
	MARK_ALIAS_DEF = 7; // brass
	MARK_ALIAS_WRITE = 8; // brass
	MARK_ALIAS_READ = 9; // brass
	MARK_PTR_WRITE = 10; // brass
	MARK_PTR_READ = 11; // brass
	MARK_FFI = 12; // spring green
	MARK_ID_BRK = 13; //  = BREAK
	MARK_ID_AT = 14; // orange = AT
	MARK_ID_END = 15; // RET
	
	MARKS = 16;
	
	INST_ERR = -1;
	INST_NOP = 0;
	INST_ID = 1;
	INST_CALL = 2;
	INST_RET = 3;
	INST_PUSH_INT = 4;
	INST_ADD_INT = 5; // TODO: replace with RS+?
	INST_JUMP = 6;
	INST_JUMP_ZERO = 7;
	INST_JUMP_ONE = 8;
	INST_PUSH_R = 10;
	INST_POP_R = 11;
	INST_PUSH_S = 12;
	INST_POP_S = 13;
	INST_ADD_RS = 14;
	INST_DIV_RS = 15;
	INST_MULT_RS = 16;
	INST_MOV_RS = 17;
	INST_MOV_SR = 18;
	INST_PUSH_REAL = 19;
	INST_PUSH_U = 20;
	INST_POP_U = 21;
	INST_PUSH_V = 22;
	INST_POP_V = 23;
	INST_ADD_UV = 24;
	INST_DIV_UV = 25;
	INST_MULT_UV = 26;
	INST_ADD_UR = 27;
	INST_DIV_UR = 28;
	INST_MULT_UR = 29;
	INST_MOV_UV = 30;
	INST_MOV_VU = 31;
	INST_PUSH_X = 32;
	INST_POP_X = 33;
	INST_MOV_XS = 34;
	INST_MOV_SX = 35;
	INST_AT = 36;
	INST_BRK = 37;
	INST_ALIAS = 38;
	INST_ALIAS_WRITE = 39;
	INST_ALIAS_READ = 40;
	INST_ALLOCB = 50;
	INST_ALLOCS = 51; // TODO
	INST_PTR_WRITE = 52;
	INST_PTR_READ = 53;
	INST_JUMP_COND_IF = 54; // TODO
	INST_JUMP_COND_IFELSE = 55;
	INST_DUP = 56;
	INST_DROP = 57;
	INST_SWAP = 58;
	INST_OVER = 59;
	INST_NIP = 60;
	INST_EQUAL = 62;
	INST_JUMP_FOR = 70;
	INST_JUMP_NEXT = 71;
	INST_JUMP_BREAK = 72;
	INST_FFI_CALL = 73;
	
	MAX_INSTRUCTIONS = 3960; // TODO: dynamic instruction array
	MAX_MACRO_FOR = 3;
	
TYPE
	
	Identifier* = ARRAY 32 OF CHAR;
	
	Word = RECORD
		name: Identifier;
		address: INTEGER
	END;
	
	Dictionary = ARRAY DICT_SIZE OF Word;
	
	Value = STK.Value;

	Instruction = RECORD
		code, address: INTEGER;
		value: Value
	END;
	
	Error = ERR.Error;
	
	Stack = STK.Stack;
	
	Function* = PROCEDURE(VAR ws: Stack; argc: INTEGER): INTEGER;
	
	Machine* = RECORD
		pc, ic: INTEGER;
		ws*, rs*: Stack;
		// data registers
		R, S, T: INTEGER; // working stack
		U, V: REAL; // working stack
		X: INTEGER; // return stack
		// control registers
		J: INTEGER;
		I: ARRAY MAX_MACRO_FOR OF INTEGER; // for / next
		// flags
		L: BOOLEAN;
		//
		code: ARRAY MAX_INSTRUCTIONS OF Instruction;
		heap: Arena.Memory;
		// TODO: refactor dictionary
		words: Dictionary;
		aliases: Dictionary;
		ffi: Dictionary;
		wordCount: INTEGER;
		aliasCount: INTEGER;
		ffiCount: INTEGER
	END;

	ResetFunction* = PROCEDURE(VAR m: Machine);


VAR
	onReset: ResetFunction;


PROCEDURE GetPC*(m: Machine): INTEGER;
BEGIN
	RETURN m.pc
END GetPC;


PROCEDURE GetRegisters*(m: Machine; VAR r, s, t, x: INTEGER; VAR u, v: REAL);
BEGIN
	r := m.R; s := m.S; t := m.T;
	x := m.X;
	u := m.U; v := m.V;
END GetRegisters;


PROCEDURE GetAlias*(m: Machine; idx: INTEGER; VAR id: Identifier);
BEGIN
	COPY(m.aliases[idx - 1].name, id); 
END GetAlias;


PROCEDURE GetMemoryStats*(m: Machine; VAR size, usage: INTEGER);
BEGIN
	Arena.GetStats(m.heap, size, usage);
END GetMemoryStats;


PROCEDURE AddInstruction(VAR m: Machine; code, ivalue, address: INTEGER);
VAR
	instr: Instruction;
BEGIN 
	instr.code := code;
	instr.address := address;
	instr.value.h := ivalue;
	m.code[address] := instr;
	INC(m.ic);
END;


PROCEDURE AddInstructionR(VAR m: Machine; code: INTEGER; rvalue: REAL; address: INTEGER);
VAR
	instr: Instruction;
BEGIN 
	instr.code := code;
	instr.address := address;
	SYSTEM.MOVE(SYSTEM.ADR(rvalue), SYSTEM.ADR(instr.value.h), 4);
	SYSTEM.MOVE(SYSTEM.ADR(rvalue) + 4, SYSTEM.ADR(instr.value.l), 4);
	m.code[address] := instr;
	INC(m.ic);
END;


PROCEDURE Parse(VAR m: Machine; block: ST.Block; len: INTEGER);
VAR
	token: CHAR;
	i, j, k: INTEGER;
	token_id: INTEGER;
	ref: Identifier;
	ref_addr: INTEGER;
	i_val: INTEGER;
	r_val: REAL;
	forMacros: ARRAY MAX_MACRO_FOR OF INTEGER;
	forMacroCount: INTEGER;
	
	PROCEDURE ReadIdent(block: ST.Block; offs, len: INTEGER; VAR ident: Identifier): INTEGER;
	VAR
		j: INTEGER;
		token_id: INTEGER;
		token: CHAR;
	BEGIN 
		j := 0;
		String.Clear(ident);
		REPEAT
			token := block.data[offs + j];
			ident[j] := token;
			token_id := ORD(token);
			INC(j);
		UNTIL (token_id < MARKS) OR ((offs + j) = len);
		RETURN j - 1
	END ReadIdent;
	
	PROCEDURE [oberon-] SearchIdent(dict: Dictionary; count: INTEGER; ref: Identifier; VAR ref_addr: INTEGER): INTEGER;
	VAR 
		j, idx: INTEGER;
	BEGIN
		idx := -1;
		// Up to word count allows redeclaration
		FOR j := 0 TO count DO
			IF ref = dict[j].name THEN
				ref_addr := dict[j].address;
				idx := j;
			END;
		END;
		RETURN idx
	END SearchIdent;
	
BEGIN
	forMacroCount := 0;
	FOR i := 0 TO len - 1 DO
		token := block.data[i];
		token_id := ORD(token);
		String.Clear(ref);
		i_val := 0;
		
		CASE token_id OF
		| MARK_END:
		| MARK_ID_DEF:
			j := i;
			i := i + ReadIdent(block, i + 1, len, m.words[m.wordCount].name);
			m.words[m.wordCount].address := j;
			INC(m.wordCount);
			AddInstruction(m, INST_ID, j, j);
		| MARK_ALIAS_DEF:
			j := i;			
			i := i + ReadIdent(block, i + 1, len, ref);
			IF SearchIdent(m.aliases, m.aliasCount, ref, ref_addr) = -1 THEN
				m.aliases[m.aliasCount].name := ref;
				m.aliases[m.aliasCount].address := j;
				INC(m.aliasCount);
				AddInstruction(m, INST_ALIAS, m.aliasCount, j);
			ELSE
				AddInstruction(m, INST_ERR, ERR.ALIAS_EXISTS, j);
			END;	
		| MARK_ID_END:
			AddInstruction(m, INST_RET, i, i);
		| MARK_ID_AT:
			AddInstruction(m, INST_AT, i, i);
		| MARK_ID_BRK:
			AddInstruction(m, INST_BRK, i, i);
		| MARK_ID_REF:
			j := i;
			i := i + ReadIdent(block, i + 1, len, ref);
			ref_addr := -1;
			SearchIdent(m.words, m.wordCount, ref, ref_addr);
			
			IF ref_addr = -1 THEN // error: not found	
				AddInstruction(m, INST_ERR, ERR.UNKNOWN_REF, j);
			ELSE
				AddInstruction(m, INST_CALL, ref_addr, j);
			END;
		| MARK_ALIAS_WRITE:
			j := i;
			i := i + ReadIdent(block, i + 1, len, ref);
			ref_addr := -1;
			k := SearchIdent(m.aliases, m.aliasCount, ref, ref_addr);
			
			IF ref_addr = -1 THEN 
				AddInstruction(m, INST_ERR, ERR.UNKNOWN_ALIAS, j);
			ELSE
				AddInstruction(m, INST_ALIAS_WRITE, k + 1, j);
			END;
		| MARK_ALIAS_READ:
			j := i;
			i := i + ReadIdent(block, i + 1, len, ref);
			ref_addr := -1;
			k := SearchIdent(m.aliases, m.aliasCount, ref, ref_addr);
			
			IF ref_addr = -1 THEN 
				AddInstruction(m, INST_ERR, ERR.UNKNOWN_ALIAS, j);
			ELSE
				AddInstruction(m, INST_ALIAS_READ, k + 1, j);
			END;
		| MARK_PTR_WRITE:
			AddInstruction(m, INST_PTR_WRITE, i, i);
		| MARK_PTR_READ:
			AddInstruction(m, INST_PTR_READ, i, i);
		| MARK_FFI:
			j := i;
			i := i + ReadIdent(block, i + 1, len, ref);
			ref_addr := -1;
			k := SearchIdent(m.ffi, m.ffiCount, ref, ref_addr);
			IF ref_addr = -1 THEN 
				AddInstruction(m, INST_ERR, ERR.UNKNOWN_FFI, j);
			ELSE
				AddInstruction(m, INST_FFI_CALL, ref_addr, j);
			END;
		| MARK_ID_MACRO:
			j := i;
			i := i + ReadIdent(block, i + 1, len, ref);
			IF ref = "+" THEN
				AddInstruction(m, INST_ADD_INT, j, j);
			ELSIF ref = "=" THEN
				AddInstruction(m, INST_EQUAL, j, j);
			ELSIF ref = "drop" THEN
				AddInstruction(m, INST_DROP, j, j);
			ELSIF ref = "dup" THEN
				AddInstruction(m, INST_DUP, j, j);
			ELSIF ref = "swap" THEN
				AddInstruction(m, INST_SWAP, j, j);
			ELSIF ref = "over" THEN
				AddInstruction(m, INST_OVER, j, j);
			ELSIF ref = "nip" THEN
				AddInstruction(m, INST_NIP, j, j);
			ELSIF ref = "$" THEN
				AddInstruction(m, INST_JUMP, j, j);
			ELSIF ref = "$0" THEN
				AddInstruction(m, INST_JUMP_ZERO, j, j);
			ELSIF ref = "$1" THEN
				AddInstruction(m, INST_JUMP_ONE, j, j);
			ELSIF ref = "ifelse" THEN
				AddInstruction(m, INST_JUMP_COND_IFELSE, j, j);
			ELSIF ref = "if" THEN
				AddInstruction(m, INST_JUMP_COND_IF, j, j);
			ELSIF ref = "for" THEN
				IF forMacroCount < MAX_MACRO_FOR THEN
					forMacros[forMacroCount] := j;
					AddInstruction(m, INST_JUMP_FOR, j, j);
					INC(forMacroCount);
				ELSE
					AddInstruction(m, INST_ERR, ERR.FOR_MAX_NESTED, j);
				END;
			ELSIF ref = "next" THEN
				IF forMacroCount > 0 THEN
					DEC(forMacroCount);
					AddInstruction(m, INST_JUMP_NEXT, forMacros[forMacroCount], j);
				ELSE
					AddInstruction(m, INST_ERR, ERR.FOR_NOT_FOUND, j);
				END;
			ELSIF ref = "break" THEN
				AddInstruction(m, INST_JUMP_BREAK, j, j);
			ELSIF ref = "<R" THEN
				AddInstruction(m, INST_PUSH_R, j, j);
			ELSIF ref = ">R" THEN
				AddInstruction(m, INST_POP_R, j, j);
			ELSIF ref = "<S" THEN
				AddInstruction(m, INST_PUSH_S, j, j);
			ELSIF ref = ">S" THEN
				AddInstruction(m, INST_POP_S, j, j);
			ELSIF ref = "R>S" THEN
				AddInstruction(m, INST_MOV_RS, j, j);
			ELSIF ref = "R<S" THEN
				AddInstruction(m, INST_MOV_SR, j, j);
			ELSIF ref = "RS+" THEN
				AddInstruction(m, INST_ADD_RS, j, j);
			ELSIF ref = "RS/" THEN
				AddInstruction(m, INST_DIV_RS, j, j);
			ELSIF ref = "RS*" THEN
				AddInstruction(m, INST_MULT_RS, j, j);
			ELSIF ref = "<U" THEN
				AddInstruction(m, INST_PUSH_U, j, j);
			ELSIF ref = ">U" THEN
				AddInstruction(m, INST_POP_U, j, j);
			ELSIF ref = "<V" THEN
				AddInstruction(m, INST_PUSH_V, j, j);
			ELSIF ref = ">V" THEN
				AddInstruction(m, INST_POP_V, j, j);
			ELSIF ref = "U>V" THEN
				AddInstruction(m, INST_MOV_UV, j, j);
			ELSIF ref = "U<V" THEN
				AddInstruction(m, INST_MOV_VU, j, j);
			ELSIF ref = "UV+" THEN
				AddInstruction(m, INST_ADD_UV, j, j);
			ELSIF ref = "UV/" THEN
				AddInstruction(m, INST_DIV_UV, j, j);
			ELSIF ref = "UV*" THEN
				AddInstruction(m, INST_MULT_UV, j, j);
			ELSIF ref = "UR+" THEN
				AddInstruction(m, INST_ADD_UR, j, j);
			ELSIF ref = "UR/" THEN
				AddInstruction(m, INST_DIV_UR, j, j);
			ELSIF ref = "UR*" THEN
				AddInstruction(m, INST_MULT_UR, j, j);
			ELSIF ref = "<X" THEN
				AddInstruction(m, INST_PUSH_X, j, j);
			ELSIF ref = ">X" THEN
				AddInstruction(m, INST_POP_X, j, j);
			ELSIF ref = "X<S" THEN
				AddInstruction(m, INST_MOV_XS, j, j);
			ELSIF ref = "X>S" THEN
				AddInstruction(m, INST_MOV_SX, j, j);
			ELSIF ref = "allocb" THEN
				AddInstruction(m, INST_ALLOCB, j, j);
			ELSE
				AddInstruction(m, INST_ERR, ERR.UNKNOWN_MACRO, j);
			END;	
		| MARK_TP_INT:
			j := i;
			i := i + ReadIdent(block, i + 1, len, ref);
			IF String.ToInt(ref, i_val) THEN
				AddInstruction(m, INST_PUSH_INT, i_val, j);
			ELSE // error: invalid number
				AddInstruction(m, INST_ERR, ERR.T_INT_CONV, j);
			END;
		| MARK_TP_REAL:
			j := i;
			i := i + ReadIdent(block, i + 1, len, ref);
			IF String.ToReal(ref, r_val) THEN
				AddInstructionR(m, INST_PUSH_REAL, r_val, j);
			ELSE // error: invalid number
				AddInstruction(m, INST_ERR, ERR.T_REAL_CONV, j);
			END;
		| MARK_TP_ADDR:
			j := i;
			i := i + ReadIdent(block, i + 1, len, ref);
			ref_addr := -1;
			SearchIdent(m.words, m.wordCount, ref, ref_addr);
			
			IF ref_addr = -1 THEN // error: not found	
				AddInstruction(m, INST_ERR, ERR.UNKNOWN_REF, j);
			ELSE
				AddInstruction(m, INST_PUSH_INT, ref_addr, j);
			END;
		ELSE
			// comment
		END;
	END;
END Parse;


PROCEDURE FindNextInstruction(m: Machine; VAR entry: INTEGER): BOOLEAN;
VAR
	instr: Instruction;
	found: BOOLEAN;
BEGIN
	instr := m.code[entry];
	IF instr.code = INST_NOP THEN
		WHILE (entry < MAX_INSTRUCTIONS) & (instr.code = INST_NOP) & (~found) DO
			INC(entry);
			instr := m.code[entry];
			found := instr.code # INST_NOP;
		END;
	END;
	RETURN found
END FindNextInstruction;


PROCEDURE Step*(VAR m: Machine; block: ST.Block; VAR error: Error; VAR break: BOOLEAN);
VAR
	instr: Instruction;
	posNext: BOOLEAN;
	val1, val2: Value;
	ffiFn: Function;
	
	PROCEDURE SetNextPC(VAR m: Machine);
	VAR
		i: INTEGER;
	BEGIN
		INC(m.pc);
		i := m.pc;
		WHILE (i < MAX_INSTRUCTIONS - 1) & (m.code[i].code = INST_NOP) DO		
			INC(i);
		END;
		m.pc := i;
	END;
	
	PROCEDURE SetNextCode(VAR m: Machine; code: INTEGER);
	VAR
		i: INTEGER;
	BEGIN
		INC(m.pc);
		i := m.pc;
		WHILE (i < MAX_INSTRUCTIONS - 1) & (m.code[i].code # INST_BRK) & (m.code[i].code # code) DO		
			INC(i);
		END;
		m.pc := i;
	END;
	
	PROCEDURE JumpCond(VAR m: Machine; cond: INTEGER; VAR error: Error; VAR posNext: BOOLEAN);
	BEGIN
		IF STK.Peek(m.ws, m.R, 0, error, m.pc) THEN
			IF m.R = cond THEN
				IF STK.Peek(m.ws, m.S, -1, error, m.pc) THEN
					m.pc := m.S;
					STK.Pop(m.ws, m.R, error, m.pc);
					STK.Pop(m.ws, m.S, error, m.pc);
				END;
			ELSE
				posNext := TRUE;
			END;
		END;
	END;
	
	PROCEDURE ToValue(VAR value: Value; r: REAL);
	BEGIN
		SYSTEM.MOVE(SYSTEM.ADR(r), SYSTEM.ADR(value.h), 4);
		SYSTEM.MOVE(SYSTEM.ADR(r) + 4, SYSTEM.ADR(value.l), 4);
	END;
	
	PROCEDURE IsEqual(v1, v2: Value; k1, k2: INTEGER): BOOLEAN;
	BEGIN
		RETURN (v1.h = v2.h) & (v1.l = v2.l) & (k1 = k2)
	END;
	
BEGIN
	instr := m.code[m.pc];
	
	CASE instr.code OF
	| INST_ID: m.X := m.pc; posNext := TRUE;
	| INST_ALIAS:
		IF m.ws.top < 0 THEN
			error.code := ERR.ST_INDEX;
			error.pos := m.pc;
			ERR.GetErrorMessage(instr.value.h, error);
		ELSE
			STK.TagStack(m.ws, instr.value.h);
			m.X := m.pc; posNext := TRUE;
		END;
	| INST_ALIAS_WRITE: 
		STK.SetTagValue(m.ws, instr.value.h, m.pc, m.R, error);
		posNext := error.code = ERR.NONE;
	| INST_ALIAS_READ:
		STK.GetTagValue(m.ws, instr.value.h, m.pc, error);
		posNext := error.code = ERR.NONE;
	| INST_CALL:
		IF STK.Push(m.rs, m.pc, error, m.pc) THEN
			m.pc := instr.value.h;
		END;
	| INST_RET:
		IF STK.Pop(m.rs, m.X, error, m.pc) THEN
			m.pc := m.X;
			posNext := TRUE;
		END;
	| INST_AT:
		STK.Push(m.rs, instr.value.h, error, m.pc);
		posNext := TRUE;
	| INST_PUSH_INT:
		STK.Push(m.ws, instr.value.h, error, m.pc);
		posNext := TRUE;
	| INST_PUSH_REAL:
		posNext := STK.PushR(m.ws, instr.value, error, m.pc);
		//posNext := PushAll(m.ws, m.R, m.S, KIND_REAL, 0, error, m.pc);
	| INST_ADD_RS: m.R := m.R + m.S; posNext := TRUE;
	| INST_DIV_RS: m.R := m.R DIV m.S; posNext := TRUE;
	| INST_MULT_RS: m.R := m.R * m.S; posNext := TRUE;
	| INST_ADD_UV: m.U := m.U + m.V; posNext := TRUE;
	| INST_DIV_UV: m.U := m.U / m.V; posNext := TRUE;
	| INST_MULT_UV: m.U := m.U * m.U; posNext := TRUE;
	| INST_ADD_UR: m.U := m.U + FLT(m.R); posNext := TRUE;
	| INST_DIV_UR: m.U := m.U / FLT(m.R); posNext := TRUE;
	| INST_MULT_UR: m.U := m.U * FLT(m.R); posNext := TRUE;
	
	| INST_ADD_INT:
		IF STK.Pop(m.ws, m.R, error, m.pc) & STK.Peek(m.ws, m.S, 0, error, m.pc) THEN
			STK.Poke(m.ws, m.R + m.S, 0, error, m.pc);
			posNext := TRUE;
		END;
	| INST_EQUAL:
		//IF PeekValue(m.ws, 0, val1, m.R, error, m.pc) & PeekValue(m.ws, -1, val2, m.S, error, m.pc) THEN
		IF STK.PopValue(m.ws, 0, val1, m.R, error, m.pc) & STK.PopValue(m.ws, 0, val2, m.S, error, m.pc) THEN
			IF IsEqual(val1, val2, m.R, m.S) THEN
				posNext := STK.Push(m.ws, 1, error, m.pc);
			ELSE
				posNext := STK.Push(m.ws, 0, error, m.pc);
			END;
		END;
	| INST_JUMP:
		IF STK.Pop(m.ws, m.R, error, m.pc) THEN
			m.pc := m.R;
		END;
	| INST_JUMP_ZERO:
		JumpCond(m, 0, error, posNext);
	| INST_JUMP_COND_IFELSE:
		IF STK.Pop(m.ws, m.R, error, m.pc) THEN
			IF m.R = 1 THEN
				IF STK.Pop(m.ws, m.R, error, m.pc) & STK.Pop(m.ws, m.S, error, m.pc) THEN
					STK.Push(m.rs, m.pc, error, m.pc);
					m.pc := m.S;
				END;
			ELSE
				IF STK.Pop(m.ws, m.R, error, m.pc) & STK.Pop(m.ws, m.S, error, m.pc) THEN
					STK.Push(m.rs, m.pc, error, m.pc);
					m.pc := m.R;
				END;
			END;
		END;	
	| INST_JUMP_ONE:
		JumpCond(m, 1, error, posNext);
	| INST_JUMP_COND_IF:
		IF STK.Peek(m.ws, m.R, 0, error, m.pc) THEN
			IF m.R = 1 THEN
				IF STK.Pop(m.ws, m.R, error, m.pc) & STK.Pop(m.ws, m.S, error, m.pc) THEN
					STK.Push(m.rs, m.pc, error, m.pc);
					m.pc := m.S;
				END;
			ELSE
				posNext := STK.Pop(m.ws, m.R, error, m.pc) & STK.Pop(m.ws, m.S, error, m.pc);
			END;
		END;
	| INST_PUSH_R: posNext := STK.Push(m.ws, m.R, error, m.pc);
	| INST_POP_R:  posNext := STK.Pop(m.ws, m.R, error, m.pc);
	| INST_PUSH_S: posNext := STK.Push(m.ws, m.S, error, m.pc);
	| INST_POP_S:  posNext := STK.Pop(m.ws, m.S, error, m.pc);
	| INST_MOV_RS: m.S := m.R; posNext := TRUE;
	| INST_MOV_SR: m.R := m.S; posNext := TRUE;
	| INST_PUSH_U:
		ToValue(val1, m.U);
		posNext := STK.PushR(m.ws, val1, error, m.pc);
	| INST_POP_U:  posNext := STK.PopR(m.ws, m.U, error, m.pc);
	| INST_PUSH_V: 
		ToValue(val1, m.V);
		posNext := STK.PushR(m.ws, val1, error, m.pc);
	| INST_POP_V:  posNext := STK.PopR(m.ws, m.V, error, m.pc);
	| INST_MOV_UV: m.V := m.U; posNext := TRUE;
	| INST_MOV_VU: m.U := m.V; posNext := TRUE;
	| INST_PUSH_X: posNext := STK.Push(m.rs, m.X, error, m.pc);
	| INST_POP_X:  posNext := STK.Pop(m.rs, m.X, error, m.pc);
	| INST_MOV_XS: m.X := m.S; posNext := TRUE;
	| INST_MOV_SX: m.S := m.X; posNext := TRUE;
	| INST_ALLOCB:
		IF STK.Pop(m.ws, m.R, error, m.pc) THEN
			IF m.R > 0 THEN
				m.S := Arena.Alloc(m.heap, m.R);
				posNext := STK.PushAll(m.ws, m.S, m.R, STK.KIND_POINTER, 0, error, m.pc);
			ELSE
				error.code := -1;
				error.pos := instr.address;
				ERR.GetErrorMessage(-1, error); // TODO: mem allocation error
			END;
		END;
	| INST_PTR_WRITE:
		IF STK.CheckKind(m.ws, STK.KIND_POINTER, -2, error, m.pc) THEN
			IF STK.CheckKind(m.ws, STK.KIND_INT, -1, error, m.pc) THEN
				STK.Pop(m.ws, m.R, error, m.pc); // value
				STK.Pop(m.ws, m.S, error, m.pc); // offset
				STK.PeekHL(m.ws, m.X, m.T, 0, error, m.pc); // pointer
				m.T := m.T + m.X;
				m.X := m.X + m.S;
				IF (m.X + 4) > (m.T) THEN // passing pointer size?
					error.code := ERR.INVALID_OFFSET;
					error.pos := instr.address;
					ERR.GetErrorMessage(ERR.INVALID_OFFSET, error); 
				ELSE
					SYSTEM.PUT32(m.X, m.R);
					posNext := TRUE;
				END;
			END;
		END;
	| INST_PTR_READ:
		IF STK.CheckKind(m.ws, STK.KIND_POINTER, -1, error, m.pc) THEN
			IF STK.CheckKind(m.ws, STK.KIND_INT, 0, error, m.pc) THEN
				STK.Pop(m.ws, m.S, error, m.pc); // offset
				STK.PeekHL(m.ws, m.X, m.T, 0, error, m.pc); // pointer
				m.T := m.T + m.X;
				m.X := m.X + m.S;
				IF (m.X + 4) > (m.T) THEN // passing pointer size?
					error.code := ERR.INVALID_OFFSET;
					error.pos := instr.address;
					ERR.GetErrorMessage(ERR.INVALID_OFFSET, error);
				ELSE
					SYSTEM.GET32(m.X, m.R);
					posNext := STK.PushAll(m.ws, m.R, 0, STK.KIND_INT, 0, error, m.pc);
				END;
			END;	
		END;
	| INST_DUP:
		IF STK.PeekHL(m.ws, m.R, m.S, 0, error, m.pc) THEN
			STK.PeekKind(m.ws, 0, m.T, error, m.pc);
			posNext := STK.PushAll(m.ws, m.R, m.S, m.T, 0, error, m.pc);
		END;
	| INST_DROP:
		posNext := STK.Pop(m.ws, m.R, error, m.pc);
	| INST_SWAP:
		posNext := STK.Swap(m.ws, 0, -1, error, m.pc);
	| INST_OVER:
		IF STK.PeekValue(m.ws, -1, val1, m.R, error, m.pc) THEN
			posNext := STK.PushAll(m.ws, val1.h, val1.l, m.R, 0, error, m.pc);
		END;
	| INST_NIP:
		IF STK.Swap(m.ws, 0, -1, error, m.pc) THEN
			posNext := STK.Pop(m.ws, m.R, error, m.pc);
		END;
	| INST_JUMP_FOR:
		IF m.I[m.J] = 0 THEN
			posNext := STK.Pop(m.ws, m.I[m.J], error, m.pc);
			m.I[m.J] := ABS(m.I[m.J]);
		ELSE
			DEC(m.I[m.J]);
			posNext := TRUE;
		END;
		INC(m.J);
	| INST_JUMP_BREAK:
		IF m.J > 0 THEN
			m.I[m.J - 1] := 0;
			SetNextCode(m, INST_JUMP_NEXT);
		ELSE
			error.code := ERR.FOR_BREAK;
			error.pos := instr.address;
			ERR.GetErrorMessage(ERR.FOR_BREAK, error);
		END;
	| INST_JUMP_NEXT:
		DEC(m.J);
		IF m.I[m.J] = 0 THEN
			posNext := TRUE;
		ELSE
			m.pc := instr.value.h;
		END;
	| INST_FFI_CALL:
		IF STK.Pop(m.ws, m.R, error, m.pc) THEN
			m.X := instr.value.h;
			ffiFn := SYSTEM.VAL(Function, m.X);
			m.S := ffiFn(m.ws, m.R);
			posNext := TRUE;
		END;
	| INST_BRK: break := TRUE;
	| INST_ERR:
		error.code := instr.value.h;
		error.pos := instr.address;
		ERR.GetErrorMessage(instr.value.h, error);
	|INST_NOP: posNext := TRUE;
	END;
	
	IF posNext THEN SetNextPC(m) END;

END Step;


PROCEDURE Execute(VAR m: Machine; block: ST.Block; entry: INTEGER; VAR error: Error);
VAR
	break: BOOLEAN;
	len: INTEGER;
BEGIN
	m.pc := entry;
	error.code := ERR.NONE;
	len := MAX_INSTRUCTIONS;
	WHILE (m.pc < len) & (error.code = ERR.NONE) & (~ break) DO
		Step(m, block, error, break);
	END;
END Execute;


PROCEDURE ResetMachine*(VAR m: Machine);
VAR
	i: INTEGER;
BEGIN
	m.pc := 0; m.ic := 0;
	m.wordCount := 0; m.aliasCount := 0;
	m.ffiCount := 0;
	m.R := 0; m.S := 0;
	m.U := 0.0; m.V := 0.0;
	m.X := 0;
	m.T := 0; m.J := 0;
	FOR i := 0 TO MAX_MACRO_FOR - 1 DO m.I[i] := 0 END;
	m.L := FALSE;
	Arena.Wipe(m.heap);
	
	FOR i := 0 TO m.ws.top DO
		m.ws.data[i].value.h := 0;
		m.ws.data[i].value.l := 0;
		m.ws.data[i].alias := 0;
	END;
	m.ws.top := -1;
	
	FOR i := 0 TO m.rs.top DO
		m.rs.data[i].value.h := 0;
		m.rs.data[i].value.l := 0;
	END;
	m.rs.top := -1;
	
	FOR i := 0 TO MAX_INSTRUCTIONS - 1 DO
		m.code[i].code := INST_NOP;
		m.code[i].value.h := 0;
		m.code[i].value.l := 0;
		m.code[i].address := 0;
	END;
	
	FOR i := 0 TO DICT_SIZE - 1 DO
		m.words[i].address := 0;
		m.aliases[i].address := 0;
		m.ffi[i].address := 0;
		String.Clear(m.words[i].name);
		String.Clear(m.aliases[i].name);
		String.Clear(m.ffi[i].name);
	END;
	
	IF onReset # NIL THEN onReset(m) END;
	
END ResetMachine;


PROCEDURE InitMachine*(VAR m: Machine; heapSize: INTEGER; resetFn: ResetFunction);
BEGIN
	m.heap := Arena.Create(heapSize);
	onReset := resetFn;
	ResetMachine(m);
END InitMachine;


PROCEDURE Run*(VAR m: Machine; block: ST.Block; entry: INTEGER; VAR error: Error);
VAR
	len: INTEGER;
BEGIN
	ResetMachine(m);
	error.code := ERR.NONE;
	len := LEN(block.data);
	Parse(m, block, len);
	Execute(m, block, entry, error);
END Run;


PROCEDURE Debug*(VAR m: Machine; block: ST.Block; entry: INTEGER; VAR error: Error; VAR break: BOOLEAN);
VAR
	len: INTEGER;
	instr: Instruction;
BEGIN
	ResetMachine(m);
	error.code := ERR.NONE;
	len := LEN(block.data);
	Parse(m, block, len);
	
	instr := m.code[entry];
	IF instr.code = INST_NOP THEN
		WHILE (entry < MAX_INSTRUCTIONS) & (instr.code = INST_NOP) DO
			INC(entry);
			instr := m.code[entry];
		END;
	END;
	
	m.pc := entry;
END Debug;


PROCEDURE Registry*(VAR m: Machine; fn: Function; name: Identifier);
BEGIN
	COPY(name, m.ffi[m.ffiCount].name);
	m.ffi[m.ffiCount].address := SYSTEM.VAL(INTEGER, fn);
	INC(m.ffiCount);
END Registry;


END VM.
