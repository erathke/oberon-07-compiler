MODULE VM;
IMPORT 
	Out := Out_sys,
	SYSTEM,
	ST IN "./Storage.ob07",
	String IN "./String.ob07";

CONST
	STACK_SIZE = 256;
	DICT_SIZE = 128;
	
	MARK_END = 0; // .
	MARK_ID_DEF = 1; // red
	MARK_TP_INT = 2; // yellow
	MARK_TP_REAL = 3; // cyan
	MARK_ID_REF = 4; // green
	MARK_TP_ADDR = 5; // blue
	MARK_ID_MACRO = 6; // gray
	MARK_ALIAS_DEF = 7; // brass
	MARK_ALIAS_WRITE = 8; // brass
	MARK_ALIAS_READ = 9; // brass
	MARK_ID_BRK = 13; //  = BREAK
	MARK_ID_AT = 14; // orange = AT
	MARK_ID_END = 15; // RET
	
	MARKS = 16;
	
	INST_ERR = -1;
	INST_NOP = 0;
	INST_ID = 1;
	INST_CALL = 2;
	INST_RET = 3;
	INST_PUSH_INT = 4;
	INST_ADD_INT = 5; // TODO: replace with RS+?
	INST_JUMP = 6;
	INST_JUMP_ZERO = 7;
	INST_JUMP_ONE = 8;
	INST_PUSH_R = 10;
	INST_POP_R = 11;
	INST_PUSH_S = 12;
	INST_POP_S = 13;
	INST_ADD_RS = 14;
	INST_DIV_RS = 15;
	INST_MULT_RS = 16;
	INST_MOV_RS = 17;
	INST_MOV_SR = 18;
	INST_PUSH_REAL = 19;
	INST_PUSH_U = 20;
	INST_POP_U = 21;
	INST_PUSH_V = 22;
	INST_POP_V = 23;
	INST_ADD_UV = 24;
	INST_DIV_UV = 25;
	INST_MULT_UV = 26;
	INST_ADD_UR = 27;
	INST_DIV_UR = 28;
	INST_MULT_UR = 29;
	INST_MOV_UV = 30;
	INST_MOV_VU = 31;
	INST_PUSH_X = 32;
	INST_POP_X = 33;
	INST_MOV_XS = 34;
	INST_MOV_SX = 35;
	INST_AT = 36;
	INST_BRK = 37;
	INST_ALIAS = 38;
	INST_ALIAS_WRITE = 39;
	INST_ALIAS_READ = 40;
	
	MAX_INSTRUCTIONS = 4000; // TODO: dynamic instruction array
	
	ERR_NONE* = 0;
	ERR_UNKNOWN_REF = 1;
	ERR_UNKNOWN_MACRO = 2;
	ERR_UNKNOWN_ALIAS = 3;
	ERR_ALIAS_EXISTS = 4;
	ERR_T_INT_CONV = 8;
	ERR_T_REAL_CONV = 9;
	ERR_ST_UNDERFLOW = 10;
	ERR_ST_OVERFLOW = 11;
	ERR_ST_INDEX = 12;
	
TYPE

	Value* = RECORD
		h*, l*, alias*: INTEGER
	END;

	Stack* = RECORD 
		sp*: INTEGER;
		data*: ARRAY STACK_SIZE OF Value
	END;
		
	Identifier* = ARRAY 32 OF CHAR;
	
	Word = RECORD
		name: Identifier;
		address: INTEGER
	END;
	
	Dictionary = ARRAY DICT_SIZE OF Word;

	Instruction = RECORD
		code, value, address*: INTEGER;
		rvalue: REAL
	END;
	
	Error* = RECORD
		code*, pos*: INTEGER;
		msg*: ARRAY 32 OF CHAR
	END;

	Machine* = RECORD
		pc, ic: INTEGER;
		ws*, rs*: Stack;
		// registers
		R, S: INTEGER; // working stack
		U, V: REAL; // working stack
		X: INTEGER; // return stack
		//
		code: ARRAY MAX_INSTRUCTIONS OF Instruction;
		// TODO: refactor dictionary
		words: Dictionary;
		aliases: Dictionary;
		wordCount: INTEGER;
		aliasCount: INTEGER
	END;


PROCEDURE GetPC*(m: Machine): INTEGER;
BEGIN
	RETURN m.pc
END GetPC;


PROCEDURE GetRegisters*(m: Machine; VAR r, s, x: INTEGER; VAR u, v: REAL);
BEGIN
	r := m.R; s := m.S; x := m.X;
	u := m.U; v := m.V;
END GetRegisters;


PROCEDURE GetAlias*(m: Machine; idx: INTEGER; VAR id: Identifier);
BEGIN
	COPY(m.aliases[idx - 1].name, id); 
END GetAlias;


PROCEDURE AddInstruction(VAR m: Machine; code, value, address: INTEGER);
VAR
	instr: Instruction;
BEGIN 
	instr.code := code;
	instr.value := value;
	instr.address := address;
	m.code[address] := instr;
	INC(m.ic);
END;


PROCEDURE AddInstructionR(VAR m: Machine; code: INTEGER; rvalue: REAL; address: INTEGER);
VAR
	instr: Instruction;
BEGIN 
	instr.code := code;
	instr.rvalue := rvalue;
	instr.address := address;
	m.code[address] := instr;
	INC(m.ic);
END;


PROCEDURE PushError(address: INTEGER; VAR error: Error);
BEGIN
	error.code := ERR_ST_OVERFLOW;
	error.pos := address;
	error.msg := "Stack overflow";
END PushError;


PROCEDURE PopError(address: INTEGER; VAR error: Error);
BEGIN
	error.code := ERR_ST_UNDERFLOW;
	error.pos := address;
	error.msg := "Stack underflow";
END PopError;


PROCEDURE PeekError(address: INTEGER; VAR error: Error);
BEGIN
	error.code := ERR_ST_INDEX;
	error.pos := address;
	error.msg := "Invalid stack index";
END PeekError;


PROCEDURE [oberon-] Push(VAR stack: Stack; value: INTEGER; VAR error: Error; address: INTEGER): BOOLEAN;
VAR
	success: BOOLEAN;
BEGIN
	IF stack.sp < STACK_SIZE - 1 THEN
		stack.data[stack.sp].h := value;
		INC(stack.sp);
		success := TRUE;
	ELSE
		PushError(address, error);
		success := FALSE;
	END;
	RETURN success
END Push;


PROCEDURE [oberon-] PushR(VAR stack: Stack; rvalue: REAL; VAR error: Error; address: INTEGER): BOOLEAN;
VAR
	success: BOOLEAN;
BEGIN
	IF stack.sp < STACK_SIZE - 1 THEN
		SYSTEM.MOVE(SYSTEM.ADR(rvalue), SYSTEM.ADR(stack.data[stack.sp]), 8);
		INC(stack.sp);
		success := TRUE;
	ELSE
		PushError(address, error);
		success := FALSE;
	END;
	RETURN success
END PushR;


PROCEDURE [oberon-] Pop(VAR stack: Stack; VAR value: INTEGER; VAR error: Error; address: INTEGER): BOOLEAN;
VAR
	success: BOOLEAN;
	
	PROCEDURE ClearValue(VAR value: Value);
	BEGIN
		value.h := 0; value.l := 0; value.alias := 0;
	END;
	
BEGIN
	IF stack.sp > 0 THEN
		DEC(stack.sp);
		value := stack.data[stack.sp].h;
		ClearValue(stack.data[stack.sp]);
		success := TRUE;
	ELSE
		PopError(address, error);
		success := FALSE;
	END;
	RETURN success
END Pop;


PROCEDURE [oberon-] PopR(VAR stack: Stack; VAR rvalue: REAL; VAR error: Error; address: INTEGER): BOOLEAN;
VAR
	success: BOOLEAN;
BEGIN
	IF stack.sp > 0 THEN
		DEC(stack.sp);
		rvalue := SYSTEM.VAL(stack.data[stack.sp], REAL);
		success := TRUE;
	ELSE
		PopError(address, error);
		success := FALSE;
	END;
	RETURN success
END PopR;


PROCEDURE [oberon-] Peek(VAR stack: Stack; VAR value: INTEGER; ridx: INTEGER; VAR error: Error; address: INTEGER): BOOLEAN;
VAR
	success: BOOLEAN;
	idx: INTEGER;
BEGIN
	IF ridx < 0 THEN
		idx := stack.sp + ridx;
		IF idx >= 0 THEN
			value := stack.data[idx].h;
			success := TRUE;
		ELSE
			PeekError(address, error);
			success := FALSE;
		END;
	ELSE
		idx := ridx;
		IF (idx >= 0) & (idx < stack.sp) THEN
			value := stack.data[idx].h;
			success := TRUE;
		ELSE
			PeekError(address, error);
			success := FALSE;
		END;
	END;
	RETURN success
END Peek;


PROCEDURE [oberon-] PeekR(VAR stack: Stack; VAR rvalue: REAL; ridx: INTEGER; VAR error: Error; address: INTEGER): BOOLEAN;
VAR
	success: BOOLEAN;
	idx: INTEGER;
BEGIN
	IF ridx < 0 THEN
		idx := stack.sp + ridx;
		IF idx >= 0 THEN
			rvalue := SYSTEM.VAL(stack.data[idx], REAL);
			success := TRUE;
		ELSE
			PeekError(address, error);
			success := FALSE;
		END;
	ELSE
		idx := ridx;
		IF (idx >= 0) & (idx < stack.sp) THEN
			rvalue := SYSTEM.VAL(stack.data[idx], REAL);
			success := TRUE;
		ELSE
			PeekError(address, error);
			success := FALSE;
		END;
	END;
	RETURN success
END PeekR;


PROCEDURE Parse(VAR m: Machine; block: ST.Block; len: INTEGER);
VAR
	token: CHAR;
	i, j, k: INTEGER;
	token_id: INTEGER;
	ref: Identifier;
	ref_addr: INTEGER;
	i_val: INTEGER;
	r_val: REAL;
	
	PROCEDURE ReadIdent(block: ST.Block; offs, len: INTEGER; VAR ident: Identifier): INTEGER;
	VAR
		j: INTEGER;
		token_id: INTEGER;
		token: CHAR;
	BEGIN 
		j := 0;
		String.Clear(ident);
		REPEAT
			token := block.data[offs + j];
			ident[j] := token;
			token_id := ORD(token);
			INC(j);
		UNTIL (token_id < MARKS) OR ((offs + j) = len);
		RETURN j - 1
	END ReadIdent;
	
	PROCEDURE [oberon-] SearchIdent(dict: Dictionary; count: INTEGER; ref: Identifier; VAR ref_addr: INTEGER): INTEGER;
	VAR 
		j, idx: INTEGER;
	BEGIN
		idx := -1;
		// Up to word count allows redeclaration
		FOR j := 0 TO count DO
			IF ref = dict[j].name THEN
				ref_addr := dict[j].address;
				idx := j;
			END;
		END;
		RETURN idx
	END SearchIdent;
	
BEGIN
	FOR i := 0 TO len - 1 DO
		token := block.data[i];
		token_id := ORD(token);
		String.Clear(ref);
		i_val := 0;
		
		CASE token_id OF
		| MARK_END:
		| MARK_ID_DEF:
			j := i;
			i := i + ReadIdent(block, i + 1, len, m.words[m.wordCount].name);
			m.words[m.wordCount].address := j;
			INC(m.wordCount);
			AddInstruction(m, INST_ID, j, j);
		| MARK_ALIAS_DEF:
			j := i;			
			i := i + ReadIdent(block, i + 1, len, ref);
			IF SearchIdent(m.aliases, m.aliasCount, ref, ref_addr) = -1 THEN
				m.aliases[m.aliasCount].name := ref;
				m.aliases[m.aliasCount].address := j;
				INC(m.aliasCount);
				AddInstruction(m, INST_ALIAS, m.aliasCount, j);
			ELSE
				AddInstruction(m, INST_ERR, ERR_ALIAS_EXISTS, j);
			END;	
		| MARK_ID_END:
			AddInstruction(m, INST_RET, i, i);
		| MARK_ID_AT:
			AddInstruction(m, INST_AT, i, i);
		| MARK_ID_BRK:
			AddInstruction(m, INST_BRK, i, i);
		| MARK_ID_REF:
			j := i;
			i := i + ReadIdent(block, i + 1, len, ref);
			ref_addr := -1;
			SearchIdent(m.words, m.wordCount, ref, ref_addr);
			
			IF ref_addr = -1 THEN // error: not found	
				AddInstruction(m, INST_ERR, ERR_UNKNOWN_REF, j);
			ELSE
				AddInstruction(m, INST_CALL, ref_addr, j);
			END;
		| MARK_ALIAS_WRITE:
			j := i;
			i := i + ReadIdent(block, i + 1, len, ref);
			ref_addr := -1;
			k := SearchIdent(m.aliases, m.aliasCount, ref, ref_addr);
			
			IF ref_addr = -1 THEN 
				AddInstruction(m, INST_ERR, ERR_UNKNOWN_ALIAS, j);
			ELSE
				AddInstruction(m, INST_ALIAS_WRITE, k + 1, j);
			END;
			
		| MARK_ALIAS_READ:
			j := i;
			i := i + ReadIdent(block, i + 1, len, ref);
			ref_addr := -1;
			k := SearchIdent(m.aliases, m.aliasCount, ref, ref_addr);
			
			IF ref_addr = -1 THEN 
				AddInstruction(m, INST_ERR, ERR_UNKNOWN_ALIAS, j);
			ELSE
				AddInstruction(m, INST_ALIAS_READ, k + 1, j);
			END;
			
		| MARK_ID_MACRO:
			j := i;
			i := i + ReadIdent(block, i + 1, len, ref);
			IF ref = "+" THEN
				AddInstruction(m, INST_ADD_INT, j, j);
			ELSIF ref = "$" THEN
				AddInstruction(m, INST_JUMP, j, j);
			ELSIF ref = "$0" THEN
				AddInstruction(m, INST_JUMP_ZERO, j, j);
			ELSIF ref = "$1" THEN
				AddInstruction(m, INST_JUMP_ONE, j, j);
			ELSIF ref = "R>" THEN
				AddInstruction(m, INST_PUSH_R, j, j);
			ELSIF ref = "R<" THEN
				AddInstruction(m, INST_POP_R, j, j);
			ELSIF ref = "S>" THEN
				AddInstruction(m, INST_PUSH_S, j, j);
			ELSIF ref = "S<" THEN
				AddInstruction(m, INST_POP_S, j, j);
			ELSIF ref = "R>S" THEN
				AddInstruction(m, INST_MOV_RS, j, j);
			ELSIF ref = "R<S" THEN
				AddInstruction(m, INST_MOV_SR, j, j);
			ELSIF ref = "RS+" THEN
				AddInstruction(m, INST_ADD_RS, j, j);
			ELSIF ref = "RS/" THEN
				AddInstruction(m, INST_DIV_RS, j, j);
			ELSIF ref = "RS*" THEN
				AddInstruction(m, INST_MULT_RS, j, j);
			ELSIF ref = "U>" THEN
				AddInstruction(m, INST_PUSH_U, j, j);
			ELSIF ref = "U<" THEN
				AddInstruction(m, INST_POP_U, j, j);
			ELSIF ref = "V>" THEN
				AddInstruction(m, INST_PUSH_V, j, j);
			ELSIF ref = "V<" THEN
				AddInstruction(m, INST_POP_V, j, j);
			ELSIF ref = "U>V" THEN
				AddInstruction(m, INST_MOV_UV, j, j);
			ELSIF ref = "U<V" THEN
				AddInstruction(m, INST_MOV_VU, j, j);
			ELSIF ref = "UV+" THEN
				AddInstruction(m, INST_ADD_UV, j, j);
			ELSIF ref = "UV/" THEN
				AddInstruction(m, INST_DIV_UV, j, j);
			ELSIF ref = "UV*" THEN
				AddInstruction(m, INST_MULT_UV, j, j);
			ELSIF ref = "UR+" THEN
				AddInstruction(m, INST_ADD_UR, j, j);
			ELSIF ref = "UR/" THEN
				AddInstruction(m, INST_DIV_UR, j, j);
			ELSIF ref = "UR*" THEN
				AddInstruction(m, INST_MULT_UR, j, j);
			ELSIF ref = "X>" THEN
				AddInstruction(m, INST_PUSH_X, j, j);
			ELSIF ref = "X<" THEN
				AddInstruction(m, INST_POP_X, j, j);
			ELSIF ref = "X<S" THEN
				AddInstruction(m, INST_MOV_XS, j, j);
			ELSIF ref = "X>S" THEN
				AddInstruction(m, INST_MOV_SX, j, j);
			ELSE
				AddInstruction(m, INST_ERR, ERR_UNKNOWN_MACRO, j);
			END;	
		| MARK_TP_INT:
			j := i;
			i := i + ReadIdent(block, i + 1, len, ref);
			IF String.ToInt(ref, i_val) THEN
				AddInstruction(m, INST_PUSH_INT, i_val, j);
			ELSE // error: invalid number
				AddInstruction(m, INST_ERR, ERR_T_INT_CONV, j);
			END;
		| MARK_TP_REAL:
			j := i;
			i := i + ReadIdent(block, i + 1, len, ref);
			IF String.ToReal(ref, r_val) THEN
				AddInstructionR(m, INST_PUSH_REAL, r_val, j);
			ELSE // error: invalid number
				AddInstruction(m, INST_ERR, ERR_T_REAL_CONV, j);
			END;
		| MARK_TP_ADDR:
			j := i;
			i := i + ReadIdent(block, i + 1, len, ref);
			ref_addr := -1;
			SearchIdent(m.words, m.wordCount, ref, ref_addr);
			
			IF ref_addr = -1 THEN // error: not found	
				AddInstruction(m, INST_ERR, ERR_UNKNOWN_REF, j);
			ELSE
				AddInstruction(m, INST_PUSH_INT, ref_addr, j);
			END;
		ELSE
			// comment
		END;
	END;
END Parse;


PROCEDURE GetErrorMessage(code: INTEGER; VAR error: Error);
BEGIN
	CASE code OF
	| ERR_UNKNOWN_REF:   error.msg := "Unknown reference";
	| ERR_UNKNOWN_MACRO: error.msg := "Unknown macro";
	| ERR_T_INT_CONV:    error.msg := "Invalid integer";
	| ERR_T_REAL_CONV:   error.msg := "Invalid real";
	ELSE
		error.msg := "Unknown error";
		Out.String("error: "); Out.Int(code, 0); Out.Ln;
	END;
END GetErrorMessage;


PROCEDURE Step*(VAR m: Machine; block: ST.Block; VAR error: Error; VAR break: BOOLEAN);
VAR
	
	instr: Instruction;
	posNext: BOOLEAN;
	
	PROCEDURE SetNextPC(VAR m: Machine);
	VAR
		i: INTEGER;
	BEGIN
		INC(m.pc);
		i := m.pc;
		WHILE (i < MAX_INSTRUCTIONS) & (m.code[i].code = INST_NOP) DO		
			INC(i);
		END;
		m.pc := i;
	END;
	
	PROCEDURE TagStack(VAR m: Machine; tagIdx: INTEGER);
	BEGIN
		m.ws.data[m.ws.sp - 1].alias := tagIdx;
	END;
	
	PROCEDURE SetTagValue(VAR m: Machine; tagIdx: INTEGER; VAR error: Error);
	VAR
		i: INTEGER;
		idx: INTEGER;
	BEGIN
		idx := -1;
		FOR i := m.ws.sp TO 0 BY -1 DO
			IF tagIdx = m.ws.data[i].alias THEN
				idx := i;
				i := -1;
			END;
		END;
		IF idx # -1 THEN
			IF Pop(m.ws, m.R, error, m.pc) THEN
				m.ws.data[idx].h := m.R;
			END;
		END;
	END;
	
	PROCEDURE GetTagValue(VAR m: Machine; tagIdx: INTEGER; VAR error: Error);
	VAR
		i: INTEGER;
		idx: INTEGER;
	BEGIN
		idx := -1;
		FOR i := m.ws.sp TO 0 BY -1 DO
			IF tagIdx = m.ws.data[i].alias THEN
				idx := i;
				i := -1;
			END;
		END;
		IF idx # -1 THEN
			Push(m.ws, m.ws.data[idx].h, error, m.pc);
		ELSE
			error.code := ERR_UNKNOWN_ALIAS;
			error.pos := m.pc;
			GetErrorMessage(ERR_UNKNOWN_ALIAS, error);
		END;
	END;
	
BEGIN
	
	instr := m.code[m.pc];
	//Out.String("instr: "); Out.Int(instr.code, 0);  Out.String(" at "); Out.Int(m.pc, 0); Out.Ln;
	
	CASE instr.code OF
	| INST_ID: m.X := m.pc; posNext := TRUE;
	| INST_ALIAS:
		IF m.ws.sp < 1 THEN
			error.code := ERR_ST_INDEX;
			error.pos := m.pc;
			GetErrorMessage(instr.value, error);
		ELSE
			TagStack(m, instr.value);
			m.X := m.pc; posNext := TRUE;
		END;
	| INST_ALIAS_WRITE: 
		SetTagValue(m, instr.value, error);
		posNext := TRUE;
	| INST_ALIAS_READ:
		GetTagValue(m, instr.value, error);
		posNext := TRUE;
	| INST_CALL:
		IF Push(m.rs, m.pc, error, m.pc) THEN
			m.pc := instr.value;
		END;
	| INST_RET:
		IF Pop(m.rs, m.X, error, m.pc) THEN
			m.pc := m.X;
			posNext := TRUE;
		END;
	| INST_AT:
		Push(m.rs, instr.value, error, m.pc);
		posNext := TRUE;

	| INST_PUSH_INT:
		Push(m.ws, instr.value, error, m.pc);
		posNext := TRUE;
		
	| INST_PUSH_REAL:
		PushR(m.ws, instr.rvalue, error, m.pc);
		posNext := TRUE;
	
	| INST_ADD_RS: m.R := m.R + m.S; posNext := TRUE;
	| INST_DIV_RS: m.R := m.R DIV m.S; posNext := TRUE;
	| INST_MULT_RS: m.R := m.R * m.S; posNext := TRUE;
	| INST_ADD_UV: m.U := m.U + m.V; posNext := TRUE;
	| INST_DIV_UV: m.U := m.U / m.V; posNext := TRUE;
	| INST_MULT_UV: m.U := m.U * m.U; posNext := TRUE;
	| INST_ADD_UR: m.U := m.U + FLT(m.R); posNext := TRUE;
	| INST_DIV_UR: m.U := m.U / FLT(m.R); posNext := TRUE;
	| INST_MULT_UR: m.U := m.U * FLT(m.R); posNext := TRUE;
	
	| INST_ADD_INT:
		IF Pop(m.ws, m.R, error, m.pc) & Pop(m.ws, m.S, error, m.pc) THEN
			Push(m.ws, m.R + m.S, error, m.pc);
			posNext := TRUE;
		END;
	| INST_JUMP:
		IF Pop(m.ws, m.R, error, m.pc) THEN
			m.pc := m.R;
		END;
	| INST_JUMP_ZERO:
		IF Peek(m.ws, m.R, -1, error, m.pc) THEN
			IF m.R = 0 THEN
				IF Peek(m.ws, m.S, -2, error, m.pc) THEN
					m.pc := m.S;
					Pop(m.ws, m.R, error, m.pc);
					Pop(m.ws, m.S, error, m.pc);
				END;
			ELSE
				posNext := TRUE;
			END;
		END;
	| INST_JUMP_ONE:
		IF Peek(m.ws, m.R, -1, error, m.pc) THEN
			IF m.R = 1 THEN
				IF Peek(m.ws, m.S, -2, error, m.pc) THEN
					m.pc := m.S;
					Pop(m.ws, m.R, error, m.pc);
					Pop(m.ws, m.S, error, m.pc);
				END;
			ELSE
				posNext := TRUE;
			END;
		END;

	| INST_PUSH_R: Push(m.ws, m.R, error, m.pc); posNext := TRUE;
	| INST_POP_R: Pop(m.ws, m.R, error, m.pc); posNext := TRUE;
	| INST_PUSH_S: Push(m.ws, m.S, error, m.pc); posNext := TRUE;
	| INST_POP_S: Pop(m.ws, m.S, error, m.pc); posNext := TRUE;
	| INST_MOV_RS: m.S := m.R; posNext := TRUE;
	| INST_MOV_SR: m.R := m.S; posNext := TRUE;
	| INST_PUSH_U: PushR(m.ws, m.U, error, m.pc); posNext := TRUE;
	| INST_POP_U: PopR(m.ws, m.U, error, m.pc); posNext := TRUE;
	| INST_PUSH_V: PushR(m.ws, m.V, error, m.pc); posNext := TRUE;
	| INST_POP_V:  PopR(m.ws, m.V, error, m.pc); posNext := TRUE;
	| INST_MOV_UV: m.V := m.U; posNext := TRUE;
	| INST_MOV_VU: m.U := m.V; posNext := TRUE;
	| INST_PUSH_X: Push(m.rs, m.X, error, m.pc); posNext := TRUE;
	| INST_POP_X: Pop(m.rs, m.X, error, m.pc); posNext := TRUE;
	| INST_MOV_XS: m.X := m.S; posNext := TRUE;
	| INST_MOV_SX: m.S := m.X; posNext := TRUE;
	| INST_BRK: break := TRUE;
	| INST_ERR:
		error.code := instr.value;
		error.pos := instr.address;
		GetErrorMessage(instr.value, error);
	|INST_NOP: posNext := TRUE;
	END;
	
	IF posNext THEN SetNextPC(m);END;

END Step;


PROCEDURE Execute(VAR m: Machine; block: ST.Block; entry: INTEGER; VAR error: Error);
VAR
	len, cols: INTEGER;
	break: BOOLEAN;
BEGIN
	cols := block.columns;
	len := entry + (cols - (entry MOD cols));
	m.pc := entry;
	error.code := ERR_NONE;
	WHILE (m.pc < len) & (error.code = ERR_NONE) & (~ break) DO
		Step(m, block, error, break);
	END;
END Execute;


PROCEDURE ResetMachine*(VAR m: Machine);
VAR
	i: INTEGER;
BEGIN
	m.pc := 0; m.ic := 0;
	m.wordCount := 0; m.aliasCount := 0;
	m.R := 0; m.S := 0;
	m.U := 0.0; m.V := 0.0;
	m.X := 0;
	
	FOR i := 0 TO m.ws.sp - 1 DO
		m.ws.data[i].h := 0;
		m.ws.data[i].l := 0;
		m.ws.data[i].alias := 0;
	END;
	m.ws.sp := 0;
	
	FOR i := 0 TO m.rs.sp - 1 DO
		m.rs.data[i].h := 0;
		m.rs.data[i].l := 0;
	END;
	m.rs.sp := 0;
	
	FOR i := 0 TO MAX_INSTRUCTIONS - 1 DO
		m.code[i].code := INST_NOP;
		m.code[i].value := 0;
		m.code[i].rvalue := 0.0;
		m.code[i].address := 0;
	END;
	
	FOR i := 0 TO DICT_SIZE - 1 DO
		m.words[i].address := 0;
		m.aliases[i].address := 0;
		String.Clear(m.words[i].name);
		String.Clear(m.aliases[i].name);
	END;
END ResetMachine;


PROCEDURE Run*(VAR m: Machine; block: ST.Block; entry: INTEGER; VAR error: Error);
VAR
	len: INTEGER;
BEGIN
	ResetMachine(m);
	len := LEN(block.data);
	Parse(m, block, len);
	Execute(m, block, entry, error);
END Run;


PROCEDURE Debug*(VAR m: Machine; block: ST.Block; entry: INTEGER; VAR error: Error; VAR break: BOOLEAN);
VAR
	len: INTEGER;
	instr: Instruction;
BEGIN
	ResetMachine(m);
	error.code := ERR_NONE;
	len := LEN(block.data);
	Parse(m, block, len);
	
	instr := m.code[entry];
	IF instr.code = INST_NOP THEN
		WHILE (entry < MAX_INSTRUCTIONS) & (instr.code = INST_NOP) DO
			INC(entry);
			instr := m.code[entry];
		END;
	END;
	
	m.pc := entry;
END Debug;


END VM.
