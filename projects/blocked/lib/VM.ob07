MODULE VM;
IMPORT 
	Out := Out_sys,
	SYSTEM, Arena, 
	ST IN "./Storage.ob07",
	String IN "./String.ob07";

CONST
	STACK_SIZE = 256;
	DICT_SIZE = 128;
	
	MARK_END = 0; // .
	MARK_ID_DEF = 1; // red
	MARK_TP_INT = 2; // yellow
	MARK_TP_REAL = 3; // cyan
	MARK_ID_REF = 4; // green
	MARK_TP_ADDR = 5; // blue
	MARK_ID_MACRO = 6; // gray
	MARK_ALIAS_DEF = 7; // brass
	MARK_ALIAS_WRITE = 8; // brass
	MARK_ALIAS_READ = 9; // brass
	MARK_PTR_WRITE = 10; // brass
	MARK_PTR_READ = 11; // brass
	
	MARK_ID_BRK = 13; //  = BREAK
	MARK_ID_AT = 14; // orange = AT
	MARK_ID_END = 15; // RET
	
	MARKS = 16;
	
	INST_ERR = -1;
	INST_NOP = 0;
	INST_ID = 1;
	INST_CALL = 2;
	INST_RET = 3;
	INST_PUSH_INT = 4;
	INST_ADD_INT = 5; // TODO: replace with RS+?
	INST_JUMP = 6;
	INST_JUMP_ZERO = 7;
	INST_JUMP_ONE = 8;
	INST_PUSH_R = 10;
	INST_POP_R = 11;
	INST_PUSH_S = 12;
	INST_POP_S = 13;
	INST_ADD_RS = 14;
	INST_DIV_RS = 15;
	INST_MULT_RS = 16;
	INST_MOV_RS = 17;
	INST_MOV_SR = 18;
	INST_PUSH_REAL = 19;
	INST_PUSH_U = 20;
	INST_POP_U = 21;
	INST_PUSH_V = 22;
	INST_POP_V = 23;
	INST_ADD_UV = 24;
	INST_DIV_UV = 25;
	INST_MULT_UV = 26;
	INST_ADD_UR = 27;
	INST_DIV_UR = 28;
	INST_MULT_UR = 29;
	INST_MOV_UV = 30;
	INST_MOV_VU = 31;
	INST_PUSH_X = 32;
	INST_POP_X = 33;
	INST_MOV_XS = 34;
	INST_MOV_SX = 35;
	INST_AT = 36;
	INST_BRK = 37;
	INST_ALIAS = 38;
	INST_ALIAS_WRITE = 39;
	INST_ALIAS_READ = 40;
	INST_ALLOCB = 50;
	INST_ALLOCS = 51; // TODO
	INST_PTR_WRITE = 52;
	INST_PTR_READ = 53;
	INST_JUMP_COND_IF = 54; // TODO
	INST_JUMP_COND_IFELSE = 55;
	INST_DUP = 56;
	INST_DROP = 57;
	INST_SWAP = 58;
	INST_JUMP_FOR = 59;
	INST_JUMP_NEXT = 60;
	INST_JUMP_BREAK = 61;
	INST_EQUAL = 62;
	
	MAX_INSTRUCTIONS = 3960; // TODO: dynamic instruction array
	MAX_MACRO_FOR = 3;
	
	ERR_NONE* = 0;
	ERR_UNKNOWN_REF = 1;
	ERR_UNKNOWN_MACRO = 2;
	ERR_UNKNOWN_ALIAS = 3;
	ERR_ALIAS_EXISTS = 4;
	ERR_T_INT_CONV = 8;
	ERR_T_REAL_CONV = 9;
	ERR_ST_UNDERFLOW = 10;
	ERR_ST_OVERFLOW = 11;
	ERR_ST_INDEX = 12;
	ERR_INVALID_KIND = 13;
	ERR_INVALID_OFFSET = 14;
	ERR_FOR_NOT_FOUND = 15;
	ERR_FOR_MAX_NESTED = 16;
	ERR_FOR_BREAK = 17;
	
	KIND_NONE* = 0;
	KIND_INT* = 1;
	KIND_REAL* = 2;
	KIND_CHAR* = 3;
	KIND_BYTE* = 4;
	KIND_POINTER* = 5;
	
TYPE
	Value* = RECORD
		h*, l*: INTEGER
	END;
	
	Item* = RECORD
		value*: Value;
		alias*: INTEGER;
		kind*: BYTE
	END;

	Stack* = RECORD 
		top: INTEGER;
		data*: ARRAY STACK_SIZE OF Item
	END;
		
	Identifier* = ARRAY 32 OF CHAR;
	
	Word = RECORD
		name: Identifier;
		address: INTEGER
	END;
	
	Dictionary = ARRAY DICT_SIZE OF Word;

	Instruction = RECORD
		code, address: INTEGER;
		value: Value
	END;
	
	Error* = RECORD
		code*, pos*: INTEGER;
		msg*: ARRAY 32 OF CHAR
	END;

	Machine* = RECORD
		pc, ic: INTEGER;
		ws*, rs*: Stack;
		// data registers
		R, S, T: INTEGER; // working stack
		U, V: REAL; // working stack
		X: INTEGER; // return stack
		// control registers
		J: INTEGER;
		I: ARRAY MAX_MACRO_FOR OF INTEGER; // for / next
		// flags
		L: BOOLEAN;
		//
		code: ARRAY MAX_INSTRUCTIONS OF Instruction;
		heap: Arena.Memory;
		// TODO: refactor dictionary
		words: Dictionary;
		aliases: Dictionary;
		wordCount: INTEGER;
		aliasCount: INTEGER
	END;


PROCEDURE GetPC*(m: Machine): INTEGER;
BEGIN
	RETURN m.pc
END GetPC;


PROCEDURE GetRegisters*(m: Machine; VAR r, s, t, x: INTEGER; VAR u, v: REAL);
BEGIN
	r := m.R; s := m.S; t := m.T;
	x := m.X;
	u := m.U; v := m.V;
END GetRegisters;


PROCEDURE GetAlias*(m: Machine; idx: INTEGER; VAR id: Identifier);
BEGIN
	COPY(m.aliases[idx - 1].name, id); 
END GetAlias;


PROCEDURE GetMemoryStats*(m: Machine; VAR size, usage: INTEGER);
BEGIN
	Arena.GetStats(m.heap, size, usage);
END GetMemoryStats;


PROCEDURE IsStackEmpty*(stack: Stack): BOOLEAN;
BEGIN 
	RETURN stack.top < 0
END IsStackEmpty;


PROCEDURE GetStackCount*(stack: Stack; VAR count: INTEGER);
BEGIN 
	count := stack.top;
END GetStackCount;


PROCEDURE GetErrorMessage(code: INTEGER; VAR error: Error);
BEGIN
	CASE code OF
	| ERR_UNKNOWN_REF:    error.msg := "Unknown reference";
	| ERR_UNKNOWN_MACRO:  error.msg := "Unknown macro";
	| ERR_UNKNOWN_ALIAS:  error.msg := "Unknown alias";
	| ERR_ALIAS_EXISTS:   error.msg := "Alias exists";
	| ERR_T_INT_CONV:     error.msg := "Invalid integer";
	| ERR_T_REAL_CONV:    error.msg := "Invalid real";
	| ERR_ST_UNDERFLOW:   error.msg := "Stack underflow";
	| ERR_ST_OVERFLOW:    error.msg := "Stack overflow";
	| ERR_ST_INDEX:       error.msg := "Invalid stack index";
	| ERR_INVALID_KIND:   error.msg := "Invalid kind";
	| ERR_INVALID_OFFSET: error.msg := "Invalid offset";
	| ERR_FOR_NOT_FOUND:  error.msg := "for not found";
	| ERR_FOR_MAX_NESTED: error.msg := "max for nesting: 3";
	| ERR_FOR_BREAK:      error.msg := "not in a loop";
	ELSE
		error.msg := "Unknown error";
		Out.String("error: "); Out.Int(code, 0); Out.Ln;
	END;
END GetErrorMessage;


PROCEDURE AddInstruction(VAR m: Machine; code, ivalue, address: INTEGER);
VAR
	instr: Instruction;
BEGIN 
	instr.code := code;
	instr.address := address;
	instr.value.h := ivalue;
	m.code[address] := instr;
	INC(m.ic);
END;


PROCEDURE AddInstructionR(VAR m: Machine; code: INTEGER; rvalue: REAL; address: INTEGER);
VAR
	instr: Instruction;
BEGIN 
	instr.code := code;
	instr.address := address;
	SYSTEM.MOVE(SYSTEM.ADR(rvalue), SYSTEM.ADR(instr.value.h), 4);
	SYSTEM.MOVE(SYSTEM.ADR(rvalue) + 4, SYSTEM.ADR(instr.value.l), 4);
	m.code[address] := instr;
	INC(m.ic);
END;


PROCEDURE PushError(address: INTEGER; VAR error: Error);
BEGIN
	error.code := ERR_ST_OVERFLOW;
	error.pos := address;
	GetErrorMessage(ERR_ST_OVERFLOW, error);
END PushError;


PROCEDURE PopError(address: INTEGER; VAR error: Error);
BEGIN
	error.code := ERR_ST_UNDERFLOW;
	error.pos := address;
	GetErrorMessage(ERR_ST_UNDERFLOW, error);
END PopError;


PROCEDURE IdxError(address: INTEGER; VAR error: Error);
BEGIN
	error.code := ERR_ST_INDEX;
	error.pos := address;
	GetErrorMessage(ERR_ST_INDEX, error);
END IdxError;


PROCEDURE [oberon-] PushAll(VAR stack: Stack; h, l, kind, alias: INTEGER; VAR error: Error; address: INTEGER): BOOLEAN;
VAR
	success: BOOLEAN;
BEGIN
	IF stack.top + 1 < STACK_SIZE THEN
		INC(stack.top);
		stack.data[stack.top].value.h := h;
		stack.data[stack.top].value.l := l;
		stack.data[stack.top].kind := kind;
		stack.data[stack.top].alias := alias;
		success := TRUE;
	ELSE
		PushError(address, error);
		success := FALSE;
	END;
	RETURN success
END PushAll;


PROCEDURE [oberon-] Push(VAR stack: Stack; value: INTEGER; VAR error: Error; address: INTEGER): BOOLEAN;
	RETURN PushAll(stack, value, 0, KIND_INT, 0, error, address)
END Push;


PROCEDURE [oberon-] PushR(VAR stack: Stack; value: Value; VAR error: Error; address: INTEGER): BOOLEAN;
BEGIN
	RETURN PushAll(stack, value.h, value.l, KIND_REAL, 0, error, address)
END PushR;


PROCEDURE [oberon-] PopAll(VAR stack: Stack; VAR h, l: INTEGER; VAR error: Error; address: INTEGER): BOOLEAN;
VAR
	success: BOOLEAN;
	
	PROCEDURE ClearItem(VAR item: Item);
	BEGIN
		item.value.h := 0;
		item.value.l := 0;
		item.alias := 0;
		item.kind := KIND_NONE;
	END;
	
BEGIN
	IF stack.top >= 0 THEN
		h := stack.data[stack.top].value.h;
		l := stack.data[stack.top].value.l;
		ClearItem(stack.data[stack.top]);
		success := TRUE;
		DEC(stack.top);
	ELSE
		PopError(address, error);
		success := FALSE;
	END;
	RETURN success
END PopAll;


PROCEDURE [oberon-] Pop(VAR stack: Stack; VAR value: INTEGER; VAR error: Error; address: INTEGER): BOOLEAN;
VAR
	l: INTEGER;
BEGIN
	RETURN PopAll(stack, value, l, error, address)
END Pop;


PROCEDURE [oberon-] PopR(VAR stack: Stack; VAR rvalue: REAL; VAR error: Error; address: INTEGER): BOOLEAN;
TYPE 
	V = RECORD h, l: INTEGER END;
VAR
	val: V;
	success: BOOLEAN;
BEGIN
	success := PopAll(stack, val.h, val.l, error, address);
	IF success THEN
		rvalue := SYSTEM.VAL(val, REAL);
	END;
	RETURN success
END PopR;


PROCEDURE [oberon-] Peek(VAR stack: Stack; VAR value: INTEGER; ridx: INTEGER; VAR error: Error; address: INTEGER): BOOLEAN;
VAR
	success: BOOLEAN;
	idx: INTEGER;
BEGIN
	idx := stack.top + ridx;

	IF (idx < 0) OR (idx >= STACK_SIZE) THEN
		IdxError(address, error);
	ELSE
		value := stack.data[idx].value.h;
		success := TRUE;
	END;
		
	RETURN success
END Peek;


PROCEDURE [oberon-] PeekHL(VAR stack: Stack; VAR h, l: INTEGER; ridx: INTEGER; VAR error: Error; address: INTEGER): BOOLEAN;
VAR
	success: BOOLEAN;
	idx: INTEGER;
BEGIN
	idx := stack.top + ridx;
	IF (idx < 0) OR (idx >= STACK_SIZE) THEN
		IdxError(address, error);
	ELSE
		h := stack.data[idx].value.h;
		l := stack.data[idx].value.l;
		success := TRUE;
	END;
	RETURN success
END PeekHL;


PROCEDURE [oberon-] PeekKind(stack: Stack; ridx: INTEGER; VAR kind: INTEGER; VAR error: Error; address: INTEGER): BOOLEAN;
VAR
	success: BOOLEAN;
	idx: INTEGER;
BEGIN
	idx := stack.top + ridx;
	IF (idx < 0) OR (idx >= STACK_SIZE) THEN
		IdxError(address, error);
	ELSE
		kind := stack.data[idx].kind;
		success := TRUE;
	END;
	RETURN success
	
END PeekKind;


PROCEDURE [oberon-] PeekValue(stack: Stack; ridx: INTEGER; VAR value: Value; VAR kind: INTEGER; VAR error: Error; address: INTEGER): BOOLEAN;
VAR
	success: BOOLEAN;
	idx: INTEGER;
BEGIN
	idx := stack.top + ridx;
	IF (idx < 0) OR (idx >= STACK_SIZE) THEN
		IdxError(address, error);
	ELSE
		value := stack.data[idx].value;
		kind := stack.data[idx].kind;
		success := TRUE;
	END;
	RETURN success
	
END PeekValue;

PROCEDURE CheckKind(stack: Stack; kind, ridx: INTEGER; VAR error: Error; address: INTEGER): BOOLEAN;
VAR
	idx: INTEGER;
	match: BOOLEAN;
BEGIN
	idx := stack.top + ridx;
	IF (idx < 0) OR (idx >= STACK_SIZE) THEN
		IdxError(address, error);
	ELSE
		match := stack.data[idx].kind = kind;
		IF ~ match THEN
			error.code := ERR_INVALID_KIND;
			error.pos := address;
			GetErrorMessage(ERR_INVALID_KIND, error);
		END; 
	END;

	RETURN match
END CheckKind;


PROCEDURE [oberon-] PeekR(VAR stack: Stack; VAR rvalue: REAL; ridx: INTEGER; VAR error: Error; address: INTEGER): BOOLEAN;
TYPE 
	V = RECORD h, l: INTEGER END;
VAR
	success: BOOLEAN;
	idx: INTEGER;
	val: V;
BEGIN
	idx := stack.top + ridx;
	IF (idx < 0) OR (idx >= STACK_SIZE) THEN
		IdxError(address, error);
	ELSE
		success := PeekHL(stack, val.h, val.l, ridx, error, address);
		IF success THEN
			rvalue := SYSTEM.VAL(stack.data[idx], REAL);
		END;
	END;
	RETURN success
END PeekR;


PROCEDURE [oberon-] Poke(VAR stack: Stack; value, relidx: INTEGER; VAR error: Error; address: INTEGER): BOOLEAN;
VAR
	success: BOOLEAN;
	idx: INTEGER;
BEGIN
	idx := stack.top + relidx;
	IF (idx < 0) OR (idx >= STACK_SIZE) THEN
		IdxError(address, error);
	ELSE
		stack.data[idx].value.h := value;
		success := TRUE;
	END;
	RETURN success
END Poke;


PROCEDURE Swap(VAR stack: Stack; idx1, idx2: INTEGER; VAR error: Error; address: INTEGER): BOOLEAN;
VAR
	temp: Item;
	success: BOOLEAN;
BEGIN
	IF stack.top >= 1 THEN
		idx1 := stack.top + idx1;
		idx2 := stack.top + idx2;
		temp := stack.data[idx1];
		stack.data[idx1] := stack.data[idx2];
		stack.data[idx2] := temp;
		success := TRUE;
	ELSE
		PopError(address, error);
	END;
	RETURN success
END Swap;


PROCEDURE Parse(VAR m: Machine; block: ST.Block; len: INTEGER);
VAR
	token: CHAR;
	i, j, k: INTEGER;
	token_id: INTEGER;
	ref: Identifier;
	ref_addr: INTEGER;
	i_val: INTEGER;
	r_val: REAL;
	forMacros: ARRAY MAX_MACRO_FOR OF INTEGER;
	forMacroCount: INTEGER;
	
	PROCEDURE ReadIdent(block: ST.Block; offs, len: INTEGER; VAR ident: Identifier): INTEGER;
	VAR
		j: INTEGER;
		token_id: INTEGER;
		token: CHAR;
	BEGIN 
		j := 0;
		String.Clear(ident);
		REPEAT
			token := block.data[offs + j];
			ident[j] := token;
			token_id := ORD(token);
			INC(j);
		UNTIL (token_id < MARKS) OR ((offs + j) = len);
		RETURN j - 1
	END ReadIdent;
	
	PROCEDURE [oberon-] SearchIdent(dict: Dictionary; count: INTEGER; ref: Identifier; VAR ref_addr: INTEGER): INTEGER;
	VAR 
		j, idx: INTEGER;
	BEGIN
		idx := -1;
		// Up to word count allows redeclaration
		FOR j := 0 TO count DO
			IF ref = dict[j].name THEN
				ref_addr := dict[j].address;
				idx := j;
			END;
		END;
		RETURN idx
	END SearchIdent;
	
BEGIN
	forMacroCount := 0;
	FOR i := 0 TO len - 1 DO
		token := block.data[i];
		token_id := ORD(token);
		String.Clear(ref);
		i_val := 0;
		
		CASE token_id OF
		| MARK_END:
		| MARK_ID_DEF:
			j := i;
			i := i + ReadIdent(block, i + 1, len, m.words[m.wordCount].name);
			m.words[m.wordCount].address := j;
			INC(m.wordCount);
			AddInstruction(m, INST_ID, j, j);
		| MARK_ALIAS_DEF:
			j := i;			
			i := i + ReadIdent(block, i + 1, len, ref);
			IF SearchIdent(m.aliases, m.aliasCount, ref, ref_addr) = -1 THEN
				m.aliases[m.aliasCount].name := ref;
				m.aliases[m.aliasCount].address := j;
				INC(m.aliasCount);
				AddInstruction(m, INST_ALIAS, m.aliasCount, j);
			ELSE
				AddInstruction(m, INST_ERR, ERR_ALIAS_EXISTS, j);
			END;	
		| MARK_ID_END:
			AddInstruction(m, INST_RET, i, i);
		| MARK_ID_AT:
			AddInstruction(m, INST_AT, i, i);
		| MARK_ID_BRK:
			AddInstruction(m, INST_BRK, i, i);
		| MARK_ID_REF:
			j := i;
			i := i + ReadIdent(block, i + 1, len, ref);
			ref_addr := -1;
			SearchIdent(m.words, m.wordCount, ref, ref_addr);
			
			IF ref_addr = -1 THEN // error: not found	
				AddInstruction(m, INST_ERR, ERR_UNKNOWN_REF, j);
			ELSE
				AddInstruction(m, INST_CALL, ref_addr, j);
			END;
		| MARK_ALIAS_WRITE:
			j := i;
			i := i + ReadIdent(block, i + 1, len, ref);
			ref_addr := -1;
			k := SearchIdent(m.aliases, m.aliasCount, ref, ref_addr);
			
			IF ref_addr = -1 THEN 
				AddInstruction(m, INST_ERR, ERR_UNKNOWN_ALIAS, j);
			ELSE
				AddInstruction(m, INST_ALIAS_WRITE, k + 1, j);
			END;
			
		| MARK_ALIAS_READ:
			j := i;
			i := i + ReadIdent(block, i + 1, len, ref);
			ref_addr := -1;
			k := SearchIdent(m.aliases, m.aliasCount, ref, ref_addr);
			
			IF ref_addr = -1 THEN 
				AddInstruction(m, INST_ERR, ERR_UNKNOWN_ALIAS, j);
			ELSE
				AddInstruction(m, INST_ALIAS_READ, k + 1, j);
			END;
		| MARK_PTR_WRITE:
			AddInstruction(m, INST_PTR_WRITE, i, i);
		| MARK_PTR_READ:
			AddInstruction(m, INST_PTR_READ, i, i);
			
		| MARK_ID_MACRO:
			j := i;
			i := i + ReadIdent(block, i + 1, len, ref);
			IF ref = "+" THEN
				AddInstruction(m, INST_ADD_INT, j, j);
			ELSIF ref = "=" THEN
				AddInstruction(m, INST_EQUAL, j, j);
			ELSIF ref = "drop" THEN
				AddInstruction(m, INST_DROP, j, j);
			ELSIF ref = "dup" THEN
				AddInstruction(m, INST_DUP, j, j);
			ELSIF ref = "swap" THEN
				AddInstruction(m, INST_SWAP, j, j);
			ELSIF ref = "$" THEN
				AddInstruction(m, INST_JUMP, j, j);
			ELSIF ref = "$0" THEN
				AddInstruction(m, INST_JUMP_ZERO, j, j);
			ELSIF ref = "$1" THEN
				AddInstruction(m, INST_JUMP_ONE, j, j);
			ELSIF ref = "ifelse" THEN
				AddInstruction(m, INST_JUMP_COND_IFELSE, j, j);
			ELSIF ref = "if" THEN
				AddInstruction(m, INST_JUMP_COND_IF, j, j);
			ELSIF ref = "for" THEN
				IF forMacroCount < MAX_MACRO_FOR THEN
					forMacros[forMacroCount] := j;
					AddInstruction(m, INST_JUMP_FOR, j, j);
					INC(forMacroCount);
				ELSE
					AddInstruction(m, INST_ERR, ERR_FOR_MAX_NESTED, j);
				END;
			ELSIF ref = "next" THEN
				IF forMacroCount > 0 THEN
					DEC(forMacroCount);
					AddInstruction(m, INST_JUMP_NEXT, forMacros[forMacroCount], j);
				ELSE
					AddInstruction(m, INST_ERR, ERR_FOR_NOT_FOUND, j);
				END;
			ELSIF ref = "break" THEN
				AddInstruction(m, INST_JUMP_BREAK, j, j);
			ELSIF ref = "R>" THEN
				AddInstruction(m, INST_PUSH_R, j, j);
			ELSIF ref = "R<" THEN
				AddInstruction(m, INST_POP_R, j, j);
			ELSIF ref = "S>" THEN
				AddInstruction(m, INST_PUSH_S, j, j);
			ELSIF ref = "S<" THEN
				AddInstruction(m, INST_POP_S, j, j);
			ELSIF ref = "R>S" THEN
				AddInstruction(m, INST_MOV_RS, j, j);
			ELSIF ref = "R<S" THEN
				AddInstruction(m, INST_MOV_SR, j, j);
			ELSIF ref = "RS+" THEN
				AddInstruction(m, INST_ADD_RS, j, j);
			ELSIF ref = "RS/" THEN
				AddInstruction(m, INST_DIV_RS, j, j);
			ELSIF ref = "RS*" THEN
				AddInstruction(m, INST_MULT_RS, j, j);
			ELSIF ref = "U>" THEN
				AddInstruction(m, INST_PUSH_U, j, j);
			ELSIF ref = "U<" THEN
				AddInstruction(m, INST_POP_U, j, j);
			ELSIF ref = "V>" THEN
				AddInstruction(m, INST_PUSH_V, j, j);
			ELSIF ref = "V<" THEN
				AddInstruction(m, INST_POP_V, j, j);
			ELSIF ref = "U>V" THEN
				AddInstruction(m, INST_MOV_UV, j, j);
			ELSIF ref = "U<V" THEN
				AddInstruction(m, INST_MOV_VU, j, j);
			ELSIF ref = "UV+" THEN
				AddInstruction(m, INST_ADD_UV, j, j);
			ELSIF ref = "UV/" THEN
				AddInstruction(m, INST_DIV_UV, j, j);
			ELSIF ref = "UV*" THEN
				AddInstruction(m, INST_MULT_UV, j, j);
			ELSIF ref = "UR+" THEN
				AddInstruction(m, INST_ADD_UR, j, j);
			ELSIF ref = "UR/" THEN
				AddInstruction(m, INST_DIV_UR, j, j);
			ELSIF ref = "UR*" THEN
				AddInstruction(m, INST_MULT_UR, j, j);
			ELSIF ref = "X>" THEN
				AddInstruction(m, INST_PUSH_X, j, j);
			ELSIF ref = "X<" THEN
				AddInstruction(m, INST_POP_X, j, j);
			ELSIF ref = "X<S" THEN
				AddInstruction(m, INST_MOV_XS, j, j);
			ELSIF ref = "X>S" THEN
				AddInstruction(m, INST_MOV_SX, j, j);
			ELSIF ref = "allocb" THEN
				AddInstruction(m, INST_ALLOCB, j, j);
			ELSE
				AddInstruction(m, INST_ERR, ERR_UNKNOWN_MACRO, j);
			END;	
		| MARK_TP_INT:
			j := i;
			i := i + ReadIdent(block, i + 1, len, ref);
			IF String.ToInt(ref, i_val) THEN
				AddInstruction(m, INST_PUSH_INT, i_val, j);
			ELSE // error: invalid number
				AddInstruction(m, INST_ERR, ERR_T_INT_CONV, j);
			END;
		| MARK_TP_REAL:
			j := i;
			i := i + ReadIdent(block, i + 1, len, ref);
			IF String.ToReal(ref, r_val) THEN
				AddInstructionR(m, INST_PUSH_REAL, r_val, j);
			ELSE // error: invalid number
				AddInstruction(m, INST_ERR, ERR_T_REAL_CONV, j);
			END;
		| MARK_TP_ADDR:
			j := i;
			i := i + ReadIdent(block, i + 1, len, ref);
			ref_addr := -1;
			SearchIdent(m.words, m.wordCount, ref, ref_addr);
			
			IF ref_addr = -1 THEN // error: not found	
				AddInstruction(m, INST_ERR, ERR_UNKNOWN_REF, j);
			ELSE
				AddInstruction(m, INST_PUSH_INT, ref_addr, j);
			END;
		ELSE
			// comment
		END;
	END;
END Parse;


PROCEDURE FindNextInstruction(m: Machine; VAR entry: INTEGER): BOOLEAN;
VAR
	instr: Instruction;
	found: BOOLEAN;
BEGIN
	instr := m.code[entry];
	IF instr.code = INST_NOP THEN
		WHILE (entry < MAX_INSTRUCTIONS) & (instr.code = INST_NOP) & (~found) DO
			INC(entry);
			instr := m.code[entry];
			found := instr.code # INST_NOP;
		END;
	END;
	RETURN found
END FindNextInstruction;


PROCEDURE Step*(VAR m: Machine; block: ST.Block; VAR error: Error; VAR break: BOOLEAN);
VAR
	instr: Instruction;
	posNext: BOOLEAN;
	val1, val2: Value;
	
	PROCEDURE SetNextPC(VAR m: Machine);
	VAR
		i: INTEGER;
	BEGIN
		INC(m.pc);
		i := m.pc;
		WHILE (i < MAX_INSTRUCTIONS - 1) & (m.code[i].code = INST_NOP) DO		
			INC(i);
		END;
		m.pc := i;
	END;
	
	PROCEDURE SetNextCode(VAR m: Machine; code: INTEGER);
	VAR
		i: INTEGER;
	BEGIN
		INC(m.pc);
		i := m.pc;
		WHILE (i < MAX_INSTRUCTIONS - 1) & (m.code[i].code # INST_BRK) & (m.code[i].code # code) DO		
			INC(i);
		END;
		m.pc := i;
	END;
	
	PROCEDURE TagStack(VAR m: Machine; tagIdx: INTEGER);
	BEGIN
		m.ws.data[m.ws.top].alias := tagIdx;
	END;
	
	PROCEDURE SetTagValue(VAR m: Machine; tagIdx: INTEGER; VAR error: Error);
	VAR
		i: INTEGER;
		idx: INTEGER;
	BEGIN
		idx := -1;
		FOR i := m.ws.top TO 0 BY -1 DO
			IF tagIdx = m.ws.data[i].alias THEN
				idx := i;
				i := -1;
			END;
		END;
		IF idx # -1 THEN
			IF Pop(m.ws, m.R, error, m.pc) THEN
				m.ws.data[idx].value.h := m.R;
			END;
		END;
	END;
	
	PROCEDURE GetTagValue(VAR m: Machine; tagIdx: INTEGER; VAR error: Error);
	VAR
		i: INTEGER;
		idx: INTEGER;
		item: Item;
	BEGIN
		idx := -1;
		FOR i := m.ws.top TO 0 BY -1 DO
			IF tagIdx = m.ws.data[i].alias THEN
				idx := i;
				i := -1;
				item := m.ws.data[idx];
			END;
		END;
		IF idx # -1 THEN
			PushAll(m.ws, item.value.h, item.value.l, item.kind, 0, error, m.pc);
		ELSE
			error.code := ERR_UNKNOWN_ALIAS;
			error.pos := m.pc;
			GetErrorMessage(ERR_UNKNOWN_ALIAS, error);
		END;
	END;
	
	PROCEDURE JumpCond(VAR m: Machine; cond: INTEGER; VAR error: Error; VAR posNext: BOOLEAN);
	BEGIN
		IF Peek(m.ws, m.R, 0, error, m.pc) THEN
			IF m.R = cond THEN
				IF Peek(m.ws, m.S, -1, error, m.pc) THEN
					m.pc := m.S;
					Pop(m.ws, m.R, error, m.pc);
					Pop(m.ws, m.S, error, m.pc);
				END;
			ELSE
				posNext := TRUE;
			END;
		END;
	END;
	
	PROCEDURE ToValue(VAR value: Value; r: REAL);
	BEGIN
		SYSTEM.MOVE(SYSTEM.ADR(r), SYSTEM.ADR(value.h), 4);
		SYSTEM.MOVE(SYSTEM.ADR(r) + 4, SYSTEM.ADR(value.l), 4);
	END;
	
	PROCEDURE IsEqual(v1, v2: Value; k1, k2: INTEGER): BOOLEAN;
	BEGIN
		RETURN (v1.h = v2.h) & (v1.l = v2.l) & (k1 = k2)
	END;
	
BEGIN
	instr := m.code[m.pc];
	
	CASE instr.code OF
	| INST_ID: m.X := m.pc; posNext := TRUE;
	| INST_ALIAS:
		IF m.ws.top < 0 THEN
			error.code := ERR_ST_INDEX;
			error.pos := m.pc;
			GetErrorMessage(instr.value.h, error);
		ELSE
			TagStack(m, instr.value.h);
			m.X := m.pc; posNext := TRUE;
		END;
	| INST_ALIAS_WRITE: 
		SetTagValue(m, instr.value.h, error);
		posNext := error.code = ERR_NONE;
	| INST_ALIAS_READ:
		GetTagValue(m, instr.value.h, error);
		posNext := error.code = ERR_NONE;
	| INST_CALL:
		IF Push(m.rs, m.pc, error, m.pc) THEN
			m.pc := instr.value.h;
		END;
	| INST_RET:
		IF Pop(m.rs, m.X, error, m.pc) THEN
			m.pc := m.X;
			posNext := TRUE;
		END;
	| INST_AT:
		Push(m.rs, instr.value.h, error, m.pc);
		posNext := TRUE;
	| INST_PUSH_INT:
		Push(m.ws, instr.value.h, error, m.pc);
		posNext := TRUE;
	| INST_PUSH_REAL:
		posNext := PushR(m.ws, instr.value, error, m.pc);
		//posNext := PushAll(m.ws, m.R, m.S, KIND_REAL, 0, error, m.pc);
	| INST_ADD_RS: m.R := m.R + m.S; posNext := TRUE;
	| INST_DIV_RS: m.R := m.R DIV m.S; posNext := TRUE;
	| INST_MULT_RS: m.R := m.R * m.S; posNext := TRUE;
	| INST_ADD_UV: m.U := m.U + m.V; posNext := TRUE;
	| INST_DIV_UV: m.U := m.U / m.V; posNext := TRUE;
	| INST_MULT_UV: m.U := m.U * m.U; posNext := TRUE;
	| INST_ADD_UR: m.U := m.U + FLT(m.R); posNext := TRUE;
	| INST_DIV_UR: m.U := m.U / FLT(m.R); posNext := TRUE;
	| INST_MULT_UR: m.U := m.U * FLT(m.R); posNext := TRUE;
	
	| INST_ADD_INT:
		IF Pop(m.ws, m.R, error, m.pc) & Peek(m.ws, m.S, 0, error, m.pc) THEN
			Poke(m.ws, m.R + m.S, 0, error, m.pc);
			posNext := TRUE;
		END;
	| INST_EQUAL:
		IF PeekValue(m.ws, 0, val1, m.R, error, m.pc) & PeekValue(m.ws, -1, val2, m.S, error, m.pc) THEN
			IF IsEqual(val1, val2, m.R, m.S) THEN
				posNext := Push(m.ws, 1, error, m.pc);
			ELSE
				posNext := Push(m.ws, 0, error, m.pc);
			END;
		END;
	| INST_JUMP:
		IF Pop(m.ws, m.R, error, m.pc) THEN
			m.pc := m.R;
		END;
	| INST_JUMP_ZERO:
		JumpCond(m, 0, error, posNext);
	| INST_JUMP_COND_IFELSE:
		IF Pop(m.ws, m.R, error, m.pc) THEN
			IF m.R = 1 THEN
				IF Pop(m.ws, m.R, error, m.pc) & Pop(m.ws, m.S, error, m.pc) THEN
					Push(m.rs, m.pc, error, m.pc);
					m.pc := m.S;
				END;
			ELSE
				IF Pop(m.ws, m.R, error, m.pc) & Pop(m.ws, m.S, error, m.pc) THEN
					Push(m.rs, m.pc, error, m.pc);
					m.pc := m.R;
				END;
			END;
		END;	
	| INST_JUMP_ONE:
		JumpCond(m, 1, error, posNext);
	| INST_JUMP_COND_IF:
		IF Peek(m.ws, m.R, 0, error, m.pc) THEN
			IF m.R = 1 THEN
				IF Pop(m.ws, m.R, error, m.pc) & Pop(m.ws, m.S, error, m.pc) THEN
					Push(m.rs, m.pc, error, m.pc);
					m.pc := m.S;
				END;
			ELSE
				posNext := Pop(m.ws, m.R, error, m.pc) & Pop(m.ws, m.S, error, m.pc);
			END;
		END;
	| INST_PUSH_R: posNext := Push(m.ws, m.R, error, m.pc);
	| INST_POP_R:  posNext := Pop(m.ws, m.R, error, m.pc);
	| INST_PUSH_S: posNext := Push(m.ws, m.S, error, m.pc);
	| INST_POP_S:  posNext := Pop(m.ws, m.S, error, m.pc);
	| INST_MOV_RS: m.S := m.R; posNext := TRUE;
	| INST_MOV_SR: m.R := m.S; posNext := TRUE;
	| INST_PUSH_U:
		ToValue(val1, m.U);
		posNext := PushR(m.ws, val1, error, m.pc);
	| INST_POP_U:  posNext := PopR(m.ws, m.U, error, m.pc);
	| INST_PUSH_V: 
		ToValue(val1, m.V);
		posNext := PushR(m.ws, val1, error, m.pc);
	| INST_POP_V:  posNext := PopR(m.ws, m.V, error, m.pc);
	| INST_MOV_UV: m.V := m.U; posNext := TRUE;
	| INST_MOV_VU: m.U := m.V; posNext := TRUE;
	| INST_PUSH_X: posNext := Push(m.rs, m.X, error, m.pc);
	| INST_POP_X:  posNext := Pop(m.rs, m.X, error, m.pc);
	| INST_MOV_XS: m.X := m.S; posNext := TRUE;
	| INST_MOV_SX: m.S := m.X; posNext := TRUE;
	| INST_ALLOCB:
		IF Pop(m.ws, m.R, error, m.pc) THEN
			IF m.R > 0 THEN
				m.S := Arena.Alloc(m.heap, m.R);
				posNext := PushAll(m.ws, m.S, m.R, KIND_POINTER, 0, error, m.pc);
			ELSE
				error.code := -1;
				error.pos := instr.address;
				GetErrorMessage(-1, error); // TODO: mem allocation error
			END;
		END;
	| INST_PTR_WRITE:
		IF CheckKind(m.ws, KIND_POINTER, -2, error, m.pc) THEN
			IF CheckKind(m.ws, KIND_INT, -1, error, m.pc) THEN
				Pop(m.ws, m.R, error, m.pc); // value
				Pop(m.ws, m.S, error, m.pc); // offset
				PeekHL(m.ws, m.X, m.T, 0, error, m.pc); // pointer
				m.T := m.T + m.X;
				m.X := m.X + m.S;
				IF (m.X + 4) > (m.T) THEN // passing pointer size?
					error.code := ERR_INVALID_OFFSET;
					error.pos := instr.address;
					GetErrorMessage(ERR_INVALID_OFFSET, error); 
				ELSE
					SYSTEM.PUT32(m.X, m.R);
					posNext := TRUE;
				END;
			END;
		END;
	| INST_PTR_READ:
		IF CheckKind(m.ws, KIND_POINTER, -1, error, m.pc) THEN
			IF CheckKind(m.ws, KIND_INT, 0, error, m.pc) THEN
				Pop(m.ws, m.S, error, m.pc); // offset
				PeekHL(m.ws, m.X, m.T, 0, error, m.pc); // pointer
				m.T := m.T + m.X;
				m.X := m.X + m.S;
				IF (m.X + 4) > (m.T) THEN // passing pointer size?
					error.code := ERR_INVALID_OFFSET;
					error.pos := instr.address;
					GetErrorMessage(ERR_INVALID_OFFSET, error);
				ELSE
					SYSTEM.GET32(m.X, m.R);
					posNext := PushAll(m.ws, m.R, 0, KIND_INT, 0, error, m.pc);
				END;
			END;	
		END;
	| INST_DUP:
		IF PeekHL(m.ws, m.R, m.S, 0, error, m.pc) THEN
			PeekKind(m.ws, 0, m.T, error, m.pc);
			posNext := PushAll(m.ws, m.R, m.S, m.T, 0, error, m.pc);
		END;
	| INST_DROP:
		posNext := Pop(m.ws, m.R, error, m.pc);
	| INST_SWAP:
		posNext := Swap(m.ws, 0, -1, error, m.pc);
	| INST_JUMP_FOR:
		IF m.I[m.J] = 0 THEN
			posNext := Pop(m.ws, m.I[m.J], error, m.pc);
			m.I[m.J] := ABS(m.I[m.J]);
		ELSE
			DEC(m.I[m.J]);
			posNext := TRUE;
		END;
		INC(m.J);
	| INST_JUMP_BREAK:
		IF m.J > 0 THEN
			m.I[m.J - 1] := 0;
			SetNextCode(m, INST_JUMP_NEXT);
		ELSE
			error.code := ERR_FOR_BREAK;
			error.pos := instr.address;
			GetErrorMessage(ERR_FOR_BREAK, error);
		END;
	| INST_JUMP_NEXT:
		DEC(m.J);
		IF m.I[m.J] = 0 THEN
			posNext := TRUE;
		ELSE
			m.pc := instr.value.h;
		END;
	| INST_BRK: break := TRUE;
	| INST_ERR:
		error.code := instr.value.h;
		error.pos := instr.address;
		GetErrorMessage(instr.value.h, error);
	|INST_NOP: posNext := TRUE;
	END;
	
	IF posNext THEN SetNextPC(m) END;

END Step;


PROCEDURE Execute(VAR m: Machine; block: ST.Block; entry: INTEGER; VAR error: Error);
VAR
	break: BOOLEAN;
	len: INTEGER;
BEGIN
	m.pc := entry;
	error.code := ERR_NONE;
	len := MAX_INSTRUCTIONS;
	WHILE (m.pc < len) & (error.code = ERR_NONE) & (~ break) DO
		Step(m, block, error, break);
	END;
END Execute;


PROCEDURE ResetMachine*(VAR m: Machine);
VAR
	i: INTEGER;
BEGIN
	m.pc := 0; m.ic := 0;
	m.wordCount := 0; m.aliasCount := 0;
	m.R := 0; m.S := 0;
	m.U := 0.0; m.V := 0.0;
	m.X := 0;
	m.T := 0; m.J := 0;
	FOR i := 0 TO MAX_MACRO_FOR - 1 DO m.I[i] := 0 END;
	m.L := FALSE;
	Arena.Wipe(m.heap);
	
	FOR i := 0 TO m.ws.top DO
		m.ws.data[i].value.h := 0;
		m.ws.data[i].value.l := 0;
		m.ws.data[i].alias := 0;
	END;
	m.ws.top := -1;
	
	FOR i := 0 TO m.rs.top DO
		m.rs.data[i].value.h := 0;
		m.rs.data[i].value.l := 0;
	END;
	m.rs.top := -1;
	
	FOR i := 0 TO MAX_INSTRUCTIONS - 1 DO
		m.code[i].code := INST_NOP;
		m.code[i].value.h := 0;
		m.code[i].value.l := 0;
		m.code[i].address := 0;
	END;
	
	FOR i := 0 TO DICT_SIZE - 1 DO
		m.words[i].address := 0;
		m.aliases[i].address := 0;
		String.Clear(m.words[i].name);
		String.Clear(m.aliases[i].name);
	END;
END ResetMachine;


PROCEDURE InitMachine*(VAR m: Machine; heapSize: INTEGER);
BEGIN
	m.heap := Arena.Create(heapSize);
	ResetMachine(m);
END InitMachine;


PROCEDURE Run*(VAR m: Machine; block: ST.Block; entry: INTEGER; VAR error: Error);
VAR
	len: INTEGER;
BEGIN
	ResetMachine(m);
	error.code := ERR_NONE;
	len := LEN(block.data);
	Parse(m, block, len);
	Execute(m, block, entry, error);
END Run;


PROCEDURE Debug*(VAR m: Machine; block: ST.Block; entry: INTEGER; VAR error: Error; VAR break: BOOLEAN);
VAR
	len: INTEGER;
	instr: Instruction;
BEGIN
	ResetMachine(m);
	error.code := ERR_NONE;
	len := LEN(block.data);
	Parse(m, block, len);
	
	instr := m.code[entry];
	IF instr.code = INST_NOP THEN
		WHILE (entry < MAX_INSTRUCTIONS) & (instr.code = INST_NOP) DO
			INC(entry);
			instr := m.code[entry];
		END;
	END;
	
	m.pc := entry;
END Debug;


END VM.
