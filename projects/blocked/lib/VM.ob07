MODULE VM;
IMPORT 
	Out := Out_sys,
	SYSTEM,
	ST IN "./Storage.ob07",
	String IN "./String.ob07";

CONST
	STACK_SIZE = 256;
	DICT_SIZE = 128;
	
	MARK_END = 0; // .
	MARK_ID_DEF = 1; // red
	MARK_TP_INT = 2; // yellow
	MARK_ID_MACRO = 3; // cyan
	MARK_ID_REF = 4; // green
	MARK_TP_ADDR = 5; // blue
	MARK_ID_END = 15; // \
	
	MARKS = 16;
	
	MODE_PARSE = 0;
	MODE_EXEC = 1;
	
	INST_ERR = -1;
	INST_NOP = 0;
	INST_CALL = 1;
	INST_RET = 2;
	INST_PUSH_I = 3;
	INST_ADD_I = 4; // TODO: replace with RS+?
	INST_JUMP = 5;
	INST_JUMP_ZERO = 6;
	INST_JUMP_ONE = 7;
	INST_PUSH_R = 10;
	INST_POP_R = 11;
	INST_PUSH_S = 12;
	INST_POP_S = 13;
	INST_ADD_RS = 14;
	INST_DIV_RS = 15;
	INST_MULT_RS = 16;
	
	MAX_INSTRUCTIONS = 4000; // TODO: dynamic instruction array
	
	ERR_NONE* = 0;
	ERR_UNKNOWN_REF = 1;
	ERR_UNKNOWN_MACRO = 2;
	ERR_T_INT_CONV = 3;
	ERR_ST_UNDERFLOW = 10;
	ERR_ST_OVERFLOW = 11;
	ERR_ST_INDEX = 11;
	
TYPE
	Stack* = RECORD 
		sp*: INTEGER;
		data*: ARRAY STACK_SIZE OF INTEGER
	END;
		
	Identifier = ARRAY 32 OF CHAR;
	
	Word = RECORD
		name: Identifier;
		address: INTEGER
	END;
	
	Dictionary = ARRAY DICT_SIZE OF Word;

	Instruction = RECORD
		code, value, address*: INTEGER
	END;
	
	Error* = RECORD
		code*, pos*: INTEGER;
		msg*: ARRAY 32 OF CHAR
	END;

	Machine* = RECORD
		pc, ic: INTEGER;
		ws*, rs*: Stack;
		R, S: INTEGER; // registers
		code: ARRAY MAX_INSTRUCTIONS OF Instruction;
		// TODO: refactor dictionary
		dict: Dictionary;
		wordCount: INTEGER
	END;


PROCEDURE AddInstruction(VAR m: Machine; code, value, address: INTEGER);
VAR
	instr: Instruction;
BEGIN 
	instr.code := code;
	instr.value := value;
	instr.address := address;
	m.code[address] := instr;
	INC(m.ic);
END;


PROCEDURE PushError(address: INTEGER; VAR error: Error);
BEGIN
	error.code := ERR_ST_OVERFLOW;
	error.pos := address;
	error.msg := "Stack overflow";
END PushError;


PROCEDURE PopError(address: INTEGER; VAR error: Error);
BEGIN
	error.code := ERR_ST_UNDERFLOW;
	error.pos := address;
	error.msg := "Stack underflow";
END PopError;


PROCEDURE PeekError(address: INTEGER; VAR error: Error);
BEGIN
	error.code := ERR_ST_INDEX;
	error.pos := address;
	error.msg := "Invalid stack index";
END PeekError;


PROCEDURE [oberon-] Push(VAR stack: Stack; value: INTEGER; VAR error: Error; address: INTEGER): BOOLEAN;
VAR
	success: BOOLEAN;
BEGIN
	IF stack.sp < STACK_SIZE - 1 THEN
		stack.data[stack.sp] := value;
		INC(stack.sp);
		success := TRUE;
	ELSE
		PushError(address, error);
		success := FALSE;
	END;
	RETURN success
END Push;


PROCEDURE [oberon-] Pop(VAR stack: Stack; VAR value: INTEGER; VAR error: Error; address: INTEGER): BOOLEAN;
VAR
	success: BOOLEAN;
BEGIN
	IF stack.sp > 0 THEN
		DEC(stack.sp);
		value := stack.data[stack.sp];
		success := TRUE;
	ELSE
		PopError(address, error);
		success := FALSE;
	END;
	RETURN success
END Pop;


PROCEDURE [oberon-] Peek(VAR stack: Stack; VAR value: INTEGER; ridx: INTEGER; VAR error: Error; address: INTEGER): BOOLEAN;
VAR
	success: BOOLEAN;
	idx: INTEGER;
BEGIN
	IF ridx < 0 THEN
		idx := stack.sp + ridx;
		IF idx >= 0 THEN
			value := stack.data[idx];
			success := TRUE;
		ELSE
			PeekError(address, error);
			success := FALSE;
		END;
	ELSE
		idx := ridx;
		IF (idx >= 0) & (idx < stack.sp) THEN
			value := stack.data[idx];
			success := TRUE;
		ELSE
			PeekError(address, error);
			success := FALSE;
		END;
	END;
	RETURN success
END Peek;


PROCEDURE Parse(VAR m: Machine; block: ST.Block; len: INTEGER);
VAR
	token: CHAR;
	i: INTEGER;
	token_id: INTEGER;
	ref: Identifier;
	ref_addr: INTEGER;
	i_val: INTEGER;
	
	PROCEDURE ReadIdent(block: ST.Block; offs, len: INTEGER; VAR ident: Identifier): INTEGER;
	VAR
		j: INTEGER;
		token_id: INTEGER;
		token: CHAR;
	BEGIN 
		j := 0;
		String.Clear(ident);
		REPEAT
			token := block.data[offs + j];
			ident[j] := token;
			token_id := ORD(token);
			INC(j);
		UNTIL (token_id < MARKS) OR ((offs + j) = len);
		RETURN j
	END ReadIdent;
	
	PROCEDURE SearchIdent(m: Machine; ref: Identifier; VAR ref_addr: INTEGER);
	VAR 
		j: INTEGER;
	BEGIN
		// Up to word count allows redeclaration
		FOR j := 0 TO m.wordCount DO
			IF ref = m.dict[j].name THEN
				ref_addr := m.dict[j].address;
			END;
		END;
	END SearchIdent;
	
BEGIN
	FOR i := 0 TO len - 1 DO
		token := block.data[i];
		token_id := ORD(token);
		String.Clear(ref);
		i_val := 0;
		
		CASE token_id OF
		| MARK_END:
		| MARK_ID_DEF:
			m.dict[m.wordCount].address := i;
			i := i + ReadIdent(block, i + 1, len, m.dict[m.wordCount].name);
			INC(m.wordCount);
		| MARK_ID_END:
			AddInstruction(m, INST_RET, i, i);
		| MARK_ID_REF:
			i := i + ReadIdent(block, i + 1, len, ref);
			ref_addr := -1;
			SearchIdent(m, ref, ref_addr);
			
			IF ref_addr = -1 THEN // error: not found	
				AddInstruction(m, INST_ERR, ERR_UNKNOWN_REF, i);
			ELSE
				AddInstruction(m, INST_CALL, ref_addr, i);
			END;
		| MARK_ID_MACRO:
			i := i + ReadIdent(block, i + 1, len, ref);
			IF ref = "+" THEN
				AddInstruction(m, INST_ADD_I, i, i);
			ELSIF ref = "$" THEN
				AddInstruction(m, INST_JUMP, i, i);
			ELSIF ref = "$0" THEN
				AddInstruction(m, INST_JUMP_ZERO, i, i);
			ELSIF ref = "$1" THEN
				AddInstruction(m, INST_JUMP_ONE, i, i);
			ELSIF ref = "R<" THEN
				AddInstruction(m, INST_PUSH_R, i, i);
			ELSIF ref = "R>" THEN
				AddInstruction(m, INST_POP_R, i, i);
			ELSIF ref = "S<" THEN
				AddInstruction(m, INST_PUSH_S, i, i);
			ELSIF ref = "S>" THEN
				AddInstruction(m, INST_POP_S, i, i);
			ELSIF ref = "RS+" THEN
				AddInstruction(m, INST_ADD_RS, i, i);
			ELSIF ref = "RS/" THEN
				AddInstruction(m, INST_DIV_RS, i, i);
			ELSIF ref = "RS*" THEN
				AddInstruction(m, INST_MULT_RS, i, i);
			ELSE
				AddInstruction(m, INST_ERR, ERR_UNKNOWN_MACRO, i);
			END;	
		| MARK_TP_INT:
			i := i + ReadIdent(block, i + 1, len, ref);
			IF String.ToInt(ref, i_val) THEN
				AddInstruction(m, INST_PUSH_I, i_val, i);
			ELSE // error: invalid number
				AddInstruction(m, INST_ERR, ERR_T_INT_CONV, i);
			END;
		| MARK_TP_ADDR: 
			i := i + ReadIdent(block, i + 1, len, ref);
			ref_addr := -1;
			SearchIdent(m, ref, ref_addr);
			
			IF ref_addr = -1 THEN // error: not found	
				AddInstruction(m, INST_ERR, ERR_UNKNOWN_REF, i);
			ELSE
				AddInstruction(m, INST_PUSH_I, ref_addr, i);
			END;
		ELSE
			// comment
		END;
	END;
END Parse;


PROCEDURE GetErrorMessage(code: INTEGER; VAR error: Error);
BEGIN
	CASE code OF
	| ERR_UNKNOWN_REF:   error.msg := "Unknown reference";
	| ERR_UNKNOWN_MACRO: error.msg := "Unknown macro";
	| ERR_T_INT_CONV:    error.msg := "Invalid integer";
	END;
END GetErrorMessage;


PROCEDURE Execute(VAR m: Machine; block: ST.Block; entry: INTEGER; VAR error: Error);
VAR
	i, len, cols: INTEGER;
	instr: Instruction;
BEGIN
	cols := block.columns;
	len := entry + (cols - (entry MOD cols));
	i := entry;
	error.code := ERR_NONE;
	
	WHILE (i < len) & (error.code = ERR_NONE) DO
		instr := m.code[i];
		
		IF instr.code # INST_NOP THEN
			m.pc := i;
			CASE instr.code OF
			| INST_CALL:
				IF Push(m.rs, i, error, i) THEN
					i := instr.value;
				END;
			| INST_RET:
				IF Pop(m.rs, m.R, error, i) THEN
					i := m.R;
				END;
			| INST_PUSH_I:
				Push(m.ws, instr.value, error, i);
			
			| INST_ADD_RS: m.R := m.R + m.S;
			| INST_DIV_RS: m.R := m.R DIV m.S;
			| INST_MULT_RS: m.R := m.R * m.S;
			
			| INST_ADD_I:
				IF Pop(m.ws, m.R, error, i) & Pop(m.ws, m.S, error, i) THEN
					Push(m.ws, m.R + m.S, error, i);
				END;
			| INST_JUMP:
				IF Pop(m.ws, m.R, error, i) THEN
					i := m.R;
				END;
			| INST_JUMP_ZERO:
				IF Peek(m.ws, m.R, -1, error, i) THEN
					IF m.R = 0 THEN
						IF Peek(m.ws, m.S, -2, error, i) THEN
							i := m.S;
							Pop(m.ws, m.R, error, i);
							Pop(m.ws, m.S, error, i);
						END;
					END;
				END;
			| INST_JUMP_ONE:
				IF Peek(m.ws, m.R, -1, error, i) THEN
					IF m.R = 1 THEN
						IF Peek(m.ws, m.S, -2, error, i) THEN
							i := m.S;
							Pop(m.ws, m.R, error, i);
							Pop(m.ws, m.S, error, i);
						END;
					END;
				END;
			| INST_PUSH_R: Push(m.ws, m.R, error, i);
			| INST_POP_R: Pop(m.ws, m.R, error, i);
			| INST_PUSH_S: Push(m.ws, m.S, error, i);
			| INST_POP_S: Pop(m.ws, m.S, error, i);
			
			| INST_ERR:
				error.code := instr.value;
				error.pos := instr.address;
				GetErrorMessage(instr.value, error);
			END;
		END;
		INC(i);
	END;
END Execute;


PROCEDURE ResetMachine(VAR m: Machine);
VAR
	i: INTEGER;
BEGIN
	m.pc := 0;
	m.ic := 0;
	m.ws.sp := 0;
	m.rs.sp := 0;
	m.wordCount := 0;
	
	FOR i := 0 TO MAX_INSTRUCTIONS - 1 DO
		m.code[i].code := INST_NOP;
	END;
	
	FOR i := 0 TO DICT_SIZE - 1 DO
		m.dict[i].address := 0;
		String.Clear(m.dict[i].name);
	END;
END ResetMachine;


PROCEDURE Run*(VAR m: Machine; block: ST.Block; entry: INTEGER; VAR error: Error);
VAR
	len: INTEGER;
BEGIN
	ResetMachine(m);
	len := LEN(block.data);
	Parse(m, block, len);
	Execute(m, block, entry, error);
END Run;


END VM.
