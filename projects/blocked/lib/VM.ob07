MODULE VM;
IMPORT 
	Out := Out_sys,
	ST IN "./Storage.ob07",
	String IN "./String.ob07";

CONST
	STACK_SIZE = 256;
	
	MARK_END = 0; // .
	MARK_ID_DEF = 1; // red
	MARK_TP_INT = 2; // yellow
	MARK_ID_MACRO = 3; // cyan
	MARK_ID_REF = 4; // green
	MARK_TP_STR = 5; // blue
	MARK_ID_END = 15; // \
	
	MARKS = 16;
	
	MODE_PARSE = 0;
	MODE_EXEC = 1;
	
	INST_ERR = -1;
	INST_NOP = 0;
	INST_CALL = 1;
	INST_RET = 2;
	INST_PUSH_I = 3;
	INST_ADD_I = 4;
	
	MAX_INSTRUCTIONS = 1024;
	
	ERR_UNKNOWN_REF = 1;
	ERR_UNKNOWN_MACRO = 2;
	
TYPE
	Stack* = RECORD 
		sp*: INTEGER;
		data*: ARRAY STACK_SIZE OF INTEGER
	END;
		
	Identifier = ARRAY 32 OF CHAR;
	
	Word = RECORD
		name: Identifier;
		address: INTEGER
	END;
	
	Dictionary = ARRAY 32 OF Word;

	Instruction = RECORD
		code, value, address: INTEGER
	END;

	Machine* = RECORD
		pc, ic: INTEGER;
		ws*, rs: Stack;
		code: ARRAY MAX_INSTRUCTIONS OF Instruction;
		dict: Dictionary;
		wordCount: INTEGER
	END;


PROCEDURE AddInstruction(VAR m: Machine; code, value, address: INTEGER);
VAR
	instr: Instruction;
BEGIN 
	instr.code := code;
	instr.value := value;
	instr.address := address;
	m.code[address] := instr;
	INC(m.ic);
END;


PROCEDURE Push(VAR stack: Stack; value: INTEGER): BOOLEAN;
VAR
	success: BOOLEAN;
BEGIN
	IF stack.sp < MAX_INSTRUCTIONS - 1 THEN
		stack.data[stack.sp] := value;
		INC(stack.sp);
		success := TRUE;
	ELSE
		Out.String("stack overflow"); Out.Ln;
		success := FALSE;
	END;
	RETURN success
END Push;


PROCEDURE Pop(VAR stack: Stack; VAR value: INTEGER): BOOLEAN;
VAR
	success: BOOLEAN;
BEGIN
	IF stack.sp > 0 THEN
		DEC(stack.sp);
		value := stack.data[stack.sp];
		success := TRUE;
	ELSE
		Out.String("stack underflow"); Out.Ln;
		success := FALSE;
	END;
	RETURN success
END Pop;


PROCEDURE Parse(VAR m: Machine; block: ST.Block; len: INTEGER);
VAR
	token: CHAR;
	i, j: INTEGER;
	token_id: INTEGER;
	ref: Identifier;
	ref_addr: INTEGER;
	i_val: INTEGER;
	
	PROCEDURE ReadIdent(block: ST.Block; offs, len: INTEGER; VAR ident: Identifier): INTEGER;
	VAR
		j: INTEGER;
		token_id: INTEGER;
		token: CHAR;
	BEGIN 
		j := 0;
		String.Clear(ident);
		REPEAT
			token := block.data[offs + j];
			ident[j] := token;
			token_id := ORD(token);
			INC(j);
		UNTIL (token_id < MARKS) OR ((offs + j) = len);
		
		RETURN j
	END ReadIdent;
	
BEGIN
	FOR i := 0 TO len - 1 DO
		token := block.data[i];
		token_id := ORD(token);
		String.Clear(ref);
		i_val := 0;
		
		CASE token_id OF
		| MARK_END:
		| MARK_ID_DEF:
			m.dict[m.wordCount].address := i;
			i := i + ReadIdent(block, i + 1, len, m.dict[m.wordCount].name);
			INC(m.wordCount);
		| MARK_ID_END:
			AddInstruction(m, INST_RET, i, i);
		| MARK_ID_REF:
			i := i + ReadIdent(block, i + 1, len, ref);
			ref_addr := -1;
			
			FOR j := 0 TO m.wordCount DO
				IF ref = m.dict[j].name THEN
					ref_addr := m.dict[j].address;
				END;
			END;
			
			IF ref_addr = -1 THEN // error: not found	
				AddInstruction(m, INST_ERR, ERR_UNKNOWN_REF, i);
			ELSE
				AddInstruction(m, INST_CALL, ref_addr, i);
			END;
		| MARK_ID_MACRO:
			i := i + ReadIdent(block, i + 1, len, ref);
			IF ref = "+" THEN
				AddInstruction(m, INST_ADD_I, i, i);
			ELSE
				Out.String("unknown macro"); Out.Ln;
			END;
			
		| MARK_TP_INT:
			i := i + ReadIdent(block, i + 1, len, ref);
			IF String.ToInt(ref, i_val) THEN
				AddInstruction(m, INST_PUSH_I, i_val, i);
			ELSE // error: invalid number
				AddInstruction(m, INST_ERR, ERR_UNKNOWN_MACRO, i);
			END;
		ELSE
			// comment
		END;
	END;
	//ASSERT(currentWord = -1);
END Parse;


PROCEDURE LogInstructions(VAR m: Machine);
VAR
	i, len: INTEGER;
	instr: Instruction;
BEGIN 
	len := LEN(m.code);
	FOR i := 0 TO len - 1 DO
		instr := m.code[i];
		IF instr.code # INST_NOP THEN
			Out.String("instr: at "); Out.Int(i, 0);
			Out.String(", "); Out.Int(instr.code, 0);
			Out.String(", "); Out.Int(instr.value, 0);
			Out.Ln;
		END;
	END;
END LogInstructions;


PROCEDURE Execute(VAR m: Machine; block: ST.Block; entry: INTEGER; VAR errorAt: INTEGER);
VAR
	i, len, cols: INTEGER;
	instr: Instruction;
	ret: INTEGER;
	i_val1, i_val2: INTEGER;
BEGIN
	cols := block.columns;
	len := entry + (cols - (entry MOD cols));
	Out.String("entry: "); Out.Int(entry, 0); Out.Ln;
	Out.String("len: "); Out.Int(len, 0); Out.Ln;
	
	i := entry;
	
	WHILE i < len DO
		instr := m.code[i];
		IF instr.code # INST_NOP THEN
			CASE instr.code OF
			| INST_CALL:
				Out.String("call: "); Out.Int(i, 0); Out.Ln;
				IF Push(m.rs, i) THEN
					i := instr.value;
				END;
			| INST_RET:
				IF Pop(m.rs, ret) THEN
					Out.String("ret: "); Out.Int(ret, 0); Out.Ln;
					i := ret;
				END;
			| INST_PUSH_I:
				IF Push(m.ws, instr.value) THEN
					Out.String("push_i: "); Out.Int(instr.value, 0); Out.Ln;
				END;
			| INST_ADD_I:
				IF Pop(m.ws, i_val1) & Pop(m.ws, i_val2) THEN
					IF Push(m.ws, i_val1 + i_val2) THEN
						Out.String("add: "); Out.Int(i_val1 + i_val2, 0); Out.Ln;
					END;
				END;
			| INST_ERR: 
				Out.String("error: "); Out.Int(instr.value, 0);
				Out.String(" at: "); Out.Int(instr.address, 0);
				Out.Ln;
				errorAt := instr.address;
				i := len; // stop execution
			ELSE
			END;
		END;
		INC(i);
	END;
END Execute;


PROCEDURE ResetMachine(VAR m: Machine);
BEGIN
	m.pc := 0;
	m.ic := 0;
	m.ws.sp := 0;
	m.rs.sp := 0;
	m.wordCount := 0;
END ResetMachine;


PROCEDURE Run*(VAR m: Machine; block: ST.Block; entry: INTEGER; VAR errorAt: INTEGER);
VAR
	len: INTEGER;
BEGIN
	len := LEN(block.data);
	Parse(m, block, len);
	
	Out.Ln;
	Out.String("--------------------------"); Out.Ln;
	ResetMachine(m);
	Execute(m, block, entry, errorAt);
	Out.String("end of execution"); Out.Ln;
	Out.String("--------------------------"); Out.Ln;
	
END Run;

END VM.
