MODULE ProdCons;
IMPORT CR := Coroutines, Out := Out_sys;

TYPE 
	Data = POINTER TO RECORD (CR.Userdata)
		buffer: ARRAY 32 OF CHAR
	END;

VAR
	prod: CR.Context;
	data: Data;


PROCEDURE Send(ctx: CR.Context; value: CHAR);
BEGIN 
	CR.Yield(ctx, ORD(value));
END Send;


PROCEDURE Receive(ctx: CR.Context): CHAR;
VAR
	r: INTEGER;
BEGIN
	r := CR.Resume(ctx, 22);
	RETURN CHR(r)
END Receive;


PROCEDURE Producer(ctx: CR.Context; r: INTEGER): INTEGER;
CONST 
	DATA_SIZE = 26;
VAR
	data: ARRAY DATA_SIZE OF CHAR;
	i: INTEGER;
	ch: CHAR;
BEGIN
	data := "abcdefghijklmnopqrstuvxyz";

	WHILE TRUE DO
		ch := data[i];
		//ASSERT(ch # 'k');
		Send(ctx, ch);
		INC(i);
	END;

	RETURN 0
END Producer;


PROCEDURE Consumer(prod: CR.Context);
VAR
	ch: CHAR;
	data: Data;
	i: INTEGER;
BEGIN
	ch := 1X;
	data := prod.user(Data);
	REPEAT
		ch := Receive(prod);
		data.buffer[i] := ch;
		INC(i);
	UNTIL ch = 0X;
END Consumer;


BEGIN
	NEW(data);
	prod := CR.Create(Producer, data);
	Consumer(prod);
	
	Out.Ln;
	IF prod.errorCode = 0 THEN
		ASSERT(CR.Status(prod) = CR.SUSPENDED);
		Out.String("success: "); Out.String(data.buffer); Out.Ln;
	ELSE
		ASSERT(CR.Status(prod) = CR.DEAD);
		Out.String("error: "); Out.String(data.buffer); Out.Ln;
	END;
END ProdCons.
