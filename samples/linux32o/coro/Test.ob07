MODULE Test;
IMPORT CR := Coroutines, Out := Out_sys;

TYPE
	Data = POINTER TO RECORD(CR.Userdata) r: INTEGER END; 

VAR
	c1: CR.Context;
	data: Data;
	status : INTEGER;


PROCEDURE Calc(ctx: CR.Context);
VAR
	ud: Data;
BEGIN
	ud := ctx.user(Data);
	INC(ud.r);
	Out.String("calculating... "); Out.Int(ud.r, 0); Out.Ln;
	CR.Yield(ctx);
	//ASSERT(FALSE);
	
	INC(ud.r);
	Out.String("still calculating... "); Out.Int(ud.r, 0); Out.Ln;
	CR.Yield(ctx);
	
	INC(ud.r);
	Out.String("done."); Out.Ln;
END Calc;


BEGIN
	//ASSERT(FALSE);
	NEW(data);
	data.r := 0;
	c1 := CR.Create(Calc, data);	ASSERT(status = CR.IDLE);
	status := CR.Resume(c1);		ASSERT(status = CR.SUSPENDED);
	status := CR.Resume(c1);		ASSERT(status = CR.SUSPENDED);
	status := CR.Resume(c1);		ASSERT(status = CR.DEAD);
	
	ASSERT(data.r = 3);
	Out.String("result: "); Out.Int(data.r, 0); Out.Ln;
END Test.
