MODULE Pcall;
IMPORT SYSTEM, 
	Out := Out_sys,
	RTL := RTL_sys, 
	TR := Traps,
	Lua IN "./Lua.ob07";

CONST
	ERR_LOAD = 100;
	ERR_FUNC = 101;

VAR
	L: Lua.State;
	script: ARRAY 32 OF CHAR;
	top: INTEGER;
	trap: TR.Trap;


PROCEDURE [ccall] ErrorHandler(L: Lua.State): INTEGER;
VAR
	err: INTEGER;
	isNum: BOOLEAN;
BEGIN
	err := Lua.tointegerx(L, 1, isNum);
	IF isNum THEN
		RAISE(err)
	END;
	RETURN 0
END ErrorHandler;


PROCEDURE CloseTrap(code: INTEGER; ctx: TR.Context);
BEGIN
	Out.String("state closed."); Out.Ln;
	Lua.close(L);
	RTL._exit(code)
END CloseTrap;


BEGIN
	script := "pcall.lua";
	L := Lua.newstate();
	Lua.openlibs(L);
	
	trap := TR.NewTrap(0, CloseTrap);
	RTL.SetTrap(trap);
	
	IF Lua.dofile(L, script) # Lua.LUA_OK THEN
		RAISE(ERR_LOAD);
	END;
	
	Lua.pushcclosure(L, ErrorHandler, 0);
	top := Lua.gettop(L);
	
	IF Lua.getglobal(L, "doit") = Lua.LUA_TFUNCTION THEN
		Lua.pcall(L, 0, 0, top);
	ELSE
		RAISE(ERR_FUNC);
	END;
	
	Lua.close(L);
	Out.String("program end."); Out.Ln;
END Pcall.
