MODULE MURL;
IMPORT SYSTEM, MUI IN "MicroUI.ob07", RL IN "./Raylib.ob07";

CONST
	NULL = 0;

TYPE
	ADDRESS = INTEGER;


PROCEDURE [extern, "murl_setup_font_ex"] _SetupFontEx(ctx: MUI.Context; font: ADDRESS);
PROCEDURE [extern, "murl_handle_input"] HandleInput*(ctx: MUI.Context);
PROCEDURE [extern, "murl_render"] Render*(ctx: MUI.Context);


PROCEDURE SetupFontEx*(ctx: MUI.Context; font: RL.Font);
BEGIN 
	_SetupFontEx(ctx, SYSTEM.ADR(font));
END SetupFontEx;


PROCEDURE SetupFont*(ctx: MUI.Context);
BEGIN
	_SetupFontEx(ctx, NULL);
END SetupFont;


END MURL.
