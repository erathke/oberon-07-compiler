MODULE AmigaBall;
IMPORT SYSTEM, 
	Out := Out_sys, 
	Files IN "./lib/Files.ob07",
	RL IN "./lib/Raylib.ob07", 
	Wren IN "./lib/Wren.ob07";


CONST
	NULL = 0;
	MAIN_MODULE = "main";
	SPRITE_WIDTH = 64;
	SPRITE_HEIGHT = 64;


VAR
	bgColor, fgColor: RL.Color;
	windowWidth, windowHeight: INTEGER;
	windowIcon: RL.Image;
	boingSound: RL.Sound;


PROCEDURE GetStringFromPtr(textPtr: Wren.CString; VAR text: ARRAY OF CHAR);
VAR
	i: INTEGER;
	c: CHAR;
BEGIN
	REPEAT
		SYSTEM.GET(textPtr + i, c);
		text[i] := c;
		INC(i);
	UNTIL c = 0X;
END GetStringFromPtr;


PROCEDURE [ccall] WriteFn(vm: Wren.VM; textPtr: Wren.CString);
VAR
	text: ARRAY 128 OF CHAR;
BEGIN
	GetStringFromPtr(textPtr, text);
	Out.String(text);
END WriteFn;


PROCEDURE [ccall] ErrorFn(vm: Wren.VM; errType: BYTE; modNamePtr: Wren.CString; 
	line: INTEGER; msgPtr: Wren.CString);
VAR
	msg: ARRAY 128 OF CHAR;
	modName: ARRAY 32 OF CHAR;
BEGIN
	GetStringFromPtr(msgPtr, msg);
	GetStringFromPtr(modNamePtr, modName);
	
	Out.String(modName); Out.String(": "); Out.Int(line, 0); Out.Ln;
	Out.String(msg); Out.Ln;

END ErrorFn;


PROCEDURE [ccall] InitWindow(vm: Wren.VM); 

VAR
	title: ARRAY 128 OF CHAR;
	titlePtr: INTEGER;
	
BEGIN
	Wren.EnsureSlots(vm, 3);
	
	windowWidth := FLOOR(Wren.GetSlotDouble(vm, 1));
	windowHeight := FLOOR(Wren.GetSlotDouble(vm, 2));
	titlePtr := Wren.GetSlotString(vm, 3);
	GetStringFromPtr(titlePtr, title);
	
	RL.InitWindow(windowWidth, windowHeight, title);
END InitWindow;


PROCEDURE [ccall] LoadTexture(vm: Wren.VM); 
TYPE
	TexturePtr = POINTER TO RL.Texture2D;
VAR
	path: ARRAY 128 OF CHAR;
	pathPtr, texturePtr: INTEGER;
	textureSize: INTEGER;
	texture: TexturePtr;
BEGIN
	Wren.EnsureSlots(vm, 1);
	pathPtr := Wren.GetSlotString(vm, 1);
	GetStringFromPtr(pathPtr, path);
	
	textureSize := SYSTEM.SIZE(RL.Texture2D);
	texturePtr := Wren.SetSlotNewForeign(vm, 0, 0, textureSize);
	texture := SYSTEM.VAL(texturePtr, TexturePtr);
	RL.LoadTexture(path, texture^);
END LoadTexture;


PROCEDURE [ccall] DrawScene(vm: Wren.VM);
TYPE
	TexturePtr = POINTER TO RL.Texture2D;
VAR
	texturePtr: INTEGER;
	texture: TexturePtr;
	sprite: INTEGER;
	rect: RL.Rectangle;
	pos: RL.Vector2;
	shadowColor: RL.Color;
	shadowRadius: INTEGER;
	shadowRect: RL.Rectangle;
	
	
	PROCEDURE DrawBG();
	VAR
		lineColor: RL.Color;
		i: INTEGER;
		r1: RL.Rectangle;
	BEGIN 
		RL.IntToColor(0AA00AAFFH, lineColor);
		
		r1.x := windowWidth DIV 12;
		r1.width := windowWidth - (r1.x * 2);
		r1.y := windowHeight DIV 9;
		FOR i := 1 TO 7 DO	
			r1.height := (r1.y * i);
			RL.DrawRectangleLines(r1.x, r1.y, r1.width, r1.height, lineColor);
			RL.DrawRectangleLines(r1.x + 1, r1.y + 1, r1.width, r1.height, lineColor);
		END;
		
		FOR i := 1 TO 9 DO	
			r1.width := (r1.x * i);
			RL.DrawRectangleLines(r1.x, r1.y, r1.width, r1.height, lineColor);
			RL.DrawRectangleLines(r1.x + 1, r1.y + 1, r1.width, r1.height, lineColor);
		END;
		
	END DrawBG;
	
BEGIN
	Wren.EnsureSlots(vm, 6);
	
	texturePtr := Wren.GetSlotForeign(vm, 1, 0);
	sprite := FLOOR(Wren.GetSlotDouble(vm, 2));
	
	pos.x := FLOOR(Wren.GetSlotDouble(vm, 3));
	pos.y := FLOOR(Wren.GetSlotDouble(vm, 4));
	
	rect.width := FLOOR(Wren.GetSlotDouble(vm, 5));
	rect.height := FLOOR(Wren.GetSlotDouble(vm, 6));
	rect.x := rect.width * sprite;
	rect.y := 0;
	
	texture := SYSTEM.VAL(texturePtr, TexturePtr);
	
	DrawBG();
	
	shadowRect.x := pos.x + (rect.width DIV 2) + 16;
	shadowRect.y := pos.y + (rect.height DIV 2);
	shadowRadius := rect.width DIV 2;
	RL.IntToColor(000000033H, shadowColor);
	RL.DrawCircle(shadowRect.x, shadowRect.y, FLT(shadowRadius + 2), shadowColor);
	
	RL.DrawTextureRec(texture^, rect, pos, fgColor);
	
END DrawScene;


PROCEDURE [ccall] BallBoing(vm: Wren.VM);
BEGIN
	IF RL.IsSoundPlaying(boingSound) THEN
		RL.StopSound(boingSound);
	END;
	RL.PlaySound(boingSound);
END BallBoing;


PROCEDURE [ccall] BindForeignMethod(vm: Wren.VM; modNamePtr, 
	classNamePtr: Wren.CString; isStatic: BOOLEAN; signaturePtr: Wren.CString): Wren.ForeignMethod;
CONST
	ERR_INVALID_METHOD = 100;
VAR
	modName, className: ARRAY 32 OF CHAR;
	signature: ARRAY 64 OF CHAR;
	method: Wren.ForeignMethod;
BEGIN

	GetStringFromPtr(modNamePtr, modName);
	GetStringFromPtr(classNamePtr, className);
	GetStringFromPtr(signaturePtr, signature);
	
	IF (className = "Texture") & (signature = "load(_)") THEN
		method := LoadTexture;
	ELSIF (className = "App") & (signature = "draw(_,_,_,_,_,_)") THEN
		method := DrawScene;
	ELSIF (className = "App") & (signature = "initWindow(_,_,_)") THEN
		method := InitWindow;
	ELSIF (className = "Ball") & (signature = "boing()") THEN
		method := BallBoing;
	END;
	
	IF method = NIL THEN RAISE(ERR_INVALID_METHOD) END;
	
	RETURN method
END BindForeignMethod;


PROCEDURE main(scriptName: ARRAY OF CHAR);
CONST
	FILE_SIZE = 4096;
VAR
	fontSize: INTEGER;
	vm: Wren.VM;
	config: Wren.Configuration;
	result: INTEGER;
	script: ARRAY FILE_SIZE OF CHAR;
	scriptFile: Files.File;
	scriptSize: INTEGER;
	initClass, updateClass, viewClass: Wren.Handle;
	initHandle, updateHandle, viewHandle: Wren.Handle;
	
	
	PROCEDURE [oberon-] Init(vm: Wren.VM; class, init: Wren.Handle): Wren.InterpretResult;
	BEGIN
		Wren.EnsureSlots(vm, 1);
		Wren.SetSlotHandle(vm, 0, class);
		RETURN Wren.Call(vm, init)
	END Init;
	
	
	PROCEDURE [oberon-] Update(vm: Wren.VM; class, update: Wren.Handle; elapsedTime: REAL): Wren.InterpretResult;
	BEGIN
		Wren.EnsureSlots(vm, 2);
		Wren.SetSlotHandle(vm, 0, class);
		Wren.SetSlotDouble(vm, 1, elapsedTime);
		RETURN Wren.Call(vm, update)
	END Update;
	
	
	PROCEDURE [oberon-] View(vm: Wren.VM; class, view: Wren.Handle): Wren.InterpretResult;
	BEGIN
		Wren.EnsureSlots(vm, 1);
		Wren.SetSlotHandle(vm, 0, class);
		RETURN Wren.Call(vm, view)
	END View;
	
	
	PROCEDURE MakeCallHandle(VAR vm: Wren.VM; methodName: ARRAY OF CHAR; arity: INTEGER; VAR handle: Wren.Handle);
	VAR
		signature: ARRAY 128 OF CHAR;
		i, len: INTEGER;
	BEGIN
		COPY(methodName, signature);
		len := LENGTH(signature);
		signature[len] := "(";
		FOR i := 1 TO arity DO
			INC(len);
			signature[len] := "_";
			IF i < arity THEN
				INC(len);
				signature[len] := ",";
			END;
		END;
		INC(len);
		signature[len] := ")";
		handle := Wren.MakeCallHandle(vm, signature);
	END MakeCallHandle;
	
	
	PROCEDURE MakeVarHandle(VAR vm: Wren.VM; moduleName, varName: ARRAY OF CHAR; VAR handle: Wren.Handle);
	BEGIN
		Wren.EnsureSlots(vm, 1);
		Wren.GetVariable(vm, moduleName, varName, 0);
		handle := Wren.GetSlotHandle(vm, 0);
	END MakeVarHandle;
	
	
BEGIN
	// Creating vm
	Wren.InitConfiguration(config);
	config.writeFn := WriteFn;
	config.errorFn := ErrorFn;
	config.bindForeignMethodFn := BindForeignMethod;
	vm := Wren.NewVM(config);
	ASSERT(vm # NULL);
	
	// Loading file
	scriptFile := Files.Open(scriptName, Files.OPEN_R);
	ASSERT(scriptFile # NULL);
	scriptSize := Files.Read(scriptFile, script, FILE_SIZE);
	Files.Close(scriptFile);
	
	// Loading script
	result := Wren.Interpret(vm, MAIN_MODULE, script);
	IF result # Wren.RESULT_SUCCESS THEN
		Wren.FreeVM(vm);
		RAISE(result);
	END;
	
	// Loading handlers
	MakeVarHandle(vm, MAIN_MODULE, "init", initClass);
	ASSERT(initClass # NULL);
	MakeCallHandle(vm, "call", 0, initHandle);
	ASSERT(initHandle # NULL);
	
	MakeVarHandle(vm, MAIN_MODULE, "update", updateClass);
	ASSERT(updateClass # NULL);
	MakeCallHandle(vm, "call", 1, updateHandle);
	ASSERT(updateHandle # NULL);
	
	MakeVarHandle(vm, MAIN_MODULE, "view", viewClass);
	ASSERT(viewClass # NULL);
	MakeCallHandle(vm, "call", 0, viewHandle);
	ASSERT(viewHandle # NULL);
	
	// Raylib initialization
	fgColor := RL.WHITE;
	RL.IntToColor(0AAAAAAFFH, bgColor);
	fontSize := 16;
	RL.SetTargetFPS(60);
	
	// Initializing app
	Init(vm, initClass, initHandle);
	RL.LoadImage("assets/icon.png", windowIcon);
	RL.SetWindowIcon(windowIcon);
	
	RL.InitAudioDevice();
	RL.LoadSound("assets/boing.mp3", boingSound);
	
	// Main loop
	WHILE ~ RL.WindowShouldClose() DO
		Update(vm, updateClass, updateHandle, RL.GetFrameTime());
		RL.BeginDrawing();
			RL.ClearBackground(bgColor);
			View(vm, viewClass, initHandle);
		RL.EndDrawing();
	END;
	
	// Cleaning up
	RL.UnloadImage(windowIcon);
	RL.CloseAudioDevice();
	RL.CloseWindow();
	Wren.FreeVM(vm);
	
END main;


BEGIN
	main("amiga.wren")
END AmigaBall.
