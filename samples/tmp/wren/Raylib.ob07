MODULE Raylib;
IMPORT SYSTEM, Out := Out_sys;

CONST
	
	WHITE* = 0FFFFFFFFH;
	YELLOW* = 0FFFF00FFH;
	BLUE* =   0000FFFFH;
	RED* =   0FF0000FFH;
	
	MOUSE_BUTTON_LEFT* = 0;
	MOUSE_BUTTON_RIGHT* = 1;
	MOUSE_BUTTON_MIDDLE* = 2;
	
	NULL = 0;
TYPE
	
	ADDRESS = INTEGER;
	
	Vector2* = RECORD
		x*, y*: INTEGER
	END;
	
	Color* = RECORD
		r*, g*, b*, a*: BYTE
	END;

	Image* = RECORD
		data: ADDRESS;             // Image raw data
		width: INTEGER;              // Image base width
		height: INTEGER;             // Image base height
		mipmaps: INTEGER;            // Mipmap levels, 1 by default
		format: INTEGER             // Data format (PixelFormat type)
	END;
	
	Texture2D* = RECORD
		id: ADDRESS;
		width*, height: INTEGER;
		mipmaps: INTEGER;
		format: INTEGER
	END;
	
	Rectangle* = RECORD
		x*, y*, width*, height*: INTEGER
	END;
	
	GlyphInfo = RECORD
		value: INTEGER;              // Character value (Unicode)
		offsetX: INTEGER;            // Character offset X when drawing
		offsetY: INTEGER;            // Character offset Y when drawing
		advanceX: INTEGER;           // Character advance position X
		image: Image            // Character image data
	END;

	Font* = RECORD
		baseSize: INTEGER;           // Base size (default chars height)
		glyphCount: INTEGER;         // Number of glyph characters
		glyphPadding: INTEGER;       // Padding around the glyph characters
		texture: Texture2D;      // Texture atlas containing the glyphs
		recs: ADDRESS;        // Rectangles in texture for the glyphs
		glyphs: ADDRESS      // Glyphs info data
	END;
	
	AudioStream* = RECORD
		buffer: ADDRESS;     // Pointer to internal data used by the audio system
		processor: ADDRESS;  // Pointer to internal data processor, useful for audio effects
		sampleRate: INTEGER; // Frequency (samples per second)
		sampleSize: INTEGER; // Bit depth (bits per sample): 8, 16, 32 (24 not supported)
		channels: INTEGER    // Number of channels (1-mono, 2-stereo, ...)
	END;
	
	// Sound
	Sound* = RECORD 
		stream: AudioStream;   // Audio stream
		frameCount: INTEGER    // Total number of frames (considering channels)
	END;


PROCEDURE [extern, "SetTargetFPS"] SetTargetFPS*(fps: INTEGER);
PROCEDURE [extern, "CloseWindow"] CloseWindow*();
PROCEDURE [extern, "WindowShouldClose"] WindowShouldClose*(): BOOLEAN;
PROCEDURE [extern, "BeginDrawing"] BeginDrawing*();
PROCEDURE [extern, "EndDrawing"] EndDrawing*();
PROCEDURE [extern, "GetMouseX"] GetMouseX*(): INTEGER;
PROCEDURE [extern, "GetMouseY"] GetMouseY*(): INTEGER;
PROCEDURE [extern, "IsMouseButtonPressed"] IsMouseButtonPressed*(button: INTEGER): BOOLEAN;


PROCEDURE [extern, "InitWindow"] _InitWindow(w, h: INTEGER; title: ADDRESS);
PROCEDURE [extern, "_ClearBackground"] _ClearBackground(color: ADDRESS);
PROCEDURE [extern, "_DrawCircle"] _DrawCircle(cx, cy: INTEGER; r: REAL; color: ADDRESS);
PROCEDURE [extern, "_DrawRectangle"] _DrawRectangle(x, y, w, h: INTEGER; color: ADDRESS);
PROCEDURE [extern, "_DrawLine"] _DrawLine(startPosX, startPosY, endPosX, endPosY: INTEGER; color: ADDRESS);
PROCEDURE [extern, "_DrawText"] _DrawText(str: ADDRESS; x, y, font: INTEGER; color: ADDRESS);
PROCEDURE [extern, "_LoadFont"] _LoadFont(fileName: ADDRESS; font: ADDRESS);
PROCEDURE [extern, "_LoadFontEx"] _LoadFontEx(fileName: ADDRESS; font: ADDRESS; 
	fontSize: INTEGER; codepoints: ADDRESS; coudepointsCount: INTEGER);
PROCEDURE [extern, "GetFrameTime"] GetFrameTime*(): REAL;
PROCEDURE [extern, "_LoadTexture"] _LoadTexture(path, texture: ADDRESS);
PROCEDURE [extern, "_DrawTexture"] _DrawTexture(texture: ADDRESS; x, y: INTEGER; color: ADDRESS);
PROCEDURE [extern, "_DrawTextureRec"] _DrawTextureRec(texture: ADDRESS; source: ADDRESS; position: ADDRESS; color: ADDRESS);

PROCEDURE [extern, "_LoadImage"] _LoadImage(fileName: ADDRESS; image: ADDRESS);
PROCEDURE [extern, "_UnloadImage"] _UnloadImage(image: ADDRESS);
PROCEDURE [extern, "_SetWindowIcon"] _SetWindowIcon(image: ADDRESS);

// Audio
PROCEDURE [extern, "InitAudioDevice"] InitAudioDevice*();
PROCEDURE [extern, "CloseAudioDevice"] CloseAudioDevice*();
PROCEDURE [extern, "_LoadSound"] _LoadSound(fileName: ADDRESS; sound: ADDRESS);
PROCEDURE [extern, "_PlaySound"] _PlaySound(sound: ADDRESS);
PROCEDURE [extern, "_StopSound"] _StopSound(sound: ADDRESS);
PROCEDURE [extern, "_IsSoundPlaying"] _IsSoundPlaying(sound: ADDRESS): BOOLEAN;


PROCEDURE InitWindow*(w, h: INTEGER; title: ARRAY OF CHAR);
BEGIN 
	_InitWindow(w, h, SYSTEM.ADR(title[0]));
END;


PROCEDURE ClearBackground*(color: Color);
BEGIN 
	_ClearBackground(SYSTEM.ADR(color));
END;


PROCEDURE DrawCircle*(cx, cy: INTEGER; r: REAL; color: Color);
BEGIN 
	_DrawCircle(cx, cy, r, SYSTEM.ADR(color));
END;


PROCEDURE DrawRectangle*(x, y, w, h: INTEGER; color: Color);
BEGIN 
	_DrawRectangle(x, y, w, h, SYSTEM.ADR(color));
END;


PROCEDURE DrawLine*(startPosX, startPosY, endPosX, endPosY: INTEGER; color: Color);
BEGIN 
	_DrawLine(startPosX, startPosY, endPosX, endPosY, SYSTEM.ADR(color));
END;


PROCEDURE DrawText*(str: ARRAY OF CHAR; x, y, font: INTEGER; color: Color);
BEGIN
	_DrawText(SYSTEM.ADR(str[0]), x, y, font, SYSTEM.ADR(color));
END DrawText;


PROCEDURE GetMousePosition*(VAR pos: Vector2);
BEGIN
	pos.x := GetMouseX();
	pos.y := GetMouseY();
END GetMousePosition;


PROCEDURE ColorToInt*(color: Color; VAR c: INTEGER);
VAR	
	r, g, b, a: INTEGER;
BEGIN
	r := LSL(color.r, 24);
	g := LSL(color.g, 16);
	b := LSL(color.b, 8);
	a := color.a;
	c := r + g + b + a;
END ColorToInt;


PROCEDURE IntToColor*(color: INTEGER; VAR c: Color);
VAR
	i: INTEGER;
BEGIN
	i := LSR(color, 24); c.r := SYSTEM.VAL(i, BYTE);
	i := LSR(color, 16); c.g := SYSTEM.VAL(i, BYTE);
	i := LSR(color, 8);  c.b := SYSTEM.VAL(i, BYTE);
	i := color; 		 c.a := SYSTEM.VAL(i, BYTE);
END IntToColor;


PROCEDURE LoadFont*(filename: ARRAY OF CHAR; VAR font: Font);
BEGIN
	_LoadFont(SYSTEM.ADR(filename[0]), SYSTEM.ADR(font));
END LoadFont;


PROCEDURE LoadFontEx*(filename: ARRAY OF CHAR; VAR font: Font; fontSize: INTEGER);
BEGIN
	_LoadFontEx(SYSTEM.ADR(filename[0]), SYSTEM.ADR(font), fontSize, NULL, 0);
END LoadFontEx;


PROCEDURE LoadTexture*(path: ARRAY OF CHAR; VAR texture: Texture2D);
BEGIN
	_LoadTexture(SYSTEM.ADR(path[0]), SYSTEM.ADR(texture));
END LoadTexture;


PROCEDURE DrawTexture*(texture: Texture2D; x, y: INTEGER; color: Color);
BEGIN
	_DrawTexture(SYSTEM.ADR(texture), x, y, SYSTEM.ADR(color));
END DrawTexture;


PROCEDURE DrawTextureRec*(texture: Texture2D; source: Rectangle; position: Vector2; color: Color);
BEGIN
	_DrawTextureRec(SYSTEM.ADR(texture), SYSTEM.ADR(source), SYSTEM.ADR(position), SYSTEM.ADR(color));
END DrawTextureRec;


PROCEDURE LoadImage*(fileName: ARRAY OF CHAR; VAR image: Image);
BEGIN
	_LoadImage(SYSTEM.ADR(fileName[0]), SYSTEM.ADR(image));
END LoadImage;


PROCEDURE UnloadImage*(VAR image: Image);
BEGIN
	_UnloadImage(SYSTEM.ADR(image));
END UnloadImage;


PROCEDURE SetWindowIcon*(VAR image: Image);
BEGIN
	_SetWindowIcon(SYSTEM.ADR(image));
END SetWindowIcon;


PROCEDURE LoadSound*(fileName: ARRAY OF CHAR; VAR sound: Sound);
BEGIN
	_LoadSound(SYSTEM.ADR(fileName[0]), SYSTEM.ADR(sound));
END LoadSound;


PROCEDURE PlaySound*(VAR sound: Sound);
BEGIN
	_PlaySound(SYSTEM.ADR(sound));
END PlaySound;


PROCEDURE StopSound*(VAR sound: Sound);
BEGIN
	_StopSound(SYSTEM.ADR(sound));
END StopSound;


PROCEDURE IsSoundPlaying*(VAR sound: Sound): BOOLEAN;
BEGIN
	RETURN _IsSoundPlaying(SYSTEM.ADR(sound))
END IsSoundPlaying;


END Raylib.
