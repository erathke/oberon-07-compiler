MODULE HelloWren;
IMPORT SYSTEM, 
	Out := Out_sys,
	Files, 
	Wren IN "./Wren.ob07";


CONST
	NULL = 0;
	//MEM_SIZE = 10 * 1024 * 1024;

TYPE
	Memory = POINTER TO RECORD(Wren.Userdata)
		//data: ARRAY MEM_SIZE OF BYTE;
		total, offset: INTEGER
	END;

PROCEDURE [extern, "malloc"] malloc(size: INTEGER): INTEGER;
PROCEDURE [extern, "realloc"] realloc(ptr, size: INTEGER): INTEGER;
PROCEDURE [extern, "free"] free(ptr: INTEGER);

PROCEDURE GetStringFromPtr(textPtr: Wren.CString; VAR text: ARRAY OF CHAR);
VAR
	i: INTEGER;
	c: CHAR;
BEGIN
	REPEAT
		SYSTEM.GET(textPtr + i, c);
		text[i] := c;
		INC(i);
	UNTIL c = 0X;
END GetStringFromPtr;


PROCEDURE [ccall] WriteFn(vm: Wren.VM; textPtr: Wren.CString);
VAR
	text: ARRAY 128 OF CHAR;
BEGIN
	GetStringFromPtr(textPtr, text);
	Out.String(text);
END WriteFn;


PROCEDURE [ccall] ErrorFn(vm: Wren.VM; errType: BYTE; modName: Wren.CString; 
		line: INTEGER; messagePtr: Wren.CString);
VAR
	text: ARRAY 128 OF CHAR;
BEGIN
	GetStringFromPtr(messagePtr, text);
	Out.String(text);
	Out.Ln;
END ErrorFn;


PROCEDURE [ccall] ReallocateFn(memory: Wren.CPtr; newSize: INTEGER; userData: Wren.Userdata): Wren.CPtr;
VAR
	mem: Memory;
	memoryAddr, dataAddr: Wren.CPtr;
BEGIN
	mem := userData(Memory);
	IF memory = NULL THEN // alloc
		memory := malloc(newSize);
		INC(mem.total, newSize);
	ELSE
		IF newSize # 0 THEN // realloc
			memory := realloc(memory, newSize);
			INC(mem.total, newSize);
		ELSE // free
			free(memory);
		END;
	END;
	RETURN memory
END ReallocateFn;


PROCEDURE main();
CONST
	FILE_SIZE = 4096;
VAR
	vm: Wren.VM;
	config: Wren.Configuration;
	result: INTEGER;
	script: ARRAY FILE_SIZE OF CHAR;
	scriptFile: Files.File;
	scriptSize: INTEGER;
	mem: Memory;
BEGIN

	NEW(mem);
	Wren.InitConfiguration(config);
	config.writeFn := WriteFn;
	config.errorFn := ErrorFn;
	config.reallocateFn := ReallocateFn;
	config.userdata := mem;
	//config.initialHeapSize := 20 * 1024 * 1024;
	
	vm := Wren.NewVM(config);
	ASSERT(vm # NULL);
	
	// Loading file
	scriptFile := Files.Open("skynet.wren", Files.OPEN_R);
	ASSERT(scriptFile # NULL);
	scriptSize := Files.Read(scriptFile, script, FILE_SIZE);
	ASSERT(scriptSize > 0);
	Files.Close(scriptFile);
	
	result := Wren.Interpret(vm, "main", script);
	IF result # Wren.RESULT_SUCCESS THEN RAISE(-1); END;
	
	Wren.FreeVM(vm);
	
	Out.String("total memory: "); Out.Int(mem.total, 0); Out.Ln;
	
END main;


BEGIN
	main()
END HelloWren.
