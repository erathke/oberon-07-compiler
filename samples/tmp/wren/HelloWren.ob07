MODULE HelloWren;
IMPORT SYSTEM, 
	Out := Out_sys,
	Files, 
	Wren IN "./Wren.ob07";


PROCEDURE [ccall] WriteFn(vm: Wren.VM; textPtr: Wren.CString);
VAR
	text: ARRAY 128 OF CHAR;
	i: INTEGER;
	c: CHAR;
BEGIN
	REPEAT
		SYSTEM.GET(textPtr + i, c);
		text[i] := c;
		INC(i);
	UNTIL c = 0X;
	Out.String(text);
END WriteFn;


PROCEDURE main();
CONST
	FILE_SIZE = 4096;
	NULL = 0;
VAR
	vm: Wren.VM;
	config: Wren.Configuration;
	result: INTEGER;
	script: ARRAY FILE_SIZE OF CHAR;
	scriptFile: Files.File;
	scriptSize: INTEGER;
BEGIN

	Wren.InitConfiguration(config);
	config.writeFn := WriteFn;
	vm := Wren.NewVM(config);
	ASSERT(vm # NULL);
	
	// Loading file
	scriptFile := Files.Open("skynet.wren", Files.OPEN_R);
	ASSERT(scriptFile # NULL);
	scriptSize := Files.Read(scriptFile, script, FILE_SIZE);
	ASSERT(scriptSize > 0);
	Files.Close(scriptFile);
	
	result := Wren.Interpret(vm, "main", script);
	IF result # Wren.RESULT_SUCCESS THEN RAISE(-1); END;
	
	
	Wren.FreeVM(vm);
	
END main;


BEGIN
	main()
END HelloWren.
