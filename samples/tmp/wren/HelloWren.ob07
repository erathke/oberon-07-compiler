MODULE HelloWren;
IMPORT SYSTEM, 
	Out := Out_sys,
	Files,
	Arena IN "./Arena.ob07",
	Wren IN "./Wren.ob07";


CONST
	NULL = 0;


PROCEDURE GetStringFromPtr(textPtr: Wren.CString; VAR text: ARRAY OF CHAR);
VAR
	i: INTEGER;
	c: CHAR;
BEGIN
	REPEAT
		SYSTEM.GET(textPtr + i, c);
		text[i] := c;
		INC(i);
	UNTIL c = 0X;
END GetStringFromPtr;


PROCEDURE [ccall] WriteFn(vm: Wren.VM; textPtr: Wren.CString);
VAR
	text: ARRAY 128 OF CHAR;
BEGIN
	GetStringFromPtr(textPtr, text);
	Out.String(text);
END WriteFn;


PROCEDURE [ccall] ErrorFn(vm: Wren.VM; errType: BYTE; modName: Wren.CString; 
		line: INTEGER; messagePtr: Wren.CString);
VAR
	text: ARRAY 128 OF CHAR;
BEGIN
	GetStringFromPtr(messagePtr, text);
	Out.String(text);
	Out.Ln;
END ErrorFn;


PROCEDURE [ccall] ReallocateFn(addr: Wren.CPtr; newSize: INTEGER; userData: Wren.Userdata): Wren.CPtr;
VAR
	mem: Arena.Memory;
BEGIN
	mem := userData(Arena.Memory);
	IF mem.pcount = 6495 THEN
		Out.String("mem offset: "); Out.Int(mem.offset, 0); Out.Ln;
		//RAISE(-1); // unknown
	END;
	
	IF addr = NULL THEN // alloc
		//Out.String("alloc: "); Out.Int(newSize, 0); Out.Ln;
		addr := Arena.Alloc(mem, newSize);
		//memory := malloc(newSize);
		INC(mem.offset, newSize);
	ELSE
		IF newSize # 0 THEN // realloc
			//Out.String("realloc: "); Out.Int(newSize, 0); Out.Ln;
			addr := Arena.Realloc(mem, addr, newSize);
			//memory := realloc(memory, newSize);
			INC(mem.offset, newSize);
		ELSE // free
			//Out.String("free: "); Out.Int(newSize, 0); Out.Ln;
			//Arena.Free(mem, memory);
			//free(memory);
			addr := NULL;
		END;
	END;
	RETURN addr
END ReallocateFn;


PROCEDURE main();
CONST
	FILE_SIZE = 4096;
VAR
	vm: Wren.VM;
	config: Wren.Configuration;
	result: INTEGER;
	script: ARRAY FILE_SIZE OF CHAR;
	scriptFile: Files.File;
	scriptSize: INTEGER;
	mem: Arena.Memory;
BEGIN

	mem := Arena.NewMemory(0);
	Wren.InitConfiguration(config);
	config.writeFn := WriteFn;
	config.errorFn := ErrorFn;
	config.reallocateFn := ReallocateFn;
	config.userdata := mem;
	//config.initialHeapSize := 20 * 1024 * 1024;
	
	vm := Wren.NewVM(config);
	ASSERT(vm # NULL);
	
	// Loading file
	scriptFile := Files.Open("hello.wren", Files.OPEN_R);
	ASSERT(scriptFile # NULL);
	scriptSize := Files.Read(scriptFile, script, FILE_SIZE);
	//ASSERT(scriptSize > 0);
	Files.Close(scriptFile);
	
	result := Wren.Interpret(vm, "main", script);
	IF result # Wren.RESULT_SUCCESS THEN RAISE(-1); END;
	
	Wren.FreeVM(vm);
	
	Out.String("total memory: "); Out.Int(mem.offset, 0); Out.Ln;
	
END main;


BEGIN
	main()
END HelloWren.
