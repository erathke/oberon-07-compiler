MODULE Arena;
IMPORT SYSTEM, Wren, Out := Out_sys;

CONST
	MEM_SIZE = 512 * 1024;

TYPE
	Pointer = POINTER TO RECORD
		addr, size: INTEGER;
		next: Pointer
	END;

	Memory* = POINTER TO RECORD(Wren.Userdata)
		offset*: INTEGER;
		pcount*: INTEGER;
		head, tail: Pointer;
		data: ARRAY MEM_SIZE OF BYTE
	END;


PROCEDURE NewMemory*(size: INTEGER): Memory;
VAR
	mem: Memory;
BEGIN
	NEW(mem);
	mem.head := NIL;
	mem.tail := NIL;
	RETURN mem
END NewMemory;


PROCEDURE Alloc*(mem: Memory; size: INTEGER): INTEGER;
VAR
	p: Pointer;
BEGIN
	IF mem.offset >= MEM_SIZE THEN
		RAISE(-1); // Out of memory
	END;
	NEW(p); // put memory on itself?
	p.size := size;
	p.addr := SYSTEM.ADR(mem.data[mem.offset]);
	INC(mem.offset, size);
	INC(mem.pcount);
	IF mem.pcount = 1 THEN // first
		mem.head := p;
		mem.tail := mem.head;
	ELSE
		mem.tail.next := p;
		mem.tail := mem.tail.next;
	END;
	RETURN p.addr
END Alloc;


PROCEDURE CopyData(mem: Memory; fromPtr, toPtr: Pointer);
BEGIN
	
	SYSTEM.MOVE(fromPtr.addr, toPtr.addr, fromPtr.size);
	
END CopyData;


PROCEDURE Realloc*(mem: Memory; addr: INTEGER; newSize: INTEGER): INTEGER;
VAR
	p, b: Pointer;
	found : BOOLEAN;
BEGIN
	p := mem.head;
	b := NIL;
	found := FALSE;
	WHILE (p # NIL) & (~ found) DO
		found := p.addr = addr;
		b := p;
		p := p.next;
	END;
	ASSERT(b # NIL);
	
	addr := Alloc(mem, newSize);
	CopyData(mem, b, mem.tail);
	
	RETURN addr
END Realloc;


PROCEDURE Free*(mem: Memory; ptr: INTEGER);
BEGIN
	
END Free;


PROCEDURE DebugData(p: Pointer);
VAR 
	i: INTEGER;
	ch: CHAR;
BEGIN
	WHILE i < p.size DO
		SYSTEM.GET8(p.addr + i, ch);
		IF ch = 0X THEN Out.Char('.')
		ELSE Out.Char(ch); END;
		INC(i);
	END;
END DebugData;


PROCEDURE Debug*(mem: Memory);
VAR
	p: Pointer;
	start: INTEGER;
BEGIN
	start := SYSTEM.ADR(mem.data[0]);
	Out.String("Start: "); Out.Int(start, 0); Out.Ln;
	p := mem.head;
	WHILE p # NIL DO
		Out.String("["); Out.Int(p.addr, 0);
		Out.String(", "); Out.Int(p.size, 0);
		Out.String(", "); DebugData(p);
		Out.String("]"); Out.Ln;
		p := p.next;
	END;
	start := SYSTEM.ADR(mem.data[mem.offset]);
	Out.String("End: "); Out.Int(start, 0); Out.Ln;
END Debug;


//PROCEDURE [extern, "malloc"] malloc(size: INTEGER): INTEGER;
//PROCEDURE [extern, "realloc"] realloc(ptr, size: INTEGER): INTEGER;
//PROCEDURE [extern, "free"] free(ptr: INTEGER);

END Arena.
