MODULE PCall;
IMPORT SYSTEM, API := API_sys, Out := Out_sys;

CONST
	N_REGS = 6;
	CODE_OK = 0;
	RETRIES = 3;

TYPE 
	UINT32 = INTEGER;
	CPU = ARRAY N_REGS OF UINT32;
	Callee* = PROCEDURE (value: INTEGER);

VAR
	cpu: CPU;
	cpuAddr: UINT32;
	errcode: INTEGER;


PROCEDURE [extern, "setjmp"] setjmp(cpu: UINT32): INTEGER;
PROCEDURE [extern, "longjmp"] longjmp(cpu: UINT32; code: INTEGER): INTEGER;


PROCEDURE JmpTrap(code: INTEGER);
BEGIN
	errcode := code;
	code := longjmp(cpuAddr, code);
END JmpTrap;


PROCEDURE Call*(VAR err: INTEGER; caller: Callee; value: INTEGER);
BEGIN
	API.SetTrap(JmpTrap);
	CASE setjmp(cpuAddr) OF
	| CODE_OK: 
		caller(value);
		err := CODE_OK;
	ELSE
		err := errcode;
	END;
	API.SetTrap(NIL);
END Call;


BEGIN
	cpuAddr := SYSTEM.ADR(cpu);
END PCall.
