MODULE UnitTest2;
IMPORT Out := Out_sys, P IN "./PCall2.ob07";

PROCEDURE ShowException(ex: INTEGER);
BEGIN
	IF ex # 0 THEN
		Out.String("error code: "); Out.Int(ex, 0); Out.Ln;
	END;
END ShowException;

PROCEDURE IndexError(x: INTEGER);
VAR
	data: ARRAY 10 OF CHAR;
	ch : CHAR;
BEGIN
	Out.Ln; Out.String("index test: "); Out.Int(x, 0); Out.Ln;
	ch := data[x];
	Out.String("index passed!"); Out.Ln;
	
END IndexError;


PROCEDURE DivError(x: INTEGER);
VAR
	ex2: INTEGER;
BEGIN
	Out.Ln; Out.String("div test: "); Out.Int(x, 0); Out.Ln;
	x := x DIV (x - 10); 
	Out.String("div passed!"); Out.Ln;
	
END DivError;


PROCEDURE AssertError(x: INTEGER);
VAR
	ex2: INTEGER;
BEGIN
	Out.Ln; Out.String("assert test: "); Out.Int(x, 0); Out.Ln;
	ASSERT(x = 10);
	Out.String("assert passed!"); Out.Ln;
END AssertError;


PROCEDURE RunTests(n: INTEGER);
VAR
	ex: INTEGER;
BEGIN
	IF n # 0 THEN
		
		P.Call(ex, AssertError, 10);
		
		ShowException(ex);
		
		P.Call(ex, AssertError, 20);
		ShowException(ex);
		
		P.Call(ex, AssertError, 30);
		ShowException(ex);
	END;
	
END RunTests;


BEGIN
	Out.Ln; Out.String("======== unit tests ========"); Out.Ln;
	RunTests(20);
	Out.Ln;
END UnitTest2.
