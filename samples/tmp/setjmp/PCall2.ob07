MODULE PCall2;
IMPORT SYSTEM, API := API_sys, Out:= Out_sys;

CONST
	N_REGS = 6;
	CODE_OK = 0;
	STACK_DEPTH = 10;

TYPE 
	UINT32 = INTEGER;
	CPU = ARRAY N_REGS OF UINT32;
	Callee* = PROCEDURE (value: INTEGER);

VAR
	cpus: ARRAY STACK_DEPTH OF CPU;
	currentCPUIdx: INTEGER;
	errcode: INTEGER;


PROCEDURE [extern, "setjmp"] setjmp(cpu: UINT32): INTEGER;
PROCEDURE [extern, "longjmp"] longjmp(cpu: UINT32; code: INTEGER): INTEGER;


PROCEDURE GetCurrentCPU(): UINT32;
BEGIN
	RETURN SYSTEM.ADR(cpus[currentCPUIdx][0])
END GetCurrentCPU;


PROCEDURE PushCPU();
BEGIN
	INC(currentCPUIdx);
END PushCPU;


PROCEDURE PopCPU();
BEGIN
	DEC(currentCPUIdx);
END PopCPU;


PROCEDURE LogCPU();
VAR
	cpu : CPU;
	i : INTEGER;
BEGIN
	Out.String("CPU: "); Out.Int(GetCurrentCPU(), 0); Out.Ln;
	cpu := cpus[currentCPUIdx];
	FOR i := N_REGS - 1 TO 0 BY -1  DO
		Out.String("["); Out.Int(cpu[i], 0);
		Out.String("] = "); Out.Int(i, 0);
		Out.Ln;
	END;
END;


PROCEDURE JmpTrap(code: INTEGER);
VAR
	addr: UINT32;
BEGIN
	errcode := code;
	addr := GetCurrentCPU();
	code := longjmp(addr, code);
END JmpTrap;


PROCEDURE [ccall] Call*(VAR err: INTEGER; caller: Callee; value: INTEGER);
VAR
	addr: UINT32;
BEGIN
	
	API.SetTrap(JmpTrap);
	PushCPU();
	
	addr := GetCurrentCPU();
	
	CASE setjmp(addr) OF
	| CODE_OK: 
		caller(value);
		err := CODE_OK;
	ELSE
		err := errcode;
	END;
	
	PopCPU();
	API.SetTrap(NIL);

END Call;


BEGIN
	currentCPUIdx := -1;
END PCall2.
