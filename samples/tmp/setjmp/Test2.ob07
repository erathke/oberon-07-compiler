MODULE Test2;
IMPORT SYSTEM, Out := Out_sys;

CONST
	N_REGS = 6;
	CODE_OK = 0;
	RETRIES = 3;

TYPE 
	UINT32 = INTEGER;
	CPU = ARRAY N_REGS OF UINT32;
	Caller* = PROCEDURE (value: INTEGER);

VAR
	cpu: CPU;
	cpuAddr: UINT32;
	errcode: INTEGER;


PROCEDURE [extern, "setjmp"] setjmp(cpu: UINT32): INTEGER;
PROCEDURE [extern, "longjmp"] longjmp(cpu: UINT32; code: INTEGER): INTEGER;


PROCEDURE PCall*(VAR err: INTEGER; caller: Caller; value: INTEGER);
VAR
	addr: UINT32;
BEGIN
	addr := SYSTEM.ADR(cpu);
	
	CASE setjmp(addr) OF
	| CODE_OK: 
		caller(value);
		err := CODE_OK;
	ELSE
		err := errcode;
	END;
	
END PCall;


PROCEDURE [ccall] trap*(code: INTEGER); // TODO: remove ccall?
BEGIN
	errcode := code;
	code := longjmp(cpuAddr, code);
END trap;


BEGIN
	cpuAddr := SYSTEM.ADR(cpu);
END Test2.
