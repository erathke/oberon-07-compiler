MODULE Test2;
IMPORT SYSTEM, Out := Out_sys;

CONST
	N_REGS = 6;
	OK = 0;
	RETRIES = 3;

TYPE 
	UINT32 = INTEGER;
	CPU = ARRAY N_REGS OF UINT32;
	Caller* = PROCEDURE (value: INTEGER);

VAR
	cpu: CPU;
	errcode: INTEGER;


PROCEDURE [extern, "setjmp"] setjmp(cpu: UINT32): INTEGER;
PROCEDURE [extern, "longjmp"] longjmp(cpu: UINT32; status: INTEGER): INTEGER;


PROCEDURE [oberon-] LongJmp(cpu: CPU; status: INTEGER): INTEGER;
VAR
	addr: UINT32;
BEGIN
	addr := SYSTEM.ADR(cpu);
	RETURN longjmp(addr, status)
END LongJmp;


PROCEDURE PCall*(VAR err: INTEGER; caller: Caller; value: INTEGER);
VAR
	addr: UINT32;
BEGIN
	addr := SYSTEM.ADR(cpu);
	
	CASE setjmp(addr) OF
	| OK: 
		caller(value);
		errcode := OK;
		err := errcode;
	ELSE
		err := errcode;
	END;
	
END PCall;


PROCEDURE [ccall] trap*(code: INTEGER); // TODO: remove ccall?
BEGIN
	errcode := code;
	LongJmp(cpu, code);
END trap;


END Test2.
