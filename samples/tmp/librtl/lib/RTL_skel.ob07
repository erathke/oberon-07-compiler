(*---------------------x86------------------------*)

MODULE RTL_skel;
IMPORT SYSTEM;

PROCEDURE [extern, "_move"] __move (bytes, dest, source: INTEGER);
PROCEDURE [stdcall] _move* (bytes, dest, source: INTEGER);
BEGIN
	__move(bytes, dest, source);
END;

PROCEDURE [extern, "_arrcpy"] __arrcpy (base_size, len_dst, dst, len_src, src: INTEGER): BOOLEAN;
PROCEDURE [stdcall] _arrcpy* (base_size, len_dst, dst, len_src, src: INTEGER): BOOLEAN;
BEGIN
	RETURN __arrcpy(base_size, len_dst, dst, len_src, src)
END;

PROCEDURE [extern, "_strcpy"] __strcpy (chr_size, len_src, src, len_dst, dst: INTEGER);
PROCEDURE [stdcall] _strcpy* (chr_size, len_src, src, len_dst, dst: INTEGER);
BEGIN
	 __strcpy(chr_size, len_src, src, len_dst, dst);
END;


PROCEDURE [extern, "_rot"] __rot (Len, Ptr: INTEGER);
PROCEDURE [stdcall] _rot* (Len, Ptr: INTEGER);
BEGIN
	 __rot(Len, Ptr);
END;


PROCEDURE [extern, "_set"] __set (b, a: INTEGER);
PROCEDURE [stdcall] _set* (b, a: INTEGER);
BEGIN
	 __set(b, a);
END;


PROCEDURE [extern, "_set1"] __set1 (a: INTEGER);
PROCEDURE [stdcall] _set1* (a: INTEGER);
BEGIN
	 __set1(a);
END;

PROCEDURE [extern, "_divmod"] __divmod (y, x: INTEGER);
PROCEDURE [stdcall] _divmod* (y, x: INTEGER);
BEGIN
	 __divmod(y, x);
END;


PROCEDURE [extern, "_new"] __new (t, size: INTEGER; VAR ptr: INTEGER);
PROCEDURE [stdcall] _new* (t, size: INTEGER; VAR ptr: INTEGER);
BEGIN
	 __new(t, size, ptr);
END;


PROCEDURE [extern, "_dispose"] __dispose (VAR ptr: INTEGER);
PROCEDURE [stdcall] _dispose* (VAR ptr: INTEGER);
BEGIN
	 __dispose(ptr);
END;

PROCEDURE [extern, "_length"] __length (len, str: INTEGER);
PROCEDURE [stdcall] _length* (len, str: INTEGER);
BEGIN
	 __length(len, str);
END;


PROCEDURE [extern, "_lengthw"] __lengthw (len, str: INTEGER);
PROCEDURE [stdcall] _lengthw* (len, str: INTEGER);
BEGIN
	 __lengthw(len, str);
END;


PROCEDURE [extern, "_strcmp"] __strcmp (op, len2, str2, len1, str1: INTEGER): BOOLEAN;
PROCEDURE [stdcall] _strcmp* (op, len2, str2, len1, str1: INTEGER): BOOLEAN;
BEGIN
	 RETURN __strcmp(op, len2, str2, len1, str1)
END;


PROCEDURE [extern, "_strcmpw"] __strcmpw (op, len2, str2, len1, str1: INTEGER): BOOLEAN;
PROCEDURE [stdcall] _strcmpw* (op, len2, str2, len1, str1: INTEGER): BOOLEAN;
BEGIN
	 RETURN __strcmpw(op, len2, str2, len1, str1)
END;


PROCEDURE [extern, "_error"] __error (modnum, _module, err, line: INTEGER);
PROCEDURE [stdcall] _error* (modnum, _module, err, line: INTEGER);
BEGIN
	 __error(modnum, _module, err, line);
END;


PROCEDURE [extern, "_isrec"] __isrec (t0, t1, r: INTEGER): INTEGER;
PROCEDURE [stdcall] _isrec* (t0, t1, r: INTEGER): INTEGER;
BEGIN
	 RETURN __isrec(t0, t1, r)
END;


PROCEDURE [extern, "_is"] __is (t0, p: INTEGER): INTEGER;
PROCEDURE [stdcall] _is* (t0, p: INTEGER): INTEGER;
BEGIN
	 RETURN __is(t0, p)
END;


PROCEDURE [extern, "_guardrec"] __guardrec (t0, t1: INTEGER): INTEGER;
PROCEDURE [stdcall] _guardrec* (t0, t1: INTEGER): INTEGER;
BEGIN
	 RETURN __guardrec(t0, t1)
END;


PROCEDURE [extern, "_guard"] __guard (t0, p: INTEGER): INTEGER;
PROCEDURE [stdcall] _guard* (t0, p: INTEGER): INTEGER;
BEGIN
	 RETURN __guard(t0, p)
END;


PROCEDURE [extern, "_dllentry"] __dllentry (hinstDLL, fdwReason, lpvReserved: INTEGER): INTEGER;
PROCEDURE [stdcall] _dllentry* (hinstDLL, fdwReason, lpvReserved: INTEGER): INTEGER;
BEGIN
	 RETURN __dllentry(hinstDLL, fdwReason, lpvReserved)
END;


PROCEDURE [extern, "_sofinit"] __sofinit;
PROCEDURE [stdcall] _sofinit* ();
BEGIN
	 __sofinit;
END;


PROCEDURE [extern, "_exit"] __exit (code: INTEGER);
PROCEDURE [stdcall] _exit* (code: INTEGER);
BEGIN
	 __exit(code);
END;


PROCEDURE [extern, "_init"] __init (modname: INTEGER; tcount, _types: INTEGER; code, param: INTEGER);
PROCEDURE [stdcall] _init* (modname: INTEGER; tcount, _types: INTEGER; code, param: INTEGER);
BEGIN
	 __init(modname, tcount, _types, code, param);
END;


END RTL_skel.
